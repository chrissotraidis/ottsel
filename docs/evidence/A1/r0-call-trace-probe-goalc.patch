 using namespace emitter;
 namespace {
+
+/*!
+ * ARM64 in-place 16-bit word permutation of one half of a vector register
+ * (VPSHUFLW/VPSHUFHW): word (base + i) of `reg` becomes word
+ * (base + ((imm >> (2*i)) & 3)) of the original value, for i in 0..3.
+ * Uses the reserved X16/X17 scratch GPRs with a cycle rotation so the
+ * permutation is safe in place.
+ */
+void rotate_vf_words_arm64(emitter::ObjectGenerator* gen,
+                           emitter::IR_Record irec,
+                           emitter::Register reg,
+                           u8 imm,
+                           int base) {
+  u8 sel[4];
+  for (int i = 0; i < 4; i++) {
+    sel[i] = (imm >> (2 * i)) & 3;
+  }
+  bool visited[4] = {};
+  for (int i = 0; i < 4; i++) {
+    if (visited[i] || sel[i] == i) {
+      visited[i] = true;
+      continue;
+    }
+    std::vector<int> cycle;
+    int cur = i;
+    while (!visited[cur]) {
