# a11-call-goal-synthetic-return.patch -- C->GOAL bridges establish the GOAL synthetic return slot.
#
# Maintenance overlay (Ottsel A1.1). GOAL asm-funcs end with `ldr x30, [sp]; ret`
# (IR_AsmRet::do_codegen_arm64) and thread-suspend reads [sp] too, so both take
# their continuation from the GOAL stack. The compiler's GOAL->GOAL call lowering
# pushes that slot (push x30; adr x17, post-blr; push x17; blr; pop x17; pop x30),
# but a C-entered call left [sp] pointing at the bridge frame's saved registers.
# An asm-func entered from C therefore returned into a stale word: the strict
# signed-GAME oracle serve jumped to 0x181674 (the village-cam Symbol address,
# a spilled C argument) with pc == x30 == that value.
#
# Fix: each C->GOAL bridge computes its own post-call continuation with `adr`,
# pushes it below the incoming x30 exactly like the lowering, and pops it after
# the call. An asm-func now returns into the bridge, and normal GOAL callees are
# unaffected because the extra slot is popped after their x30 return.
#
# Regression: scripts/test-a11-call-goal-asm-ret.sh (fails with SIGSEGV before
# this patch, passes after). Reconstruction: scripts/verify-asm-synthetic-return-patch.py.
# Applies after h3-jak1-host-boot.patch and arm64-goal-vector-preservation.patch.
--- a/game/kernel/asm_funcs_arm64.s
+++ b/game/kernel/asm_funcs_arm64.s
@@ -205,8 +205,18 @@
   mov x21, x4
   ;; offset
   mov x22, x5
+  ;; Ottsel A1.1: establish the GOAL synthetic return slot.  GOAL asm-funcs
+  ;; (IR_AsmRet) and thread-suspend read [sp] as their return address, and the
+  ;; compiler's GOAL->GOAL call lowering pushes that slot.  A C-entered call
+  ;; left [sp] pointing at this frame's saved registers, so an asm-func returned
+  ;; into a stale word -- the strict signed-GAME oracle serve jumped to the
+  ;; village-cam Symbol address 0x181674 that way.
+  adr x17, 1f
+  stp x17, x30, [sp, #-16]!
   ;; call GOAL by function pointer
   blr x3
+1:
+  add sp, sp, #16
 
   ;; restore saved registers.
   ldr x22, [sp], #16
@@ -248,8 +258,13 @@
   ldr x6, [x1, #+48] ;; 6
   ldr x7, [x1, #+56]  ;; 7
   ldr x1, [x1, #+8] ;; 1 (do this last)
+  ;; Ottsel A1.1: same synthetic return slot as _call_goal_asm_arm64.
+  adr x17, 2f
+  stp x17, x30, [sp, #-16]!
   ;; call GOAL by function pointer
   blr x8
+2:
+  add sp, sp, #16
 
   ;; retore registers.
   ldr x22, [sp], #16
@@ -296,8 +311,15 @@
   mov x20, x4 ;; set GOAL function pointer  
   mov x21, x4 ;; symbol table
   mov x22, x5 ;; offset
+  ;; Ottsel A1.1: the synthetic return slot belongs on the GOAL stack, below the
+  ;; stashed old stack pointer, so an asm-func entered at the top of this call
+  ;; returns into this bridge instead of into a stale word.
+  adr x17, 3f
+  stp x17, x30, [sp, #-16]!
   ;; call GOAL by function pointer
   blr x3
+3:
+  add sp, sp, #16
 
   ;; GOAL returned with sp back at the goal stack top.  Pop the stashed old
   ;; stack pointer off the GOAL stack, then restore from the ORIGINAL stack.
