--- a/common/dma/ottsel_dgo_alias.h
+++ b/common/dma/ottsel_dgo_alias.h
@@ -1,24 +1,76 @@
 #pragma once
 
+#include <cstddef>
 #include <string_view>
+#include <utility>
 
 namespace ottsel {
 
-// Jak 1's GOAL level names are descriptive, while the extracted retail DGO
-// family uses the original short disc tokens. Keep this translation at the
-// data-loader seam instead of copying or renaming user-owned files.
+// Jak 1's GOAL level names are descriptive ("misty"), while the extracted retail
+// DGO family uses the original short disc token ("MIS.DGO").  The level loader
+// builds the request as "<level>.DGO" (engine/level/level.gc:397) and only
+// substitutes the short token when the level is loaded in vis mode.  This port
+// runs deliberately in non-vis mode -- there is no retail VIS data on device --
+// so every level load arrives here under its descriptive name.  Keep the
+// translation at the data-loader seam instead of copying or renaming
+// user-owned files.
+//
+// The pairs are engine/level/level-info.gc (:name / :nickname), cross-checked
+// against the shipped OttselUserData/DGO directory.
+inline constexpr std::pair<std::string_view, std::string_view> kJak1DgoAliases[] = {
+    {"beach", "BEA.DGO"},    {"citadel", "CIT.DGO"},   {"darkcave", "DAR.DGO"},
+    {"demo", "DEM.DGO"},     {"finalboss", "FIN.DGO"}, {"firecanyon", "FIC.DGO"},
+    {"intro", "INT.DGO"},    {"jungle", "JUN.DGO"},    {"jungleb", "JUB.DGO"},
+    {"lavatube", "LAV.DGO"}, {"maincave", "MAI.DGO"},  {"misty", "MIS.DGO"},
+    {"ogre", "OGR.DGO"},     {"robocave", "ROB.DGO"},  {"rolling", "ROL.DGO"},
+    {"snow", "SNO.DGO"},     {"sunken", "SUN.DGO"},    {"sunkenb", "SUB.DGO"},
+    {"swamp", "SWA.DGO"},    {"title", "TIT.DGO"},     {"training", "TRA.DGO"},
+    {"village1", "VI1.DGO"}, {"village2", "VI2.DGO"},  {"village3", "VI3.DGO"},
+};
+
+inline char jak1_ascii_lower(char c) {
+  return (c >= 'A' && c <= 'Z') ? static_cast<char>(c + ('a' - 'A')) : c;
+}
+
+// True when `requested` names the level `level`.  The loader clips the level
+// name to eight characters before appending ".DGO", so compare the clipped
+// stems; no two Jak 1 level names share an eight-character prefix.
+inline bool jak1_dgo_alias_matches(std::string_view requested, std::string_view level) {
+  if (const auto dot = requested.find('.'); dot != std::string_view::npos) {
+    requested = requested.substr(0, dot);
+  }
+  if (requested.size() > 8) {
+    requested = requested.substr(0, 8);
+  }
+  if (level.size() > 8) {
+    level = level.substr(0, 8);
+  }
+  if (requested.size() != level.size()) {
+    return false;
+  }
+  for (std::size_t i = 0; i < requested.size(); ++i) {
+    if (jak1_ascii_lower(requested[i]) != jak1_ascii_lower(level[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
 inline std::string_view jak1_dgo_retail_alias(std::string_view requested) {
-  if (requested == "village1.DGO") {
-    return "VI1.DGO";
+  // Only DGO requests are aliased; a CGO/MUS/other load must fail the same way
+  // it did before this table existed.
+  if (requested.size() < 4) {
+    return {};
   }
-  if (requested == "village2.DGO") {
-    return "VI2.DGO";
+  const std::string_view ext = requested.substr(requested.size() - 4);
+  if (jak1_ascii_lower(ext[1]) != 'd' || jak1_ascii_lower(ext[2]) != 'g' ||
+      jak1_ascii_lower(ext[3]) != 'o' || ext[0] != '.') {
+    return {};
   }
-  if (requested == "village3.DGO") {
-    return "VI3.DGO";
-  }
-  if (requested == "beach.DGO") {
-    return "BEA.DGO";
+  for (const auto& [level, dgo] : kJak1DgoAliases) {
+    if (jak1_dgo_alias_matches(requested, level)) {
+      return dgo;
+    }
   }
   return {};
 }
