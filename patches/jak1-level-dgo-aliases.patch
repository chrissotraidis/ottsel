+  EXPECT_EQ("MIS.DGO", ottsel::jak1_dgo_retail_alias("misty.DGO"));
+  EXPECT_EQ("SUN.DGO", ottsel::jak1_dgo_retail_alias("sunken.DGO"));
+  EXPECT_EQ("SUB.DGO", ottsel::jak1_dgo_retail_alias("sunkenb.DGO"));
+  EXPECT_EQ("FIC.DGO", ottsel::jak1_dgo_retail_alias("firecanyon.DGO"));
+  EXPECT_EQ("FIN.DGO", ottsel::jak1_dgo_retail_alias("finalboss.DGO"));
+  // The loader clips the level name to eight characters before appending .DGO.
