+(define *ottsel-texture-login-trace-count* 0)
+
 (defun texture-page-login ((id texture-id) (alloc-func (function texture-pool texture-page kheap int texture-page)) (heap kheap))
   "Return the tpage-dir entry for the given texture.
    Load if from the debug network if its not loaded. Return #f if it doesn't work"
+  ;; Bounded residency/allocator discriminator. Numeric values use the GOAL
+  ;; float formatter because the iOS formatter leaves integer fields blank.
+  (when (and (= (-> id page) 2)
+             (< *ottsel-texture-login-trace-count* 256))
+    (let ((probe-entry (-> *texture-page-dir* entries (the-as uint (-> id page))))
+          (current-alloc (-> *texture-pool* allocate-func))
+          (alloc-id 0))
+      (when (= current-alloc texture-page-default-allocate) (set! alloc-id 1))
+      (when (= current-alloc texture-page-common-allocate) (set! alloc-id 2))
+      (when (= current-alloc texture-page-common-boot-allocate) (set! alloc-id 3))
+      (when (= current-alloc texture-page-near-allocate-0) (set! alloc-id 4))
+      (when (= current-alloc texture-page-near-allocate-1) (set! alloc-id 5))
+      (when (= current-alloc texture-page-level-allocate) (set! alloc-id 6))
+      (format 0 "OTTSEL TEX LOGIN: index=~f resident=~A alloc=~f~%"
+              (the float (-> id index))
+              (if (-> probe-entry page) "yes" "no")
+              (the float alloc-id))
+      (+! *ottsel-texture-login-trace-count* 1)))
   ;; make sure its a valid entry
   (when (and (nonzero? (-> id page)) (< (the-as uint (-> id page)) (the-as uint (-> *texture-page-dir* length))))
     ;; look up current entry
@@ -1827,14 +1847,33 @@
           (set! (-> *texture-pool* allocate-func) old-alloc-func)))
       dir-entry)))
 
+(define *ottsel-texture-lookup-trace-count* 0)
+
 (defun lookup-texture-by-id ((arg0 texture-id))
   "Look up a texture by ID, loading it from debug network if its not loaded.
    Default allocates if it has to load, so it will permanently use VRAM"
-  (let ((v1-0 (texture-page-login arg0 texture-page-default-allocate loading-level)))
+  (let ((v1-0 (texture-page-login arg0 texture-page-default-allocate loading-level))
+        (v1-1 (the-as texture #f)))
     (when (and v1-0 (< (-> arg0 index) (the-as uint (-> v1-0 page length))))
       ;;(format #t "texture:~%")
       ;;(inspect (-> v1-0 page data (-> arg0 index)))
-      (-> v1-0 page data (-> arg0 index)))))
+      (set! v1-1 (-> v1-0 page data (-> arg0 index))))
+    ;; Bounded producer-side lookup trace. Numeric values use the GOAL float
+    ;; formatter because the iOS formatter leaves integer directives blank.
+    (when (and (= (-> arg0 page) 2)
+               (< *ottsel-texture-lookup-trace-count* 128))
+      (format 0 "OTTSEL TEX LOOKUP: page=~f index=~f result=~A~%"
+              (the float (-> arg0 page))
+              (the float (-> arg0 index))
+              (if v1-1 "hit" "miss"))
+      (when v1-1
+        (format 0 " dest=~f size=~fx~f psm=~f~%"
+                (the float (-> v1-1 dest))
+                (the float (-> v1-1 w))
+                (the float (-> v1-1 h))
+                (the float (-> v1-1 psm))))
+      (+! *ottsel-texture-lookup-trace-count* 1))
+    v1-1))
 
 (defmethod unload! ((this texture-pool) (arg0 texture-page))
