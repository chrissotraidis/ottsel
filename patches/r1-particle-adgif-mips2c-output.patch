+static u32 ottsel_particle_adgif_output_count = 0;
+
+static void ottsel_trace_particle_adgif_output(ExecutionContext* c, u32 raw_texture_id, u32 adgif_addr) {
+  if (!ottsel_particle_adgif_trace_active || ottsel_particle_adgif_output_count >= 32 || adgif_addr == 0) {
+    return;
+  }
+  u64 tex0 = 0;
+  u64 tex1 = 0;
+  u64 clamp = 0;
+  u64 alpha = 0;
+  memcpy(&tex0, g_ee_main_mem + adgif_addr, sizeof(tex0));
+  memcpy(&tex1, g_ee_main_mem + adgif_addr + 16, sizeof(tex1));
+  memcpy(&clamp, g_ee_main_mem + adgif_addr + 48, sizeof(clamp));
+  memcpy(&alpha, g_ee_main_mem + adgif_addr + 64, sizeof(alpha));
+  lg::info("OTTSEL PARTICLE ADGIF OUT: raw=0x{:08x} page=0x{:x} index=0x{:x} adgif=0x{:x} "
+           "tex0=0x{:016x} tex1=0x{:016x} clamp=0x{:016x} alpha=0x{:016x}",
+           raw_texture_id, (raw_texture_id >> 20) & 0xfff, (raw_texture_id >> 8) & 0xfff, adgif_addr,
+           tex0, tex1, clamp, alpha);
+  ++ottsel_particle_adgif_output_count;
+  if (ottsel_particle_adgif_trace_count >= 32 && ottsel_particle_adgif_output_count >= 32) {
+    ottsel_particle_adgif_trace_active = false;
+    lg::info("OTTSEL PARTICLE ADGIF OUT: complete");
+  }
+}
