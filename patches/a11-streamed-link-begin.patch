# a11-streamed-link-begin.patch -- streamed link-begin enters the signed loader first.
#
# Maintenance overlay (Ottsel A1.1). link_and_exec (the GAME.CGO boot path) already tries
# ottsel::signed_gstate::link through a11-signed-gstate-loader.patch, but GOAL streams levels
# with link-begin (engine/load/load-dgo.gc), which still went straight to
# saved_link_control.jak1_jak2_begin. Streamed members therefore ran from research
# executable pages even when the member is in the signed registry.
#
# This hunk is the 2026-09-15 S1 work that produced app build 01480677: a bounded
# OTTSEL LINKBEGIN: trace, the signed-first attempt under OTTSEL_SIGNED_GSTATE_EXPERIMENT,
# and return 1 on success so GOAL does not also run the ordinary resume path (the signed
# loader enters the object top from C with the call_goal_on_stack contract). It is recorded
# here because it existed only as a hand edit in the intentionally dirty nested tree.
#
# Applies after h3-jak1-host-boot.patch, jak1-link-begin-argument-regression.patch and
# a11-signed-gstate-loader.patch, in that order (see scripts/verify-link-begin-patch.py).
--- a/game/kernel/jak1/klink.cpp
+++ b/game/kernel/jak1/klink.cpp
@@ -1014,8 +1014,29 @@
   if (!link_begin_args_valid(args)) {
     lg::warn("OTTSEL LINK: skipping zero-length link-begin object");
     return 1;
   }
+  // S1 (2026-09-15, VI1 oracle stall): trace every streamed link attempt so
+  // a missing oracle link vs a silent signed/legacy fork is distinguishable
+  // in the runtime log without attaching lldb.
+  lg::info("OTTSEL LINKBEGIN: name={} size={} heap=0x{:x} flags=0x{:x}", Ptr<char>(args[1]).c(),
+             args[2], args[3], args[4]);
+#ifdef OTTSEL_SIGNED_GSTATE_EXPERIMENT
+  // Streamed GOAL calls link-begin, not link_and_exec. The signed loader still
+  // enters the object top from C (call_goal_on_stack), matching the C-entry
+  // contract; return 1 so the GOAL side does not run the ordinary resume path.
+  {
+    u32 signed_entry = 0;
+    const char* name = Ptr<char>(args[1]).c();
+    if (ottsel::signed_gstate::link(Ptr<u8>(args[0]).c(), name, static_cast<int32_t>(args[2]),
+                                    static_cast<uint32_t>(args[4]), static_cast<uint32_t>(args[3]),
+                                    true, &signed_entry)) {
+      lg::info("OTTSEL LINKBEGIN: signed took {}", name);
+      return 1;
+    }
+    lg::info("OTTSEL LINKBEGIN: legacy fallback {}", name);
+  }
+#endif
   saved_link_control.jak1_jak2_begin(Ptr<u8>(args[0]), Ptr<char>(args[1]).c(), args[2],
                                      Ptr<kheapinfo>(args[3]), args[4]);
   // S2.1: complete the link synchronously.  The game's goal-side linker
   // expects either "finished (that was fast)" (link-begin returns nonzero) or
