 using namespace jak1_symbols;
 using namespace jak1;
+
+TEST(Kernel, Jak1LinkBeginRejectsMalformedObjectArguments) {
+  EXPECT_FALSE(link_begin_args_valid(nullptr));
+
+  u64 no_data[5] = {0, 1, 1, 0, 0};
+  u64 no_name[5] = {1, 0, 1, 0, 0};
+  u64 no_size[5] = {1, 1, 0, 0, 0};
+  u64 negative_size[5] = {1, 1, static_cast<u64>(-1), 0, 0};
+  u64 valid[5] = {1, 1, 1, 0, 0};
+  EXPECT_FALSE(link_begin_args_valid(no_data));
+  EXPECT_FALSE(link_begin_args_valid(no_name));
+  EXPECT_FALSE(link_begin_args_valid(no_size));
+  EXPECT_FALSE(link_begin_args_valid(negative_size));
+  EXPECT_TRUE(link_begin_args_valid(valid));
+}
 
