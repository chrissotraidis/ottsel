diff --git a/game/kernel/jak1/klink.h b/game/kernel/jak1/klink.h
--- a/game/kernel/jak1/klink.h
+++ b/game/kernel/jak1/klink.h
@@ -6,6 +6,12 @@
 #include "game/kernel/common/kmalloc.h"
 
 namespace jak1 {
+// Keep malformed GOAL link calls out of jak1_jak2_begin, whose object-header
+// read would otherwise turn an empty optional STR object into a version abort.
+constexpr bool link_begin_args_valid(const u64* args) {
+  return args && args[0] != 0 && args[1] != 0 && static_cast<int64_t>(args[2]) > 0;
+}
