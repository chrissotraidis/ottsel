+// One program for both layers: vertex colour, optionally multiplied by the status texture.
+void init_view_program() {
+  const char* vs =
+      "#version 300 es\n"
+      "layout(location=0) in vec2 p; layout(location=1) in vec4 c; layout(location=2) in vec2 t;\n"
+      "out vec4 vc; out vec2 vt;\n"
+      "void main() { vc = c; vt = t; gl_Position = vec4(p, 0.0, 1.0); }\n";
+  const char* fs =
+      "#version 300 es\n"
+      "precision mediump float; uniform sampler2D tex; uniform int textured;\n"
+      "in vec4 vc; in vec2 vt; out vec4 o;\n"
+      "void main() { o = textured != 0 ? texture(tex, vt) * vc : vc; }\n";
+  g_view_program = glCreateProgram();
+  glAttachShader(g_view_program, compile_view_shader(GL_VERTEX_SHADER, vs));
+  glAttachShader(g_view_program, compile_view_shader(GL_FRAGMENT_SHADER, fs));
+  glLinkProgram(g_view_program);
+  g_view_textured = glGetUniformLocation(g_view_program, "textured");
+  glGenVertexArrays(1, &g_view_vao);
+  glGenBuffers(1, &g_view_vbo);
+  glGenTextures(1, &g_status_tex);
