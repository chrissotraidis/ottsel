@@ -0,0 +1,17 @@
+#pragma once
+#include <array>
+#include <cstdint>
+namespace ottsel::signed_exports {
+enum class Kind : uint32_t { Normal, Process, Stack, Mips2C, Nothing, Zero };
+inline constexpr std::array<uint32_t,6> capacities{177,3,4,93,1,1};
+inline constexpr uint32_t count=279, stride=64, function_type=0x1bfec4;
+#ifdef OTTSEL_SIGNED_EXPORT_BANKS
+// One cold boot, on the GOAL thread. No live rebinding/recycling is supported.
+void begin_generation();
+uint32_t bind(Kind kind, uintptr_t target=0, uint32_t stack_size=0);
+bool valid_function(uint32_t pointer);
+std::array<uint32_t,6> usage();
+#else
+inline bool valid_function(uint32_t) { return false; }
+#endif
+}
