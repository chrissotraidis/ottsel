+  EXPECT_TRUE(ottsel_mobile_jak1_pc_port_bucket_candidate(50));
+  EXPECT_TRUE(ottsel_mobile_jak1_pc_port_bucket_candidate(56));
+  // Camera packets ride terrain buckets; the cheap scan covers all 70 owners.
+  EXPECT_TRUE(ottsel_mobile_jak1_pc_port_bucket_candidate(6));
+  EXPECT_TRUE(ottsel_mobile_jak1_pc_port_bucket_candidate(12));
+  EXPECT_TRUE(ottsel_mobile_jak1_pc_port_bucket_candidate(68));
