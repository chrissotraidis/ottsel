+
+#include "common/util/FileUtil.h"
+#include "gtest/gtest.h"
+
+TEST(TfragPlatformBoundary, IosScratchpadStashIsNotActiveOnMac) {
+  const auto path = file_util::get_file_path({"game/mips2c/jak1_functions/tfrag.cpp"});
+  std::ifstream stream(path);
+  ASSERT_TRUE(stream) << path;
+
+  const std::string source((std::istreambuf_iterator<char>(stream)), {});
+  const auto stash = source.find("TFRAGSTASH");
+  ASSERT_NE(stash, std::string::npos);
+  const auto guard = source.rfind("#ifdef OTTSEL_IOS", stash);
+  ASSERT_NE(guard, std::string::npos);
+  const auto guard_end = source.find("#endif", guard);
+  ASSERT_NE(guard_end, std::string::npos);
+  EXPECT_LT(guard, stash);
+  EXPECT_LT(stash, guard_end);
+}
diff --git a/third-party/SDL/src/audio/coreaudio/SDL_coreaudio.m b/third-party/SDL/src/audio/coreaudio/SDL_coreaudio.m
index dda5f573c..62a28d101 100644
--- a/third-party/SDL/src/audio/coreaudio/SDL_coreaudio.m
+++ b/third-party/SDL/src/audio/coreaudio/SDL_coreaudio.m
@@ -82,6 +82,15 @@ static const AudioObjectPropertyAddress default_recording_device_address = {
     kAudioObjectPropertyElementMain
 };
 
+// Ottsel opens an output stream only.  Avoiding discovery of input devices is
+// important on macOS because some virtual audio drivers ask TCC to authorize
+// microphone access merely while their input endpoint is enumerated.
+static bool COREAUDIO_PlaybackOnly(void)
+{
