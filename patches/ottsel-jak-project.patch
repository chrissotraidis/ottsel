+++ b/game/ottsel_ios_iop.cpp
@@ -0,0 +1,96 @@
+// Ottsel: run the real IOP/OVERLORD on iOS exactly as game/runtime.cpp's
+// iop_runner does on desktop (Jak 1 only), instead of the no-IOP RPC emulation
+// that this file replaced.
+
+#ifdef OTTSEL_IOS
+
+#include <atomic>
+#include <functional>
+#include <thread>
+
+#include "common/log/log.h"
+#include "game/kernel/common/kmachine.h"
+#include "game/overlord/common/fake_iso.h"
+#include "game/overlord/common/iso.h"
+#include "game/overlord/common/sbank.h"
+#include "game/overlord/common/srpc.h"
+#include "game/overlord/common/ssound.h"
+#include "game/overlord/jak1/dma.h"
+#include "game/overlord/jak1/fake_iso.h"
+#include "game/overlord/jak1/iso.h"
+#include "game/overlord/jak1/iso_queue.h"
+#include "game/overlord/jak1/overlord.h"
+#include "game/overlord/jak1/ramdisk.h"
+#include "game/overlord/jak1/srpc.h"
+#include "game/overlord/jak1/stream.h"
+#include "game/sce/iop.h"
+#include "game/sce/sif_ee.h"
+#include "game/system/iop_thread.h"
+
+extern std::function<void()> g_ottsel_ios_vblank;  // game/ios_stubs.cpp sceGsSyncV
+
+namespace {
+std::atomic<bool> g_iop_ready{false};
+
+void iop_main() {
+  IOP iop;
+  iop.reset_allocator();
+  ee::LIBRARY_sceSif_register(&iop);
+  iop::LIBRARY_register(&iop);
+  g_ottsel_ios_vblank = [&iop]() {
+    iop.kernel.signal_vblank();
+    iop.signal_run_iop();
+  };
+
+  jak1::dma_init_globals();
+  iso_init_globals();
+  jak1::iso_init_globals();
+  fake_iso_init_globals();
+  jak1::fake_iso_init_globals();
+  jak1::iso_queue_init_globals();
+  jak1::ramdisk_init_globals();
+  sbank_init_globals();
+  jak1::srpc_init_globals();
+  srpc_init_globals();
+  ssound_init_globals();
+  jak1::stream_init_globals();
+
+  g_iop_ready = true;
+  g_iop_ready.notify_all();
+
+  iop.wait_for_overlord_start_cmd();
+  if (iop.status != IOP_OVERLORD_INIT) {
+    lg::error("OTTSEL IOP: shutdown before OVERLORD start");
+    return;
+  }
+  // The user pack is selected before InitMachine sends the start command.
