+}
+
+void ottsel_gl_set_status(const unsigned char* rgba, int width, int height) {
+  std::lock_guard<std::mutex> lock(g_view_mutex);
+  if (!rgba || width <= 0 || height <= 0) {
+    g_status.clear();
+    return;
+  }
+  g_status.assign(rgba, rgba + (size_t)width * height * 4);
+  g_status_w = width;
+  g_status_h = height;
+  g_status_dirty = true;
+}
+
+void ottsel_gl_set_render_scale(int percent) {
