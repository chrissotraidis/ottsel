diff --git a/game/graphics/ottsel_gles.cpp b/game/graphics/ottsel_gles.cpp
new file mode 100644
index 000000000..be0105475
--- /dev/null
+++ b/game/graphics/ottsel_gles.cpp
@@ -0,0 +1,112 @@
+// Ottsel iOS: ES 3.0 glue for OpenGOAL's OpenGL renderer (see ottsel_gles_compat.h).
+#ifdef OTTSEL_GLES
+#include "game/graphics/ottsel_gles_compat.h"
+
+#include <unordered_map>
+#include <utility>
+
+namespace {
+GLenum g_active_unit = GL_TEXTURE0;
+std::unordered_map<GLenum, GLuint> g_bound_2d;                      // texture unit -> bound 2D id
+std::unordered_map<GLuint, std::pair<GLint, GLint>> g_level0_size;  // 2D id -> level-0 size
+}  // namespace
+
+void ottsel_gles_multi_draw_elements(GLenum mode, const GLsizei* count, GLenum type,
+                                     const void* const* indices, GLsizei drawcount) {
+  for (GLsizei i = 0; i < drawcount; i++) {
+    glad_glDrawElements(mode, count[i], type, indices[i]);
+  }
+}
+
+void ottsel_gles_active_texture(GLenum unit) {
+  g_active_unit = unit;
+  glad_glActiveTexture(unit);
+}
+
+void ottsel_gles_bind_texture(GLenum target, GLuint tex) {
+  if (target == GL_TEXTURE_2D) g_bound_2d[g_active_unit] = tex;
+  glad_glBindTexture(target, tex);
+}
+
+GLuint g_ottsel_gles_window_fbo = 0;
+
+GLuint g_ottsel_gles_window_renderbuffer = 0;
+
+void ottsel_gles_bind_framebuffer(GLenum target, GLuint fbo) {
+  glad_glBindFramebuffer(target, fbo == 0 ? g_ottsel_gles_window_fbo : fbo);
+}
+
+void ottsel_gles_tex_image_2d(GLenum target, GLint level, GLint ifmt, GLsizei w, GLsizei h,
+                              GLint border, GLenum fmt, GLenum type, const void* data) {
+  if (target == GL_TEXTURE_2D && level == 0) g_level0_size[g_bound_2d[g_active_unit]] = {w, h};
+  // ES 3.0 pairs sized internal formats with explicit types; OpenGOAL's GL_RGBA uploads are bytes.
+  glad_glTexImage2D(target, level, ifmt, w, h, border, fmt, type, data);
+}
+
+void ottsel_gles_get_tex_level_parameteriv(GLenum target, GLint level, GLenum pname, GLint* out) {
+  auto it = g_level0_size.find(g_bound_2d[g_active_unit]);
+  GLint w = it == g_level0_size.end() ? 0 : it->second.first;
+  GLint h = it == g_level0_size.end() ? 0 : it->second.second;
+  for (GLint i = 0; i < level; i++) { w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1; }
+  (void)target;
+  *out = pname == GL_TEXTURE_WIDTH ? w : pname == GL_TEXTURE_HEIGHT ? h : 0;
+}
+
+// All 1D textures are RGBA8 palettes (see OTTSEL_GLES_1D_ROW in ottsel_gles_compat.h).
+void ottsel_gles_tex_image_1d(GLint level, GLint ifmt, GLsizei w, GLint border, GLenum fmt,
+                              GLenum type, const void* data) {
+  const GLsizei cols = w < OTTSEL_GLES_1D_ROW ? w : OTTSEL_GLES_1D_ROW;
+  const GLsizei rows = (w + OTTSEL_GLES_1D_ROW - 1) / OTTSEL_GLES_1D_ROW;
+  ottsel_gles_tex_image_2d(GL_TEXTURE_2D, level, ifmt, cols, rows, border, fmt, type, nullptr);
+  if (data) ottsel_gles_tex_sub_image_1d(level, 0, w, fmt, type, data);
+}
+
+void ottsel_gles_tex_sub_image_1d(GLint level, GLint x, GLsizei w, GLenum fmt, GLenum type,
+                                  const void* data) {
+  const auto* bytes = static_cast<const unsigned char*>(data);
+  while (w > 0) {
+    const GLint col = x % OTTSEL_GLES_1D_ROW;
+    const GLsizei n = w < OTTSEL_GLES_1D_ROW - col ? w : OTTSEL_GLES_1D_ROW - col;
+    glad_glTexSubImage2D(GL_TEXTURE_2D, level, col, x / OTTSEL_GLES_1D_ROW, n, 1, fmt, type, bytes);
+    bytes += n * 4;
+    x += n;
+    w -= n;
+  }
+}
+
+void ottsel_gles_load_missing(void* (*get_proc)(const char*)) {
+#define OTTSEL_LOAD(name, type) \
+  if (!glad_##name) glad_##name = (type)get_proc(#name)
+  OTTSEL_LOAD(glClearDepthf, PFNGLCLEARDEPTHFPROC);
+  OTTSEL_LOAD(glUniformBlockBinding, PFNGLUNIFORMBLOCKBINDINGPROC);
+  OTTSEL_LOAD(glGetUniformBlockIndex, PFNGLGETUNIFORMBLOCKINDEXPROC);
+  OTTSEL_LOAD(glDrawArraysInstanced, PFNGLDRAWARRAYSINSTANCEDPROC);
+  OTTSEL_LOAD(glDrawElementsInstanced, PFNGLDRAWELEMENTSINSTANCEDPROC);
+  OTTSEL_LOAD(glVertexAttribDivisor, PFNGLVERTEXATTRIBDIVISORPROC);
+  OTTSEL_LOAD(glCopyBufferSubData, PFNGLCOPYBUFFERSUBDATAPROC);
+  OTTSEL_LOAD(glGetActiveUniformBlockiv, PFNGLGETACTIVEUNIFORMBLOCKIVPROC);
+  OTTSEL_LOAD(glTexStorage2D, PFNGLTEXSTORAGE2DPROC);
+#undef OTTSEL_LOAD
+}
+
+// Desktop-only pieces the renderer's translation units reference. gfx.cpp (which owns the splash) is
+// replaced by the iOS stubs, message boxes have no iOS equivalent, and the jak3 stream table is only
+// read by the debug GUI.
+#include "common/log/log.h"
+#include "common/util/dialogs.h"
+#include "game/graphics/gfx.h"
+#include "game/overlord/jak3/dma.h"
+
+namespace Gfx {
+SplashScreen g_splash;
+}
+namespace dialogs {
+void create_error_message_dialog(const std::string& title, const std::string& message) {
+  lg::error("{}: {}", title, message);
+}
+}  // namespace dialogs
+namespace jak3 {
+OverlordStreamMemory::OverlordStreamMemory() = default;
+OverlordStreamMemory g_overlord_stream_memory;
+}  // namespace jak3
+#endif
diff --git a/game/graphics/ottsel_gles_compat.h b/game/graphics/ottsel_gles_compat.h
new file mode 100644
index 000000000..0d32c5b75
--- /dev/null
+++ b/game/graphics/ottsel_gles_compat.h
@@ -0,0 +1,83 @@
+#pragma once
+// Ottsel iOS: run OpenGOAL's desktop OpenGL renderer on an OpenGL ES 3.0 context.
+// Force-included (clang -include) into the renderer sources when OTTSEL_GLES is defined; it maps the
+// handful of desktop-only entry points and enums the renderer uses onto their ES 3.0 equivalents.
+#if defined(OTTSEL_GLES) && defined(__cplusplus)
+#include "third-party/glad/include/glad/glad.h"
+
+#include <string>
+
+// Time-of-day palettes are 1D textures on desktop; ES 3.0 has none, so they become height-1 2D
+// textures (scripts/translate-gl-shaders.py rewrites the shaders to match).
+#undef GL_TEXTURE_1D
+#define GL_TEXTURE_1D GL_TEXTURE_2D
+// Palettes wider than OTTSEL_GLES_1D_ROW texels (the 8192-entry time-of-day tables) are folded into
+// rows, because ES 3.0 only guarantees 2048-texel textures; shaders read texel i at (i % row, i / row).
+#define OTTSEL_GLES_1D_ROW 1024
+#undef glTexImage1D
+#define glTexImage1D(target, level, ifmt, w, border, fmt, type, data) \
+  ottsel_gles_tex_image_1d(level, ifmt, w, border, fmt, type, data)
+#undef glTexSubImage1D
+#define glTexSubImage1D(target, level, x, w, fmt, type, data) \
+  ottsel_gles_tex_sub_image_1d(level, x, w, fmt, type, data)
+// Only used to allocate palettes with no data, where the byte order does not matter.
+#undef GL_UNSIGNED_INT_8_8_8_8
+#define GL_UNSIGNED_INT_8_8_8_8 GL_UNSIGNED_BYTE
+// Byte order of GL_RGBA + 8_8_8_8_REV equals GL_UNSIGNED_BYTE on little-endian hosts.
+#undef GL_UNSIGNED_INT_8_8_8_8_REV
+#define GL_UNSIGNED_INT_8_8_8_8_REV GL_UNSIGNED_BYTE
+// ES 3.0 always restarts primitives at the maximum index; OpenGOAL only ever uses UINT32_MAX.
+#undef glPrimitiveRestartIndex
+#define glPrimitiveRestartIndex(index) ((void)(index))
+#undef GL_PRIMITIVE_RESTART
+#define GL_PRIMITIVE_RESTART 0x8D69 /* GL_PRIMITIVE_RESTART_FIXED_INDEX */
+#undef glClearDepth
+#define glClearDepth(d) glad_glClearDepthf((GLfloat)(d))
+#undef glFramebufferTexture
+#define glFramebufferTexture(target, attachment, tex, level) \
+  glad_glFramebufferTexture2D(target, attachment, GL_TEXTURE_2D, tex, level)
+#undef glColorMaski
+#define glColorMaski(buf, r, g, b, a) glad_glColorMask(r, g, b, a)
+#undef glMultiDrawElements
+#define glMultiDrawElements ottsel_gles_multi_draw_elements
+#undef glGetTexLevelParameteriv
+#define glGetTexLevelParameteriv ottsel_gles_get_tex_level_parameteriv
+#undef glTexImage2D
+#define glTexImage2D ottsel_gles_tex_image_2d
+#undef glBindTexture
+#define glBindTexture ottsel_gles_bind_texture
+#undef glActiveTexture
+#define glActiveTexture ottsel_gles_active_texture
+// Framebuffer 0 means "the window" on desktop; on iOS the window is SDL's UIKit view framebuffer.
+#undef glBindFramebuffer
+#define glBindFramebuffer ottsel_gles_bind_framebuffer
+// Debug-only desktop features.
+#undef glPolygonMode
+#define glPolygonMode(face, mode) ((void)0)
+#undef glGetTexImage
+#define glGetTexImage(target, level, fmt, type, pixels) ((void)0)
+#undef glDebugMessageCallback
+#define glDebugMessageCallback(cb, param) ((void)0)
+#undef glDebugMessageControl
+#define glDebugMessageControl(a, b, c, d, e, f) ((void)0)
+#undef glTexImage2DMultisample
+#define glTexImage2DMultisample(a, b, c, d, e, f) ((void)0)
+
+void ottsel_gles_multi_draw_elements(GLenum mode, const GLsizei* count, GLenum type,
+                                     const void* const* indices, GLsizei drawcount);
+void ottsel_gles_get_tex_level_parameteriv(GLenum target, GLint level, GLenum pname, GLint* out);
+void ottsel_gles_tex_image_2d(GLenum target, GLint level, GLint ifmt, GLsizei w, GLsizei h,
+                              GLint border, GLenum fmt, GLenum type, const void* data);
+void ottsel_gles_bind_texture(GLenum target, GLuint tex);
+void ottsel_gles_active_texture(GLenum unit);
+void ottsel_gles_bind_framebuffer(GLenum target, GLuint fbo);
+void ottsel_gles_tex_image_1d(GLint level, GLint ifmt, GLsizei w, GLint border, GLenum fmt,
+                              GLenum type, const void* data);
+void ottsel_gles_tex_sub_image_1d(GLint level, GLint x, GLsizei w, GLenum fmt, GLenum type,
+                                  const void* data);
+extern GLuint g_ottsel_gles_window_fbo;
+extern GLuint g_ottsel_gles_window_renderbuffer;
+
+// Load the ES 3.0 entry points glad skips (it only loads desktop GL <= 3.0 for an ES 3.0 context).
+void ottsel_gles_load_missing(void* (*get_proc)(const char*));
+#endif
