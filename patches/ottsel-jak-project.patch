+// Report GL errors raised by this glue (the renderer reports its own per bucket).
+void check_view_gl(const char* where) {
+  static int reported = 0;
+  for (GLenum e = glGetError(); e != GL_NO_ERROR && reported < 20; e = glGetError()) {
+    reported++;
+    lg::error("OTTSEL GL ERROR 0x{:x} in {}", e, where);
