+bool ottsel_gl_attach(SDL_Window* window) {
+  SDL_GLContext context = SDL_GL_CreateContext(window);
+  if (!context || !SDL_GL_MakeCurrent(window, context)) {
+    lg::error("OTTSEL GL: context creation failed: {}", SDL_GetError());
+    return false;
+  }
+  if (!gladLoadGLLoader((GLADloadproc)SDL_GL_GetProcAddress)) {
+    lg::error("OTTSEL GL: glad could not load the GL API");
+    return false;
+  }
+  ottsel_gles_load_missing([](const char* name) { return (void*)SDL_GL_GetProcAddress(name); });
+  // Framebuffer 0 and the presented renderbuffer are SDL's UIKit view objects on iOS.
+  const SDL_PropertiesID props = SDL_GetWindowProperties(window);
+  g_ottsel_gles_window_fbo =
+      (GLuint)SDL_GetNumberProperty(props, SDL_PROP_WINDOW_UIKIT_OPENGL_FRAMEBUFFER_NUMBER, 0);
+  g_ottsel_gles_window_renderbuffer =
+      (GLuint)SDL_GetNumberProperty(props, SDL_PROP_WINDOW_UIKIT_OPENGL_RENDERBUFFER_NUMBER, 0);
+  g_gfx_data = std::make_unique<GraphicsData>(GameVersion::Jak1);
+  check_view_gl("renderer-init");
+  gl_inited = true;
+  ottsel_set_gfx_renderer(&gRendererOpenGL);
+  check_view_gl("attach");
+  lg::info("OTTSEL GL: {} | {} | window fbo {}", (const char*)glGetString(GL_VERSION),
+           (const char*)glGetString(GL_RENDERER), g_ottsel_gles_window_fbo);
+  return true;
+}
