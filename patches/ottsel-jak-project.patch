@@ -0,0 +1,399 @@
+#include "ottsel_signed_gstate.h"
+#ifdef OTTSEL_SIGNED_GSTATE_EXPERIMENT
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR && !defined(OTTSEL_STRICT_EXEC)
