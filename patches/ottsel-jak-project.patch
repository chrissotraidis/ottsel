+void ottsel_gl_set_render_scale(int percent);
+// True once the game has handed the renderer a frame.
+bool ottsel_gl_has_live_scene();
+// Wake the game thread if it waits for a frame that will not come (shutdown).
+void ottsel_gl_shutdown();
