+  std::unique_lock<std::mutex> lock(g_gfx_data->sync_mutex);
+  g_gfx_data->sync_cv.notify_all();
+}
+
+void ottsel_gl_render(SDL_Window* window) {
+  // Mirrors GLDisplay::render() without the desktop window and imgui handling.
+  int fb_w = 0, fb_h = 0;
+  SDL_GetWindowSizeInPixels(window, &fb_w, &fb_h);
+  auto& s = Gfx::g_global_settings;
+  int game_w = std::max(320, fb_w * g_render_scale / 100);
+  int game_h = std::max(240, fb_h * g_render_scale / 100);
+#if TARGET_OS_SIMULATOR
+  // The Simulator's OpenGL ES is a CPU rasterizer; keep its game resolution small enough to iterate.
+  if (game_w > 512) {
+    game_h = game_h * 512 / game_w;
+    game_w = 512;
+  }
+#endif
+  static int frames = 0;
+  const auto start = std::chrono::steady_clock::now();
+  const u64 frame_before = g_gfx_data->frame_idx;
+  // MSAA stays 1: ES 3.0 has no multisample textures (see ottsel_gles_compat.h).
+  render_game_frame(game_w, game_h, fb_w, fb_h, fb_w, fb_h, 1, s.brightness_contrast_color,
+                    s.brightness_contrast_alpha, false);
+  if (g_gfx_data->frame_idx_of_input_data == frame_before && g_gfx_data->frame_idx == frame_before) {
+    g_live_scene = true;  // render_game_frame received and drew a chain
+  }
+  if (++frames <= 3 || frames % 600 == 0) {
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    lg::info("OTTSEL GL FRAME: {} game={}x{} window={}x{} render-ms={:.1f}", frames, game_w, game_h,
+             fb_w, fb_h, ms);
+  }
+  if (s.framelimiter) {
+    g_gfx_data->frame_limiter.run(s.target_fps, s.experimental_accurate_lag,
+                                  s.sleep_in_frame_limiter, g_gfx_data->last_engine_time);
+  }
+  draw_view_layers(fb_w, fb_h);
+  if (frames <= 600) check_view_gl("view-layers");
+  // UIKit presents whichever renderbuffer is bound; the renderer leaves its own depth buffers bound.
+  glBindRenderbuffer(GL_RENDERBUFFER, g_ottsel_gles_window_renderbuffer);
+  SDL_GL_SwapWindow(window);
+  if (frames <= 600) check_view_gl("swap");
+  // Toggle even/odd and wake the engine waiting in gl_vsync.
+  std::unique_lock<std::mutex> lock(g_gfx_data->sync_mutex);
+  g_gfx_data->frame_idx++;
+  g_gfx_data->sync_cv.notify_all();
+}
+#endif
