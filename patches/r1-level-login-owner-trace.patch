diff --git a/goal_src/jak1/engine/gfx/texture/texture.gc b/goal_src/jak1/engine/gfx/texture/texture.gc
--- a/goal_src/jak1/engine/gfx/texture/texture.gc
+++ b/goal_src/jak1/engine/gfx/texture/texture.gc
@@
 ;; It will also link the textures.
 ;; You _must_ login textures.
 
+(define *ottsel-texture-level-login-trace-count* 0)
+
 (defmethod login-level-textures ((this texture-pool) (level level) (max-page-kind int) (id-array (pointer texture-id)))
@@
    Also checks sizes.
    This is called from level.gc as part of level loading."
+  (when (< *ottsel-texture-level-login-trace-count* 32)
+    (format 0 "OTTSEL TEX LEVEL LOGIN: level=~A max-kind=~f id-array=~A~%"
+            (-> level name) (the float max-page-kind)
+            (if (nonzero? id-array) "present" "null"))
+    (when (nonzero? id-array)
+      (format 0 "OTTSEL TEX LEVEL IDS: level=~A id0-page=~f id0-index=~f id1-page=~f id1-index=~f~%"
+              (-> level name) (the float (-> id-array 0 page))
+              (the float (-> id-array 0 index)) (the float (-> id-array 1 page))
+              (the float (-> id-array 1 index)))
+      (format 0 "OTTSEL TEX LEVEL IDS: level=~A id2-page=~f id2-index=~f id3-page=~f id3-index=~f~%"
+              (-> level name) (the float (-> id-array 2 page))
+              (the float (-> id-array 2 index)) (the float (-> id-array 3 page))
+              (the float (-> id-array 3 index)))
+      (format 0 "OTTSEL TEX LEVEL IDS: level=~A id3-page=~f id3-index=~f id4-page=~f id4-index=~f~%"
+              (-> level name) (the float (-> id-array 3 page))
+              (the float (-> id-array 3 index)) (the float (-> id-array 4 page))
+              (the float (-> id-array 4 index))))
+    (+! *ottsel-texture-level-login-trace-count* 1))
   ;; mark any existing as not loaded.
