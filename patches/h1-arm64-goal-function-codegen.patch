diff --git a/tools/ottsel_h1/h1_arm64_codegen_proof.cpp b/tools/ottsel_h1/h1_arm64_codegen_proof.cpp
new file mode 100644
index 000000000..34a9b04cc
--- /dev/null
+++ b/tools/ottsel_h1/h1_arm64_codegen_proof.cpp
@@ -0,0 +1,146 @@
+// Ottsel H1 proof harness.
+// Compiles ordinary GOAL functions with InstructionSet::ARM64 through the real
+// CodeGenerator::do_goal_function_arm64 path, then executes the resulting machine
+// code on Apple Silicon via CodeTester (host-only MAP_JIT).
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "common/versions/versions.h"
+
+#include "goalc/compiler/CodeGenerator.h"
+#include "goalc/compiler/Compiler.h"
+#include "goalc/debugger/DebugInfo.h"
+#include "goalc/emitter/CodeTester.h"
+#include "goalc/emitter/InstructionSet.h"
+#include "goalc/emitter/Register.h"
+
+using namespace emitter;
+
+static u64 exec_code(const std::vector<u8>& bytes, u64 a, u64 b, u64 c, u64 d) {
+  CodeTester tester(InstructionSet::ARM64);
+  tester.init_code_buffer(std::max<int>(4096, int(bytes.size()) + 64));
+  // CodeTester buffer is private; write via emit_data.
+  for (u8 bte : bytes) {
+    tester.emit_data<u8>(bte);
+  }
+  return tester.execute(a, b, c, d);
+}
+
+static FunctionEnv* pick_user_function(FileEnv* fe) {
+  // Prefer a named non-top-level function if present.
+  for (auto& f : fe->functions()) {
+    if (f->name().find("ottsel-h1") != std::string::npos) {
+      return f.get();
+    }
+  }
+  // Else last function (top-level is often first/last depending on pipeline)
+  if (!fe->functions().empty()) {
+    return fe->functions().back().get();
+  }
+  return nullptr;
+}
+
+int main() {
+  lg::set_stdout_level(lg::level::warn);
+  lg::set_flush_level(lg::level::warn);
+  lg::initialize();
+
+  if (!file_util::setup_project_path(std::nullopt)) {
+    std::cerr << "setup_project_path failed\n";
+    return 2;
+  }
+
+  try {
+    Compiler compiler(GameVersion::Jak1, InstructionSet::ARM64);
+    RegisterInfo::set_active_instruction_set(InstructionSet::ARM64);
+
+    // Filter out functions that use code-model IRs (symbol/function-addr links) which are
+    // deferred to H2 offline linking. H1 proves ordinary function bodies via the real
+    // do_goal_function_arm64 path.
+    auto codegen_supported = [](FunctionEnv* f) {
+      // Support the core IR set for now; anything requiring FunctionAddr/StaticVarAddr/
+      // symbol links stays NYI until H2.
+      return true;
+    };
+
+    struct Case {
+      const char* name;
+      const char* src;
+      u64 in0, in1, in2, in3;
+      u64 expected;
+    } cases[] = {
+        {"add2",
+         "(defun ottsel-h1-add ((a int) (b int)) (+ a b))",
+         40, 2, 0, 0, 42},
+        {"const",
+         "(defun ottsel-h1-const () 123)",
+         0, 0, 0, 0, 123},
+        {"submul",
+         "(defun ottsel-h1-submul ((a int) (b int)) (* (- a b) 3))",
+         10, 4, 0, 0, 18},
+        {"branch",
+         "(defun ottsel-h1-abs ((a int)) (if (< a 0) (- 0 a) a))",
+         u64(s64(-7)), 0, 0, 0, 7},
+        {"callish-move",
+         "(defun ottsel-h1-id ((a int)) a)",
+         99, 0, 0, 0, 99},
+    };
+
+    int pass = 0;
+    for (auto& cs : cases) {
+      std::cout << "[H1] " << cs.name << "\n";
+      auto obj = compiler.get_goos().reader.read_from_string(cs.src, true, cs.name);
+      auto* fe = compiler.compile_object_file(cs.name, obj, true);
+      compiler.color_only_for_proof(fe);
+      auto* fenv = pick_user_function(fe);
+      if (!fenv) {
+        std::cerr << "  no function env\n";
+        return 1;
+      }
+      std::cout << "  function=" << fenv->name() << "\n";
+
+      auto* debug = &compiler.get_debugger().get_debug_info_for_object(fe->name());
+      debug->clear();
+      // Fresh generator per function emission
+      CodeGenerator gen(fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+      std::vector<u8> bytes;
+      try {
+        bytes = gen.emit_function_machine_code(fenv, 0);
+      } catch (const std::exception& e) {
+        std::cerr << "  codegen/exec-prep failed: " << e.what() << "\n";
+        return 1;
+      }
+      std::cout << "  code_bytes=" << bytes.size() << "\n";
+      std::cout << "  hex=";
+      for (u8 b : bytes) std::cout << std::hex << int(b) << " ";
+      std::cout << std::dec << "\n";
+      if (bytes.empty()) {
+        std::cerr << "  empty code\n";
+        return 1;
+      }
+
+      u64 got = exec_code(bytes, cs.in0, cs.in1, cs.in2, cs.in3);
+      std::cout << "  got=" << s64(got) << " expected=" << s64(cs.expected) << "\n";
+      if (got != cs.expected) {
+        bool ok = true;
+        std::cout << debug->disassemble_function_by_name(fenv->name(), &ok, &compiler.get_goos().reader)
+                  << "\n";
+        std::cerr << "  MISMATCH\n";
+        return 1;
+      }
+      pass++;
+    }
+
+    std::cout << "[H1] PASS cases=" << pass << "\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << "fatal: " << e.what() << "\n";
+    return 1;
+  }
+}
