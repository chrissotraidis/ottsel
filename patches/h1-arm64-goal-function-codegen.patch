+std::vector<u8> CodeGenerator::emit_function_machine_code(FunctionEnv* env, int /*f_idx*/) {
+  // Fresh generator assumed (one function). Register then emit.
+  // Seed debug info like run() does so per-function debug records exist.
+  auto& fdi = m_debug_info->add_function(env->name(), m_fe->name());
+  for (auto& x : env->code_source()) {
+    fdi.code_sources.push_back(x.heap_obj);
+  }
+  for (auto& x : env->code()) {
+    fdi.ir_strings.push_back(x->print());
+  }
+  m_gen.add_function_to_seg(TOP_LEVEL_SEGMENT, &fdi);
+  do_function(env, 0);
+  auto rec = m_gen.get_existing_function_record(0);
+  return m_gen.emit_function_code_only(rec);
+}
