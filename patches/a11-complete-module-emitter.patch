+#pragma once
+// Complete v3 ARM64 module mode of the existing slice emitter. The loader must
+// check the manifest's bootstrap identity and may patch only listed RW slots.
+#include <CommonCrypto/CommonDigest.h>
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iterator>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ottsel::a11 {
+struct ModuleSlot {
+  uint32_t offset;
+  std::string name;
+  enum Kind { SymbolOffset, SymbolAddress, TypePointer, FunctionTag } kind;
+  uint8_t methods = 0;
+};
+struct ModuleDistance { uint32_t patch, target; uint8_t target_segment; };
+struct ModuleSegment {
+  uint32_t base = 0, size = 0, text = 0;
+  std::vector<ModuleSlot> slots;
+  std::vector<ModuleDistance> distances;
+};
+struct SignedModule {
+  std::vector<uint8_t> bytes;
+  std::array<ModuleSegment, 3> segments;
+  uint32_t function_type = 0;
+  std::string sha256;
+};
+inline bool module_fits(size_t p, size_t n, size_t end) {
+  return p <= end && n <= end - p;
+}
+inline uint32_t module_word(const std::vector<uint8_t>& b, size_t p) {
+  if (!module_fits(p, 4, b.size())) throw std::runtime_error("truncated object word");
+  uint32_t v; std::memcpy(&v, b.data() + p, 4); return v;
+}
+inline SignedModule parse_signed_module(std::vector<uint8_t> bytes, uint32_t function_type) {
+  if (!function_type || (function_type & 3)) throw std::runtime_error("invalid function Type identity");
+  SignedModule result; result.bytes = std::move(bytes); result.function_type = function_type;
+  const auto& b = result.bytes;
+  if (b.size() > UINT32_MAX) throw std::runtime_error("object exceeds v3 size range");
+  auto u32 = [&](size_t p) { return module_word(b, p); };
+  if (b.size() < 80) throw std::runtime_error("truncated header");
+  if (u32(4) != 1 || u32(8) != 3 || u32(12) != 3)
+    throw std::runtime_error("unsupported object version/segments");
+  const size_t link_end = u32(76);
+  if (link_end < 80 || link_end > b.size()) throw std::runtime_error("invalid link block");
+  std::array<std::pair<size_t, size_t>, 3> links;
+  for (size_t s = 0; s < 3; ++s) {
+    auto& seg = result.segments[s];
+    const size_t base = link_end + size_t(u32(40 + s * 8));
+    seg.size = u32(44 + s * 8); seg.text = u32(64 + s * 4);
+    const size_t begin = 4 + size_t(u32(16 + s * 8));
+    const size_t length = u32(20 + s * 8);
+    if (begin < 80 || !length || !module_fits(begin, length, link_end) ||
+        !module_fits(base, seg.size, b.size()) || base > UINT32_MAX ||
+        seg.text > seg.size || seg.text % 4)
+      throw std::runtime_error("invalid segment bounds/layout");
+    seg.base = uint32_t(base); links[s] = {begin, begin + length};
+    for (size_t t = 0; t < s; ++t) {
+      const auto& other = result.segments[t];
+      if (begin < links[t].second && links[t].first < begin + length)
+        throw std::runtime_error("overlapping link tables");
+      if (seg.size && other.size && base < size_t(other.base) + other.size &&
+          other.base < base + seg.size) throw std::runtime_error("overlapping segments");
+    }
+  }
+  // This first whole-object path has no optional-debug load policy yet.
+  if (result.segments[1].size) throw std::runtime_error("unsupported nonempty debug segment");
+  if (!result.segments[0].text || result.segments[2].text < 8)
+    throw std::runtime_error("missing main/top-level code");
+  for (size_t s = 0; s < 3; ++s) {
+    auto& seg = result.segments[s];
+    size_t p = links[s].first, end = links[s].second;
+    std::vector<std::pair<size_t, size_t>> occupied;
+    auto claim = [&](size_t patch, size_t width) {
+      if (patch % 4 || !module_fits(patch, width, seg.size))
+        throw std::runtime_error("invalid patch bounds/alignment");
+      for (const auto& old : occupied)
+        if (patch < old.second && old.first < patch + width)
+          throw std::runtime_error("overlapping relocations");
+      occupied.emplace_back(patch, patch + width);
+    };
+    bool terminated = false;
+    while (p < end) {
+      const uint8_t kind = b[p++];
+      if (!kind) {
+        if (p != end) throw std::runtime_error("trailing link bytes");
+        terminated = true; break;
+      }
+      if (kind == 1 || kind == 2) {
+        const size_t start = p;
+        while (p < end && b[p]) ++p;
+        if (p == end || p == start || p - start >= 256)
+          throw std::runtime_error("invalid symbol/type name");
+        std::string name(reinterpret_cast<const char*>(b.data() + start), p - start); ++p;
+        for (unsigned char c : name)
+          if (c >= 127) throw std::runtime_error("unsupported non-ASCII symbol/type name");
+        uint8_t methods = 0;
+        if (kind == 2) {
+          if (p == end) throw std::runtime_error("truncated method count");
+          methods = b[p++];
+          if ((name != "function" && name != "string") || methods != 9)
+            throw std::runtime_error("unsupported type/method count");
+        }
+        if (!module_fits(p, 4, end)) throw std::runtime_error("truncated slot count");
+        size_t count = u32(p); p += 4;
+        if (count > (end - p) / 4) throw std::runtime_error("truncated slots/count overflow");
+        for (size_t i = 0; i < count; ++i, p += 4) {
+          uint32_t patch = u32(p); claim(patch, 4);
+          ModuleSlot slot{patch, name, ModuleSlot::TypePointer, methods};
+          if (kind == 1) {
+            if (patch < seg.text) throw std::runtime_error("symbol relocation in signed text");
+            slot.kind = u32(seg.base + patch) == UINT32_MAX ? ModuleSlot::SymbolAddress
+                                                          : ModuleSlot::SymbolOffset;
+          } else if (patch < seg.text) {
+            if (name != "function" || patch + 4 >= seg.text)
+              throw std::runtime_error("non-function type in signed text");
+            slot.kind = ModuleSlot::FunctionTag;
+          }
+          seg.slots.push_back(std::move(slot));
+        }
+      } else if (kind == 4) {
+        if (!module_fits(p, 13, end)) throw std::runtime_error("truncated distance32 record");
+        uint8_t target_seg = b[p]; uint32_t current = u32(p + 1);
+        uint32_t target = u32(p + 5), patch = u32(p + 9); p += 13;
+        if (target_seg >= 3 || !result.segments[target_seg].size ||
+            target >= result.segments[target_seg].size || current != patch ||
+            !module_fits(patch, 8, seg.text))
+          throw std::runtime_error("invalid distance32 offsets/target");
+        claim(patch, 8);
+        uint32_t adrp = u32(seg.base + patch), add = u32(seg.base + patch + 4);
+        if ((adrp & 0x9f000000) != 0x90000000 || (add & 0xffc00000) != 0x91000000 ||
+            ((add >> 5) & 31) != (adrp & 31) || (adrp & 31) == 31 || (add & 31) == 31)
+          throw std::runtime_error("unsupported distance32 instruction pair");
+        seg.distances.push_back({patch, target, target_seg});
+      } else {
+        throw std::runtime_error("unsupported relocation kind " + std::to_string(kind));
+      }
+    }
+    if (!terminated) throw std::runtime_error("missing link terminator");
+    // Genuine whole objects need not serialize distance records by patch address.
+    std::sort(seg.distances.begin(), seg.distances.end(),
+              [](const auto& a, const auto& b) { return a.patch < b.patch; });
+  }
+  bool top_tag = false;
+  for (const auto& slot : result.segments[2].slots)
+    top_tag |= slot.kind == ModuleSlot::FunctionTag && slot.offset == 0;
+  if (!top_tag) throw std::runtime_error("missing top-level function tag");
+  unsigned char hash[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(b.data(), static_cast<CC_LONG>(b.size()), hash);
+  std::ostringstream hex;
+  for (auto v : hash) hex << std::hex << std::setw(2) << std::setfill('0') << unsigned(v);
+  result.sha256 = hex.str(); return result;
+}
+inline std::string module_json(const std::string& text) {
+  std::ostringstream out; out << '"';
+  for (unsigned char c : text) {
+    if (c == '"' || c == '\\') out << '\\' << c;
+    else if (c < 32 || c >= 127) out << "\\u00" << std::hex << std::setw(2) << std::setfill('0') << unsigned(c);
+    else out << c;
+  }
+  return out.str() + '"';
+}
+inline void emit_signed_module(const SignedModule& module, const std::string& name,
+                               const std::filesystem::path& directory, uint32_t data_offset) {
+  if (name.empty() || name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_") != std::string::npos)
+    throw std::runtime_error("invalid module name");
+  uint32_t data_size = 0;
+  std::array<uint32_t, 3> data_offsets;
+  for (size_t i = 0; i < 3; ++i) {
+    data_size = (data_size + 15u) & ~15u;
+    data_offsets[i] = data_offset + data_size;
+    data_size += module.segments[i].size - module.segments[i].text;
+  }
+  if (!data_offset || (data_offset & 15u) ||
+      !module_fits(data_offset, data_size, 128u * 1024u * 1024u))
+    throw std::runtime_error("invalid reserved module data range");
+  // Validation has completed before any usable output is opened.
+  std::filesystem::create_directories(directory);
+  std::ofstream assembly(directory / (name + ".s"));
+  std::ofstream manifest(directory / (name + ".json"));
+  if (!assembly || !manifest) throw std::runtime_error("cannot create module output");
+  auto label = [&](size_t seg, bool data) { return "_ottsel_module_" + name + "_s" + std::to_string(seg) + (data ? "_data" : "_code"); };
+  auto target_label = [&](const ModuleDistance& ref) {
+    const auto& target = module.segments[ref.target_segment];
+    bool data = ref.target >= target.text;
+    return label(ref.target_segment, data) + " + " + std::to_string(ref.target - (data ? target.text : 0));
+  };
+  manifest << "{\n\"schema\":1,\"module\":" << module_json(name)
+           << ",\"source_sha256\":" << module_json(module.sha256)
+           << ",\"source_bytes\":" << module.bytes.size()
+           << ",\"required_function_type\":" << module.function_type
+           << ",\"arena_symbol\":\"_ottsel_module_arena\",\"arena_size\":134217728"
+           << ",\"data_reservation_offset\":" << data_offset
+           << ",\"data_size\":" << data_size
+           << ",\"entry\":{\"segment\":2,\"offset\":4},\"segments\":[\n";
+  for (size_t s = 0; s < 3; ++s) {
+    const auto& seg = module.segments[s];
+    if (s) manifest << ",\n";
+    manifest << "{\"id\":" << s << ",\"size\":" << seg.size << ",\"text_size\":" << seg.text
+             << ",\"code_label\":" << module_json(label(s, false))
+             << ",\"data_label\":" << module_json(label(s, true))
+             << ",\"data_arena_offset\":" << data_offsets[s] << ",\"slots\":[";
+    for (size_t i = 0; i < seg.slots.size(); ++i) {
+      const auto& slot = seg.slots[i]; if (i) manifest << ',';
+      const char* kinds[] = {"symbol_offset", "symbol_address", "type_pointer", "immutable_function_tag"};
+      manifest << "{\"offset\":" << slot.offset << ",\"name\":" << module_json(slot.name)
+               << ",\"kind\":" << module_json(kinds[slot.kind]) << ",\"methods\":" << unsigned(slot.methods) << '}';
+    }
+    manifest << "],\"distances\":[";
+    for (size_t i = 0; i < seg.distances.size(); ++i) {
+      const auto& r = seg.distances[i]; if (i) manifest << ',';
+      manifest << "{\"patch\":" << r.patch << ",\"target_segment\":" << unsigned(r.target_segment)
+               << ",\"target\":" << r.target << '}';
+    }
+    manifest << "]}";
+    assembly << ".section __GOAL,__text,regular,pure_instructions\n.balign 4\n.globl " << label(s, false) << '\n' << label(s, false) << ":\n";
+    size_t ri = 0;
+    for (uint32_t off = 0; off < seg.text; off += 4) {
+      uint32_t word = module_word(module.bytes, seg.base + off);
+      if (ri < seg.distances.size() && seg.distances[ri].patch == off) {
+        const auto& r = seg.distances[ri++];
+        uint32_t add = module_word(module.bytes, seg.base + off + 4);
+        assembly << "adrp x" << (word & 31) << ", " << target_label(r) << "@PAGE\n"
+                 << "add x" << (add & 31) << ", x" << ((add >> 5) & 31) << ", " << target_label(r) << "@PAGEOFF\n";
+        off += 4;
+      } else {
+        for (const auto& slot : seg.slots)
+          if (slot.offset == off && slot.kind == ModuleSlot::FunctionTag) word = module.function_type;
+        assembly << ".long " << word << '\n';
+      }
+    }
+    // Data symbols are supplied by the central arena layout object.
+    // Runtime restores templates into its explicitly reserved zero-fill span.
+    assembly << ".globl " << label(s, true) << "\n";
+    std::ofstream data(directory / (name + "-s" + std::to_string(s) + "-data.bin"), std::ios::binary);
+    data.write(reinterpret_cast<const char*>(module.bytes.data() + seg.base + seg.text), seg.size - seg.text);
+    if (!data) throw std::runtime_error("cannot write data template");
+  }
+  manifest << "\n]}\n";
+  // One-module layout proof. A product build must aggregate every module into
+  // ONE arena layout and reserve this range in the allocator before activation.
+  std::ofstream arena(directory / (name + "-arena-layout.s"));
+  arena << ".globl _ottsel_module_arena\n.zerofill __ARENA,__zero,_ottsel_module_arena," << data_offset << ",14\n";
+  for (size_t s = 0; s < 3; ++s) {
+    arena << ".globl " << label(s, true) << "\n.zerofill __ARENA,__zero,"
+          << label(s, true) << "," << module.segments[s].size - module.segments[s].text << ",4\n";
+  }
+  arena << ".zerofill __ARENA,__zero,_ottsel_module_arena_tail,"
+        << 134217728u - data_offset - data_size << ",4\n";
+  if (!arena) throw std::runtime_error("cannot write arena layout");
+  std::ofstream original(directory / (name + ".source.o"), std::ios::binary);
+  original.write(reinterpret_cast<const char*>(module.bytes.data()), module.bytes.size());
+  if (!assembly || !manifest || !original) throw std::runtime_error("cannot write module output");
+}
+inline int signed_module_cli(int argc, char** argv) {
+  if (argc != 7) throw std::runtime_error("usage: --module object.o name output-directory function-type-offset reserved-data-offset");
+  std::ifstream input(argv[2], std::ios::binary);
+  if (!input) throw std::runtime_error("cannot read module object");
+  std::vector<uint8_t> bytes{std::istreambuf_iterator<char>(input), {}};
+  size_t used = 0; unsigned long type = std::stoul(argv[5], &used, 0);
+  if (used != std::strlen(argv[5]) || type > UINT32_MAX) throw std::runtime_error("invalid function Type argument");
+  size_t offset_used = 0; unsigned long offset = std::stoul(argv[6], &offset_used, 0);
+  if (offset_used != std::strlen(argv[6]) || offset > UINT32_MAX) throw std::runtime_error("invalid data reservation argument");
+  emit_signed_module(parse_signed_module(std::move(bytes), uint32_t(type)), argv[3], argv[4], uint32_t(offset));
+  return 0;
+}
+} // namespace ottsel::a11
