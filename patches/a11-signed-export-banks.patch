+}
+void require(bool condition,const char* reason) { if(!condition)fail(reason); }
+void permissions(void* pointer,size_t size,vm_prot_t expected) {
+  uintptr_t cursor=reinterpret_cast<uintptr_t>(pointer),end=cursor+size;
+  require(end>=cursor,"VM range overflow");
+  while(cursor<end) {
+    vm_address_t begin=cursor;vm_size_t length=0;
+    vm_region_basic_info_data_64_t info{};
+    mach_msg_type_number_t n=VM_REGION_BASIC_INFO_COUNT_64;mach_port_t object=MACH_PORT_NULL;
+    auto result=vm_region_64(mach_task_self(),&begin,&length,VM_REGION_BASIC_INFO_64,
+                            reinterpret_cast<vm_region_info_t>(&info),&n,&object);
+    if(object!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),object);
+    require(result==KERN_SUCCESS && begin<=cursor && begin+length>cursor &&
+            info.protection==expected && !(expected&VM_PROT_EXECUTE && info.max_protection!=expected),
+            "bank VM protection mismatch");
+    cursor=begin+length;
+  }
+}
+uint32_t bank_begin(Kind kind) {
+  uint32_t index=0;for(uint32_t k=0;k<uint32_t(kind);++k)index+=capacities[k];return index;
+}
+uint32_t goal_pointer(uint32_t slot) {
+  uintptr_t entry=reinterpret_cast<uintptr_t>(ottsel_export_bank_begin)+slot*stride+4;
+  uintptr_t base=reinterpret_cast<uintptr_t>(generation_base);
+  require(entry>=base && entry-base<=UINT32_MAX,"entry outside common pointer window");
+  return uint32_t(entry-base);
+}
+}
+void begin_generation() {
+  require(!started,"generation already active; live slot reuse forbidden");
+  require(g_ee_main_mem,"arena absent");
+  const uintptr_t first=reinterpret_cast<uintptr_t>(ottsel_export_bank_begin);
+  const uintptr_t last=reinterpret_cast<uintptr_t>(ottsel_export_bank_end);
+  const uintptr_t base=reinterpret_cast<uintptr_t>(g_ee_main_mem);
+  require(first%8==0 && last-first==count*stride && first>=base+EE_MAIN_MEM_SIZE &&
+          last>=first && last-base<=UINT32_MAX,"invalid signed bank layout");
+  permissions(ottsel_export_bank_begin,count*stride,VM_PROT_READ|VM_PROT_EXECUTE);
+  permissions(ottsel_export_bank_targets,sizeof(ottsel_export_bank_targets),VM_PROT_READ|VM_PROT_WRITE);
+  for(uint32_t i=0;i<count;++i) {
+    uint32_t tag;std::memcpy(&tag,ottsel_export_bank_begin+i*stride,4);
+    require(tag==function_type,"immutable bank Type mismatch");
+    require(!ottsel_export_bank_targets[i][0] && !ottsel_export_bank_targets[i][1],"nonempty new generation descriptor");
+  }
+  generation_base=g_ee_main_mem;started=true;
+  lg::info("SIGNED EXPORT BANKS: generation ready slots={} bytes={} first=0x{:x}", count, count*stride, goal_pointer(0));
+}
+uint32_t bind(Kind kind,uintptr_t target,uint32_t stack_size) {
+  require(started && generation_base==g_ee_main_mem,"inactive or changed arena generation");
+  const uint32_t k=uint32_t(kind);
+  require(k<capacities.size(),"unknown bridge kind");
+  require(s7.offset && *(s7+jak1_symbols::FIX_SYM_FUNCTION_TYPE)==function_type,"bootstrap function Type mismatch");
+  const bool leaf=kind==Kind::Nothing || kind==Kind::Zero;
+  require(leaf?!target:bool(target),"invalid bridge target");
+  require(kind==Kind::Mips2C ? (stack_size%16==0 && stack_size<=4096) : stack_size==0,
+          "invalid bridge stack contract");
+  require(used[k]<capacities[k],"bank exhausted");
+  const uint32_t slot=bank_begin(kind)+used[k];
+  const uint32_t entry=goal_pointer(slot);
+  // Publish exactly once, after every rejection check; instruction bytes never change.
+  ottsel_export_bank_targets[slot][0]=target;
+  ottsel_export_bank_targets[slot][1]=stack_size;
+  ++used[k];
+  if(used[k]==capacities[k]) lg::info("SIGNED EXPORT BANKS: kind={} bound={}/{}", k, used[k], capacities[k]);
+  return entry;
+}
+bool valid_function(uint32_t pointer) {
+  if(!started || generation_base!=g_ee_main_mem || !s7.offset ||
+     *(s7+jak1_symbols::FIX_SYM_FUNCTION_TYPE)!=function_type)return false;
+  uintptr_t address=reinterpret_cast<uintptr_t>(generation_base)+pointer;
+  uintptr_t first=reinterpret_cast<uintptr_t>(ottsel_export_bank_begin)+4;
+  if(address<first || address-first>=count*stride || (address-first)%stride)return false;
+  uint32_t index=uint32_t((address-first)/stride),start=0;
+  for(size_t k=0;k<capacities.size();++k) {
+    if(index<start+capacities[k])return index-start<used[k];
+    start+=capacities[k];
+  }
+  return false;
+}
+std::array<uint32_t,6> usage() { return used; }
+}
+#endif
