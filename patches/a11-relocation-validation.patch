--- /dev/null
+++ b/tools/ottsel_a1_1/a11_relocation_validation.h
@@ -0,0 +1,101 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ottsel::a11 {
+// This validates only the supported main-segment slice. Top-level execution,
+// other modules and general object linking are deliberately not implemented.
+inline void validate_slice(const std::vector<uint8_t>& bytes, const std::string& object) {
+  size_t at = 0;
+  auto fail = [&](const std::string& why) {
+    throw std::runtime_error(object + ": main relocation/object byte " +
+                             std::to_string(at) + ": " + why);
+  };
+  auto fits = [&](size_t offset, size_t length, size_t end) {
+    return offset <= end && length <= end - offset;
+  };
+  auto u32 = [&](size_t offset) {
+    at = offset;
+    if (!fits(offset, 4, bytes.size())) fail("truncated u32");
+    uint32_t result;
+    std::memcpy(&result, bytes.data() + offset, 4);
+    return result;
+  };
+  if (bytes.size() < 80) fail("truncated header");
+  if (u32(4) != 1 || u32(8) != 3 || u32(12) != 3) fail("unsupported object version/segments");
+  const size_t link_end = u32(76);
+  if (link_end < 80 || link_end > bytes.size()) fail("invalid link block");
+  for (size_t seg = 0; seg != 3; ++seg) {
+    const size_t link = size_t(u32(16 + seg * 8)) + 4;
+    const size_t length = u32(20 + seg * 8);
+    const size_t code = size_t(u32(40 + seg * 8)) + link_end;
+    const size_t size = u32(44 + seg * 8);
+    if (link < 80 || !fits(link, length, link_end) ||
+        !fits(code, size, bytes.size()) || u32(64 + seg * 4) > size)
+      fail("invalid segment bounds");
+  }
+  const size_t base = link_end + u32(40), size = u32(44), text = u32(64);
+  if (text != 0x4000 || size < text || size % 4) fail("unsupported slice code/data layout");
+  size_t p = size_t(u32(16)) + 4;
+  const size_t end = p + u32(20);
+  std::vector<size_t> patches;
+  size_t previous_end = 0;
+  while (p < end) {
+    at = p;
+    const uint8_t kind = bytes[p++];
+    if (!kind) {
+      if (p != end) fail("trailing link bytes");
+      return;
+    }
+    if (kind == 1 || kind == 2) {
+      const size_t start = p;
+      while (p < end && bytes[p]) ++p;
+      if (p == end) fail("unterminated symbol/type name");
+      const std::string name(reinterpret_cast<const char*>(bytes.data() + start), p++ - start);
+      if (kind == 1 && name != "name=" && name != "string=" && name != "string" &&
+          name != "symbol" && name != "symbol->string") fail("unsupported symbol " + name);
+      if (kind == 2) {
+        if (name != "function") fail("unsupported type " + name);
+        if (p == end || bytes[p++] != 9) fail("unsupported function method count");
+      }
+      if (!fits(p, 4, end)) fail("truncated slot count");
+      const size_t count = u32(p); p += 4;
+      if (count > (end - p) / 4) fail("truncated slots/count overflow");
+      for (size_t i = 0; i < count; ++i, p += 4) {
+        const size_t slot = u32(p);
+        if (slot % 4 || !fits(slot, 4, size) || (kind == 1 && slot < text))
+          fail("invalid symbol/type patch offset");
+        for (size_t old : patches) if (old == slot) fail("duplicate patch offset");
+        patches.push_back(slot);
+      }
+    } else if (kind == 4) {
+      if (!fits(p, 13, end)) fail("truncated distance32 record");
+      const uint8_t segment = bytes[p];
+      const size_t current = u32(p + 1), target = u32(p + 5), patch = u32(p + 9);
+      if (segment != 0) fail("unsupported distance32 target segment " + std::to_string(segment));
+      if (current != patch || patch % 4 || !fits(patch, 4, text) || target >= size || patch < previous_end)
+        fail("invalid/unsorted distance32 offsets");
+      for (size_t old : patches) if (old == patch) fail("duplicate patch offset");
+      const uint32_t instruction = u32(base + patch);
+      previous_end = patch + 4;
+      if ((instruction & 0x9f000000) == 0x90000000) {
+        if (!fits(patch, 8, text)) fail("truncated ADRP/ADD pair");
+        const uint32_t add = u32(base + patch + 4);
+        if ((add & 0xffc00000) != 0x91000000 || ((add >> 5) & 31) != (instruction & 31))
+          fail("unsupported ADRP consumer");
+        previous_end += 4;
+        patches.push_back(patch + 4);
+      } else if ((instruction & 0x9f000000) != 0x10000000) {
+        fail("unsupported distance32 instruction");
+      }
+      patches.push_back(patch); p += 13;
+    } else {
+      fail("unsupported relocation kind " + std::to_string(kind));
+    }
+  }
+  fail("missing link terminator");
+}
+}  // namespace ottsel::a11
