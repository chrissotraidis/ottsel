+// Ottsel I2 (2026-09-22): bounded proof of audibility.  The lane's sound requests are already visible in
+// the log, but "a request resolved" is not "signal came out of the substrate".  With
+// OTTSEL_AUDIO_DUMP=<seconds> set, the PCM the callback actually hands to the SDL stream is written once to
+// <writable>ottsel-audio-dump.wav in the stream's own format (S16, stereo, 48 kHz) and one peak/RMS line is
+// logged per second of captured audio.  Without the variable nothing is opened, written or logged.
+struct AudioDumpState {
+  std::mutex mutex;
+  bool announced = false;
+  bool finished = false;
+  FILE* file = nullptr;
+  u64 frames_total = 0;
+  u64 frames_target = 0;
+  u64 frames_in_window = 0;
+  int window_peak = 0;
+  double window_energy = 0.0;
+};
+
+AudioDumpState g_audio_dump;
+
+void audio_dump_put_u32(u8* p, u32 v) {
+  p[0] = v & 0xff;
+  p[1] = (v >> 8) & 0xff;
+  p[2] = (v >> 16) & 0xff;
+  p[3] = (v >> 24) & 0xff;
+}
+
+void audio_dump_put_u16(u8* p, u16 v) {
+  p[0] = v & 0xff;
+  p[1] = (v >> 8) & 0xff;
+}
+
+// 44-byte canonical WAV header for the SDL stream's format.  Written once with a zero length and rewritten
+// when the capture completes, so a half-written file is still readable.
+void audio_dump_write_header(FILE* file, u32 data_bytes) {
+  const u16 channels = 2;
+  const u32 sample_rate = 48000;
+  const u16 bits = 16;
+  const u16 block_align = channels * (bits / 8);
+  const u32 byte_rate = sample_rate * block_align;
+  u8 header[44] = {};
+  std::memcpy(header + 0, "RIFF", 4);
+  audio_dump_put_u32(header + 4, 36 + data_bytes);
+  std::memcpy(header + 8, "WAVE", 4);
+  std::memcpy(header + 12, "fmt ", 4);
+  audio_dump_put_u32(header + 16, 16);
+  audio_dump_put_u16(header + 20, 1);
+  audio_dump_put_u16(header + 22, channels);
+  audio_dump_put_u32(header + 24, sample_rate);
+  audio_dump_put_u32(header + 28, byte_rate);
+  audio_dump_put_u16(header + 32, block_align);
+  audio_dump_put_u16(header + 34, bits);
+  std::memcpy(header + 36, "data", 4);
+  audio_dump_put_u32(header + 40, data_bytes);
+  std::fseek(file, 0, SEEK_SET);
+  std::fwrite(header, 1, sizeof(header), file);
+  std::fseek(file, 0, SEEK_END);
+}
 
+void audio_dump_capture(const s16Output* buffer, int frames) {
+  std::scoped_lock lock(g_audio_dump.mutex);
+  if (!g_audio_dump.announced) {
+    g_audio_dump.announced = true;
+    const char* env = std::getenv("OTTSEL_AUDIO_DUMP");
+    const double seconds = env ? std::atof(env) : 0.0;
+    if (seconds > 0.0) {
+      g_audio_dump.frames_target = static_cast<u64>(seconds * 48000.0);
+      const std::string path = ottsel_ios_writable_dir() + "ottsel-audio-dump.wav";
+      g_audio_dump.file = std::fopen(path.c_str(), "wb");
+      lg::info("OTTSEL AUDIO PCM: dump path='{}' target-frames={}", path,
+               g_audio_dump.frames_target);
+    }
+  }
+  if (!g_audio_dump.file || g_audio_dump.finished) {
+    return;
+  }
+  if (!g_audio_dump.frames_total) {
+    audio_dump_write_header(g_audio_dump.file, 0);
+  }
+  for (int i = 0; i < frames; ++i) {
+    const s16 values[2] = {buffer[i].left, buffer[i].right};
+    for (const s16 sample : values) {
+      const int value = sample;
+      const int magnitude = value < 0 ? -value : value;
+      if (magnitude > g_audio_dump.window_peak) {
+        g_audio_dump.window_peak = magnitude;
+      }
+      g_audio_dump.window_energy += static_cast<double>(value) * static_cast<double>(value);
+    }
+  }
+  std::fwrite(buffer, sizeof(s16Output), static_cast<size_t>(frames), g_audio_dump.file);
+  g_audio_dump.frames_total += static_cast<u64>(frames);
+  g_audio_dump.frames_in_window += static_cast<u64>(frames);
+  if (g_audio_dump.frames_in_window >= 48000) {
+    const double rms = std::sqrt(g_audio_dump.window_energy /
+                                 static_cast<double>(g_audio_dump.frames_in_window) / 2.0);
+    lg::info("OTTSEL AUDIO PCM: second={} peak={} rms={:.0f}",
+             g_audio_dump.frames_total / 48000, g_audio_dump.window_peak, rms);
+    g_audio_dump.window_peak = 0;
+    g_audio_dump.window_energy = 0.0;
+    g_audio_dump.frames_in_window = 0;
+  }
+  if (g_audio_dump.frames_total >= g_audio_dump.frames_target) {
+    g_audio_dump.finished = true;
+    const u32 data_bytes = static_cast<u32>(g_audio_dump.frames_total * sizeof(s16Output));
+    audio_dump_write_header(g_audio_dump.file, data_bytes);
+    std::fclose(g_audio_dump.file);
+    g_audio_dump.file = nullptr;
+    lg::info("OTTSEL AUDIO PCM: dump complete frames={} bytes={}", g_audio_dump.frames_total,
+             data_bytes);
+  }
+}
 }  // namespace
 #endif
 
