+void mario_reset_bodystate(struct MarioState *m); // decomp/game/mario.c
+
+SM64_LIB_FN bool sm64_mario_pose( int32_t marioId, int16_t faceYaw, int32_t animID, int32_t animAccel, bool restart, struct SM64MarioGeometryBuffers *outBuffers )
+{
+    if( marioId >= s_mario_instance_pool.size || s_mario_instance_pool.objects[marioId] == NULL )
+    {
+        DEBUG_PRINT("Tried to pose non-existant Mario with ID: %u", marioId);
+        return false;
+    }
+
+    global_state_bind( ((struct MarioInstance *)s_mario_instance_pool.objects[ marioId ])->globalState );
+    struct MarioState *m = gMarioState;
+
+    vec3f_set( m->pos, 0.0f, 0.0f, 0.0f );
+    vec3f_copy( m->marioObj->header.gfx.pos, m->pos );
+    m->faceAngle[1] = faceYaw;
+    vec3s_set( m->marioObj->header.gfx.angle, 0, faceYaw, 0 );
+    vec3f_set( m->marioObj->header.gfx.cameraToObject, 0.0f, 0.0f, 0.0f );
+
+    if( restart )
+        m->marioObj->header.gfx.animInfo.animID = -1;
+    set_mario_anim_with_accel( m, animID, animAccel );
+    mario_reset_bodystate( m );
+    m->marioBodyState->capState = MARIO_HAS_DEFAULT_CAP_ON; // the reset takes it off; his update puts it back
+
+    // The animation advances while his body is drawn (rendering_graph_node.c), once per update counter.
+    gfx_adapter_bind_output_buffers( outBuffers );
+    geo_process_root_hack_single_node( s_mario_graph_node );
+    gAreaUpdateCounter++;
+
+    return is_anim_at_end( m );
+}
