diff --git a/game/sce/ottsel_platform_input.cpp b/game/sce/ottsel_platform_input.cpp
new file mode 100644
--- /dev/null
+++ b/game/sce/ottsel_platform_input.cpp
@@
+#include "ottsel_platform_input.h"
+
+#include <algorithm>
+#include <array>
+#include <mutex>
+
+namespace ottsel::platform_input {
+namespace {
+constexpr int kPadCount = 4;
+std::array<PadState, kPadCount> s_states;
+std::array<u16, kPadCount> s_latched_buttons;
+std::array<int, kPadCount> s_latched_reads;
+std::mutex s_state_mutex;
+
+int pressure_index(Button button) {
+  switch (button) {
+    case DpadRight: return 0; case DpadLeft: return 1; case DpadUp: return 2;
+    case DpadDown: return 3; case Triangle: return 4; case Circle: return 5;
+    case Cross: return 6; case Square: return 7; case L1: return 8;
+    case R1: return 9; case L2: return 10; case R2: return 11; default: return -1;
+  }
+}
+bool valid_port(int port) { return port >= 0 && port < kPadCount; }
+}  // namespace
+
+void set_pad_state(int port, const PadState& state) {
+  if (!valid_port(port)) return;
+  std::lock_guard lock(s_state_mutex); s_states.at(port) = state;
+}
+PadState get_pad_state(int port) {
+  std::lock_guard lock(s_state_mutex);
+  if (!valid_port(port)) return PadState{};
+  auto result = s_states.at(port); const auto latched = s_latched_buttons.at(port);
+  result.buttons |= latched;
+  for (int bit = 0; bit < 16; ++bit) {
+    const auto button = static_cast<Button>(1u << bit); const int index = pressure_index(button);
+    if (index >= 0 && (latched & button)) result.pressure.at(index) = 255;
+  }
+  if (s_latched_reads.at(port) > 0 && --s_latched_reads.at(port) == 0) s_latched_buttons.at(port) = 0;
+  return result;
+}
+void latch_button(int port, Button button, int pad_reads) {
+  if (!valid_port(port) || !button || pad_reads <= 0) return;
+  std::lock_guard lock(s_state_mutex); s_latched_buttons.at(port) |= button;
+  s_latched_reads.at(port) = std::max(s_latched_reads.at(port), pad_reads);
+}
+void latch_native_button(int port, Button button) { latch_button(port, button, kNativeDigitalLatchPadReads); }
+void clear_pad_state(int port) {
+  if (!valid_port(port)) return;
+  std::lock_guard lock(s_state_mutex); s_states.at(port) = PadState{};
+  s_latched_buttons.at(port) = 0; s_latched_reads.at(port) = 0;
+}
+void clear_all_pad_states() {
+  std::lock_guard lock(s_state_mutex); s_states.fill(PadState{});
+  s_latched_buttons.fill(0); s_latched_reads.fill(0);
+}
+void set_button(PadState* state, Button button, bool pressed) {
+  if (!state) return;
+  if (pressed) state->buttons |= button; else state->buttons &= ~button;
+  const int index = pressure_index(button); if (index >= 0) state->pressure.at(index) = pressed ? 255 : 0;
+}
+}  // namespace ottsel::platform_input
diff --git a/test/test_platform_input.cpp b/test/test_platform_input.cpp
--- a/test/test_platform_input.cpp
+++ b/test/test_platform_input.cpp
@@
 TEST(PlatformInput, RemapOwnershipRejectsSentinelAndStaleInstances) {
@@
 }
+
+TEST(PlatformInput, NativeTapLatchSurvivesSlowGoalPoll) {
+  using namespace ottsel::platform_input;
+  clear_all_pad_states();
+  latch_native_button(0, Start);
+  for (int i = 0; i < kNativeDigitalLatchPadReads - 1; ++i) EXPECT_EQ(get_pad_state(0).buttons, Start);
+  EXPECT_EQ(get_pad_state(0).buttons, Start);
+  EXPECT_EQ(get_pad_state(0).buttons, 0);
+}
