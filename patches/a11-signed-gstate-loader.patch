@@ -0,0 +1,36 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace ottsel::signed_gstate {
+enum class SlotKind : uint8_t { SymbolOffset, SymbolAddress, TypePointer, FunctionTag };
+struct Slot { uint32_t offset; SlotKind kind; const char* name; uint8_t methods; };
+struct Pointer { uint32_t patch, target, goal_offset; };
+struct Segment {
+  uint8_t* code; uint8_t* data;
+  uint32_t text_size, data_size, data_offset;
+  const uint8_t* initial_data; const Slot* slots; size_t slot_count;
+  uint32_t source_size, source_text_size; bool loaded;
+  const Pointer* pointers; size_t pointer_count;
+};
+struct Manifest {
+  const char* name; const char* sha256; uint32_t source_size, function_type;
+  uint8_t* arena; uint32_t arena_size, reservation_begin, data_span_size;
+  Segment segments[3];
+  bool release_debug;
+};
+#ifdef OTTSEL_SIGNED_GSTATE_EXPERIMENT
+extern const Manifest manifest;  // Gstate compatibility identity.
+extern const Manifest* const modules[];  // Legacy comparison suffix or canonical complete KERNEL list.
+extern const size_t module_count;
+size_t loaded_count();
+uint8_t* prepare_arena();
+uint32_t heap_end();
+// Only selected signed module names are intercepted; mismatch never falls back.
+bool link(const uint8_t* bytes, const char* name, int32_t size, uint32_t flags,
+          uint32_t heap, bool jump_from_c_to_goal, uint32_t* entry);
+bool valid_function(uint32_t pointer);
+void require_rx(const void* address, size_t size);
+#else
+inline bool valid_function(uint32_t) { return false; }
+#endif
+}  // namespace ottsel::signed_gstate
