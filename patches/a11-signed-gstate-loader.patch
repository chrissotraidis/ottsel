+#include "ottsel_signed_gstate.h"
+#ifdef OTTSEL_SIGNED_GSTATE_EXPERIMENT
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR
+#error Signed Gstate experiment still needs mixed-runtime prerequisites; physical iOS is unsupported
+#endif
+#include <CommonCrypto/CommonDigest.h>
+#include <mach/mach.h>
+#include <mach/vm_map.h>
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include "common/goal_constants.h"
+#include "common/log/log.h"
+#include "common/symbols.h"
+#include "game/kernel/common/klink.h"
+#include "game/kernel/common/kboot.h"
+#include "game/kernel/common/kmalloc.h"
+#include "game/kernel/common/kscheme.h"
+#include "game/kernel/common/memory_layout.h"
+#include "game/kernel/jak1/kscheme.h"
+
+namespace ottsel::signed_gstate {
+namespace {
+bool prepared = false;
+bool loaded[8] = {};
+[[noreturn]] void fail(const char* reason) {
+  std::fprintf(stderr, "SIGNED GSTATE EXPERIMENT rejected: %s\n", reason);
+  std::abort();
+}
+void require(bool condition, const char* reason) { if (!condition) fail(reason); }
+uint32_t offset(const void* pointer) {
+  const uintptr_t p = reinterpret_cast<uintptr_t>(pointer);
+  const uintptr_t base = reinterpret_cast<uintptr_t>(manifest.arena);
+  require(p >= base && p - base <= UINT32_MAX, "pointer outside common u32 window");
+  return uint32_t(p - base);
+}
+void protection(const void* pointer, size_t size, vm_prot_t wanted, bool allow_future_exec = false, bool immutable = false) {
+  uintptr_t cursor = reinterpret_cast<uintptr_t>(pointer), end = cursor + size;
+  require(end >= cursor, "VM range overflow");
+  while (cursor < end) {
+    vm_address_t start = cursor; vm_size_t length = 0;
+    vm_region_basic_info_data_64_t info{};
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t result = vm_region_64(mach_task_self(), &start, &length,
+        VM_REGION_BASIC_INFO_64, reinterpret_cast<vm_region_info_t>(&info), &count, &object);
+    if (object != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), object);
+    require(result == KERN_SUCCESS && start <= cursor && length && start + length > cursor &&
+            info.protection == wanted && (!immutable || info.max_protection == wanted) && (!allow_future_exec || (info.max_protection & VM_PROT_EXECUTE)),
+            "actual VM protection mismatch");
+    cursor = start + length;
+  }
+}
+void validate_module(const Manifest& manifest) {
+  require( manifest.arena_size == EE_MAIN_MEM_SIZE && manifest.reservation_begin >= HEAP_START &&
+          manifest.reservation_begin < GLOBAL_HEAP_END &&
+          manifest.data_span_size <= GLOBAL_HEAP_END - manifest.reservation_begin,
+          "invalid reserved heap tail");
+  const bool expected_release = !std::strcmp(manifest.name, "gcommon") || !std::strcmp(manifest.name, "gkernel-h") ||
+                                !std::strcmp(manifest.name, "gkernel") || !std::strcmp(manifest.name, "pskernel") ||
+                                !std::strcmp(manifest.name, "dgo-h");
+  require(manifest.release_debug == expected_release, "invalid module debug policy");
+  uint32_t previous_end = manifest.reservation_begin;
+  for (size_t segment_index = 0; segment_index < 3; ++segment_index) {
+    const auto& segment = manifest.segments[segment_index];
+    require(segment.source_text_size <= segment.source_size && !(segment.source_text_size & 3),
+            "invalid source segment bounds");
+    if (manifest.release_debug && segment_index == 1) {
+      require(!segment.loaded && !segment.text_size && !segment.data_size && !segment.slot_count && !segment.pointer_count,
+              "release debug segment must be absent");
+    } else {
+      require(segment.loaded && segment.text_size == segment.source_text_size &&
+              uint64_t(segment.text_size) + segment.data_size == segment.source_size,
+              "loaded segment differs from source");
+    }
+    require(offset(segment.data) == segment.data_offset && segment.data_offset >= previous_end &&
+            segment.data_offset >= manifest.reservation_begin &&
+            segment.data_offset <= manifest.reservation_begin + manifest.data_span_size &&
+            segment.data_size <= manifest.reservation_begin + manifest.data_span_size - segment.data_offset,
+            "data outside declared reservation");
+    previous_end = segment.data_offset + segment.data_size;
+    if (!segment.text_size) { require(!segment.data_size && !segment.slot_count && !segment.pointer_count, "data-only or malformed empty segment unsupported"); continue; }
+    uint32_t code = offset(segment.code);
+    require(code >= manifest.arena_size && segment.text_size <= UINT32_MAX - code,
+            "signed text overlaps mutable arena or overflows pointer window");
+    protection(segment.code, segment.text_size, VM_PROT_READ | VM_PROT_EXECUTE, false, true);
+    protection(segment.data, segment.data_size, VM_PROT_READ | VM_PROT_WRITE);
+    std::vector<uint32_t> occupied;
+    for (size_t i = 0; i < segment.slot_count; ++i) {
+      const auto& slot = segment.slots[i];
+      require((slot.offset & 3) == 0, "unaligned slot");
+      for (auto prior : occupied) require(prior != slot.offset, "duplicate slot");
+      occupied.push_back(slot.offset);
+      if (slot.kind == SlotKind::FunctionTag) {
+        require(segment.text_size >= 8 && slot.offset <= segment.text_size - 8,
+                "function tag outside signed text");
+        uint32_t tag; std::memcpy(&tag, segment.code + slot.offset, 4);
+        require(tag == manifest.function_type, "immutable function Type mismatch");
+      } else {
+        require(slot.offset >= segment.text_size && segment.data_size >= 4 &&
+                slot.offset - segment.text_size <= segment.data_size - 4 && slot.name && *slot.name,
+                "slot outside writable data");
+        require(slot.kind == SlotKind::SymbolOffset || slot.kind == SlotKind::SymbolAddress ||
+                (slot.kind == SlotKind::TypePointer && (!std::strcmp(slot.name, "string") ||
+                 !std::strcmp(slot.name, "kernel-context") || !std::strcmp(slot.name, "state")) && slot.methods == 9),
+                "unsupported writable slot");
+      }
+    }
+    for (size_t i = 0; i < segment.pointer_count; ++i) {
+      const auto& pointer = segment.pointers[i];
+      require(!(pointer.patch & 3) && pointer.patch >= segment.text_size && segment.data_size >= 4 &&
+              pointer.patch - segment.text_size <= segment.data_size - 4, "pointer slot outside RW data");
+      for (auto prior : occupied) require(prior != pointer.patch, "overlapping pointer slot");
+      occupied.push_back(pointer.patch);
+      require(pointer.target >= segment.text_size && pointer.target < segment.source_size &&
+              uint64_t(segment.data_offset) + pointer.target - segment.text_size == pointer.goal_offset &&
+              pointer.goal_offset < manifest.arena_size, "pointer target/tag outside declared data");
+    }
+  }
+}
+void validate_layout() {
+  require((module_count >= 1 && module_count <= 3) || module_count == 8, "invalid bounded module count");
+  require(modules[module_count - 1] == &manifest && !std::strcmp(manifest.name, "gstate"),
+          "missing canonical Gstate manifest");
+  const char* comparison[] = {"gcommon", "gstring", "gstate"};
+  const char* kernel[] = {"gcommon", "gstring-h", "gkernel-h", "gkernel", "pskernel", "gstring", "dgo-h", "gstate"};
+  for (size_t i = 0; i < module_count; ++i)
+    require(modules[i] && !std::strcmp(modules[i]->name, module_count == 8 ? kernel[i] : comparison[3 - module_count + i]),
+            "invalid kernel module order");
+  for (size_t i = 0; i < module_count; ++i) {
+    const auto& current = *modules[i];
+    require(current.arena == manifest.arena && current.arena_size == manifest.arena_size &&
+            current.function_type == manifest.function_type, "different module arena/Type");
+    validate_module(current);
+    for (size_t j = 0; j < i; ++j) {
+      const auto& other = *modules[j];
+      require(uint64_t(current.reservation_begin) + current.data_span_size <= other.reservation_begin ||
+              uint64_t(other.reservation_begin) + other.data_span_size <= current.reservation_begin,
+              "overlapping module data reservations");
+      for (const auto& a : current.segments) for (const auto& b : other.segments) {
+        if (a.text_size && b.text_size)
+          require(uint64_t(offset(a.code)) + a.text_size <= offset(b.code) ||
+                  uint64_t(offset(b.code)) + b.text_size <= offset(a.code),
+                  "overlapping module signed text");
+      }
+    }
+  }
+}
+uint32_t reservation_begin() {
+  uint32_t begin = manifest.reservation_begin;
+  for (size_t i = 0; i < module_count; ++i)
+    if (modules[i]->reservation_begin < begin) begin = modules[i]->reservation_begin;
+  return begin;
+}
+}  // namespace
+uint8_t* prepare_arena() {
+  require(!prepared, "arena already initialized");
+  const auto* h = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(0));
+  require(h && h->magic == MH_MAGIC_64, "invalid main image");
+  auto slide = _dyld_get_image_vmaddr_slide(0);
+  const auto* command = reinterpret_cast<const load_command*>(h + 1);
+  const auto* commands_end = reinterpret_cast<const uint8_t*>(command) + h->sizeofcmds;
+  bool owned = false;
+  for (uint32_t i = 0; i < h->ncmds; ++i) {
+    require(reinterpret_cast<const uint8_t*>(command) + sizeof(load_command) <= commands_end &&
+            command->cmdsize >= sizeof(load_command) &&
+            command->cmdsize <= size_t(commands_end - reinterpret_cast<const uint8_t*>(command)),
+            "invalid image load command");
+    if (command->cmd == LC_SEGMENT_64) {
+      require(command->cmdsize >= sizeof(segment_command_64), "invalid segment command");
+      auto* s = reinterpret_cast<const segment_command_64*>(command);
+      if (!std::strncmp(s->segname, "__ARENA", 16)) {
+        require(!owned, "multiple arenas");
+        owned = s->vmaddr + slide == reinterpret_cast<uintptr_t>(manifest.arena) &&
+                s->vmsize == manifest.arena_size && !s->filesize && s->initprot == 3;
+      }
+    }
+    command = reinterpret_cast<const load_command*>(reinterpret_cast<const uint8_t*>(command) + command->cmdsize);
+  }
+  require(owned && reinterpret_cast<uintptr_t>(manifest.arena) % sysconf(_SC_PAGESIZE) == 0,
+          "arena is not owned zero-fill mapping");
+  validate_layout();
+  // Deliberately mixed-runtime experiment, before bootstrap. Never MAP_JIT.
+  require(mmap(manifest.arena, manifest.arena_size, PROT_READ | PROT_WRITE,
+               MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == manifest.arena,
+          "anonymous arena replacement failed");
+  protection(manifest.arena, manifest.arena_size, VM_PROT_READ | VM_PROT_WRITE, true);
+  validate_layout(); prepared = true;
+  std::fprintf(stderr, "SIGNED GSTATE EXPERIMENT: mixed-runtime arena; reservation=0x%x bytes=%u source=%s\n",
+               reservation_begin(), GLOBAL_HEAP_END - reservation_begin(), manifest.sha256);
+  return manifest.arena;
+}
+uint32_t heap_end() { require(prepared, "heap before arena initialization"); return reservation_begin(); }
+void require_rx(const void* address, size_t size) { protection(address, size, VM_PROT_READ | VM_PROT_EXECUTE); }
+size_t loaded_count() { size_t count = 0; for (size_t i=0;i<module_count;++i) count += loaded[i]; return count; }
+bool valid_function(uint32_t pointer) {
+  if (!prepared || g_ee_main_mem != manifest.arena || !s7.offset) return false;
+  const uint32_t actual = *(s7 + jak1_symbols::FIX_SYM_FUNCTION_TYPE);
+  if (actual != manifest.function_type) return false;
+  for (size_t m = 0; m < module_count; ++m) {
+    if (!loaded[m]) continue;
+    for (const auto& segment : modules[m]->segments) {
+      for (size_t i = 0; i < segment.slot_count; ++i) {
+        const auto& slot = segment.slots[i];
+        if (slot.kind == SlotKind::FunctionTag && pointer == offset(segment.code + slot.offset + 4)) {
+          require_rx(segment.code + slot.offset, 8);
+          uint32_t tag; std::memcpy(&tag, segment.code + slot.offset, 4);
+          return tag == actual;
+        }
+      }
+    }
+  }
+  return false;
+}
+bool link(const uint8_t* bytes, const char* name, int32_t size, uint32_t flags, uint32_t heap, bool jump_from_c_to_goal, uint32_t* entry) {
+  if (!name) return false;
+  size_t selected = 0;
+  while (selected < module_count && std::strcmp(name, modules[selected]->name)) ++selected;
+  if (selected == module_count) return false;
+  const Manifest& manifest = *modules[selected];
+  require(prepared && (selected == 0 || loaded[selected - 1]), "signed kernel module order mismatch");
+  require(jump_from_c_to_goal && heap == kglobalheap.offset, "requires C entry and global heap");
+  require(prepared && g_ee_main_mem == manifest.arena && !loaded[selected], "arena mismatch or duplicate module load");
+  require(bytes && size > 0 && uint32_t(size) == manifest.source_size, "source size mismatch");
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH]; char hex[65];
+  CC_SHA256(bytes, CC_LONG(size), digest);
+  for (size_t i = 0; i < sizeof(digest); ++i) std::snprintf(hex + i * 2, 3, "%02x", digest[i]);
+  require(!std::strcmp(hex, manifest.sha256), "source SHA mismatch");
+  require(*(s7 + jak1_symbols::FIX_SYM_FUNCTION_TYPE) == manifest.function_type, "bootstrap function Type mismatch");
+  // Explicit bounded normal KERNEL load contract. Other modes fail closed.
+  require(!MasterDebug && (!manifest.release_debug || !DebugSegment) && (flags & LINK_FLAG_EXECUTE) &&
+          !(flags & ~(LINK_FLAG_EXECUTE | LINK_FLAG_OUTPUT_LOAD | LINK_FLAG_PRINT_LOGIN)),
+          "unsupported signed module debug/link mode");
+  validate_layout();
+  struct Write { uint8_t* address; uint32_t value; };
+  std::vector<Write> writes;
+  // Capture existing resolutions; diagnostic reads must not intern new symbols.
+  const char* diagnostic_names[] = {"inherit-state", "enter-state", "send-event-function", "looping-code", "state"};
+  uint32_t diagnostic_symbols[5] = {};
+  for (const auto& segment : manifest.segments) {
+    for (size_t i = 0; i < segment.slot_count; ++i) {
+      const auto& slot = segment.slots[i]; if (slot.kind == SlotKind::FunctionTag) continue;
+      uint32_t value;
+      if (slot.kind == SlotKind::TypePointer) value = jak1::intern_type_from_c(slot.name, slot.methods).offset;
+      else {
+        auto sym = jak1::intern_from_c(slot.name);
+        for (size_t i = 0; i < 5; ++i)
+          if (!std::strcmp(slot.name, diagnostic_names[i])) diagnostic_symbols[i] = sym.offset;
+        value = slot.kind == SlotKind::SymbolAddress ? sym.offset : sym.offset - s7.offset;
+      }
+      writes.push_back({segment.data + slot.offset - segment.text_size, value});
+    }
+    for (size_t i = 0; i < segment.pointer_count; ++i) {
+      const auto& pointer = segment.pointers[i];
+      writes.push_back({segment.data + pointer.patch - segment.text_size, pointer.goal_offset});
+    }
+  }
+  for (const auto& segment : manifest.segments)
+    if (segment.data_size) std::memcpy(segment.data, segment.initial_data, segment.data_size);
+  for (const auto& write : writes) std::memcpy(write.address, &write.value, 4);
+  loaded[selected] = true;  // Never blindly replay a partially executed top-level.
+  *entry = offset(manifest.segments[2].code + 4);
+  require(valid_function(*entry), "top is not a registered signed function");
+  const uint32_t signed_main = offset(manifest.segments[0].code);
+  if (!std::strcmp(name, "gstate")) lg::info("SIGNED GSTATE ENTER: entry=0x{:x} main=0x{:x} type=0x{:x} heap=0x{:x} flags=0x{:x} source={}",
+           *entry, signed_main, manifest.function_type, heap, flags, manifest.sha256);
+  else if (!std::strcmp(name, "gstring")) lg::info("SIGNED GSTRING ENTER: entry=0x{:x} main=0x{:x} type=0x{:x} source={}",
+                *entry, signed_main, manifest.function_type, manifest.sha256);
+  else lg::info("SIGNED MODULE ENTER: name={} entry=0x{:x} main=0x{:x} type=0x{:x} source={}",
+                name, *entry, signed_main, manifest.function_type, manifest.sha256);
+  call_goal_on_stack(Ptr<Function>(*entry), reinterpret_cast<uint64_t>(g_ee_main_mem) + EE_MAIN_MEM_SIZE - 16,
+                     s7.offset, g_ee_main_mem);
+  if (std::strcmp(name, "gstate")) {
+    if (!std::strcmp(name, "gstring"))
+      lg::info("SIGNED GSTRING RETURNED: entry=0x{:x} source={}", *entry, manifest.sha256);
+    else lg::info("SIGNED MODULE RETURNED: name={} entry=0x{:x} source={}", name, *entry, manifest.sha256);
+    return true;
+  }
+  uint32_t values[5] = {};
+  for (size_t i = 0; i < 5; ++i)
+    if (diagnostic_symbols[i]) values[i] = Ptr<jak1::Symbol>(diagnostic_symbols[i])->value;
+  uint32_t new_method = 0, print_method = 0;
+  const uint32_t state = values[4];
+  if ((state & 7) == 4 && state >= 4 && state <= manifest.reservation_begin - sizeof(jak1::Type) &&
+      *Ptr<uint32_t>(state - 4) == *(s7 + jak1_symbols::FIX_SYM_TYPE_TYPE)) {
+    new_method = Ptr<jak1::Type>(state)->new_method.offset;
+    print_method = Ptr<jak1::Type>(state)->print_method.offset;
+  }
+  // Expectations correspond to the exact genuine Gstate SHA logged above.
+  lg::info("SIGNED GSTATE RETURNED: entry=0x{:x} functions=[{:x},{:x},{:x},{:x}] "
+           "expected=[{:x},{:x},{:x},{:x}] methods=[{:x},{:x}] expected=[{:x},{:x}]",
+           *entry, values[0], values[1], values[2], values[3],
+           signed_main + 308, signed_main + 724, signed_main + 2708, signed_main + 3076,
+           new_method, print_method, signed_main + 4, signed_main + 580);
+  return true;
+}
+}  // namespace ottsel::signed_gstate
+#endif
