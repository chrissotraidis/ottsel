+  // G2.3: the PLAY-STR command names a stream either as a VAG name ("$name") or as an animation name;
+  // the desktop handler maps both to an 8-character disc token, and the play and stop branches both need it.
+  auto ottsel_play_token = [](char* out, size_t out_size, const char* name) {
+    char copy[49] = {};
+    memcpy(copy, name, 48);
+    if (out_size < 9) { out[0] = 0; return; }
+    if (copy[0] == '$') {
+      const char* part = &copy[1];
+      const size_t len = strnlen(part, 15);
+      if (len < 9) { memset(out, ' ', 8); memcpy(out, part, len); } else { memcpy(out, part, 8); }
+      for (int k = 0; k < 8; ++k) { if (out[k] >= 0x61 && out[k] < 0x7b) out[k] -= 0x20; }
+    } else {
+      file_util::ISONameFromAnimationName(out, copy);
+    }
+    out[8] = 0;
+  };
