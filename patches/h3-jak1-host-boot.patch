+                                  emitter::IR_Record irec) {
+  // x86 thread-suspend pops the return address pushed by `call` (which
+  // advances the stack by 8).  The x86 shim does not have the ARM64
+  // synthetic-continuation slot, so this is a plain pop.
+  if (m_use_coloring) {
