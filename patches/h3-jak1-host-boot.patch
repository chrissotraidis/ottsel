+  EXPECT_TRUE(shadow_mscal_vu2c_is_supported(6));
+  EXPECT_FALSE(shadow_mscal_vu2c_is_supported(0));
+  EXPECT_FALSE(shadow_mscal_vu2c_is_supported(5));
+}
