+      // inputs — track when *math-camera* trans (ref+844) goes NaN.
+      u32 mc = jak1::intern_from_c("*math-camera*")->value;
+      if (mc > 0x1000 && mc < (100u << 20)) {
+        const float* t = (const float*)(g_ee_main_mem + mc + 844);
+        const float* r = (const float*)(g_ee_main_mem + mc + 364);
+        lg::info("OTTSEL CAMWATCH: trans=({},{},{},{}) rot0=({},{},{},{})", t[0], t[1], t[2], t[3],
+                 r[0], r[1], r[2], r[3]);
+      }
+      // BOT31: Jak's own position (input-response ground truth).  target
+      // root (trsqv) at pd ref+108; trans vector inline at root ref+12.
+      u32 tgt = jak1::intern_from_c("*target*")->value;
+      if (tgt > 0x1000 && tgt < (100u << 20) && tgt != 0x18fe04) {
+        u32 root = *(const u32*)(g_ee_main_mem + tgt + 108);
+        if (root > 0x1000 && root < (100u << 20)) {
+          const float* jt = (const float*)(g_ee_main_mem + root + 12);
+          lg::info("OTTSEL JAKPOS: trans=({:.1f},{:.1f},{:.1f})", jt[0], jt[1], jt[2]);
+        }
+      }
+    }
+    // Background-engine linkage is likewise a bounded trace, not a permanent
+    // per-second dump during normal gameplay.
+    if (ottsel_runtime_trace && (ottsel_pad_reads % 250) == 4 && g_ee_main_mem) {
+      u32 eng = jak1::intern_from_c("*background-draw-engine*")->value;
+      u32 abd = jak1::intern_from_c("add-bsp-drawable")->value;
+      auto eeok = [](u32 a) { return a >= 0x1000 && a < (128u << 20); };
+      auto w = [](u32 a) { return *(const u32*)(g_ee_main_mem + a); };
+      if (eeok(eng)) {
+        u32 lenw = w(eng + 4);
+        lg::info("OTTSEL ENG: eng=0x{:x} abd=0x{:x} len={} alloc={} alive-head=0x{:x} "
+                 "alive-end-node=0x{:x}",
+                 eng, abd, (s16)(lenw & 0xffff), (s16)(lenw >> 16), w(eng + 28), eng + 44);
+        u32 node = w(eng + 28);
+        for (int i = 0; i < 12 && eeok(node) && node != eng + 44; i++) {
+          lg::info("OTTSEL ENG[{}]: @0x{:08x} next0={:08x} prev0={:08x} next1={:08x} "
+                   "prev1={:08x} p0={:08x} p1={:08x} p2={:08x} p3={:08x}",
+                   i, node, w(node), w(node + 4), w(node + 8), w(node + 12), w(node + 16),
+                   w(node + 20), w(node + 24), w(node + 28));
+          node = w(node);
+        }
+      }
+    }
+  }
+  if (g_ottsel_bg_village1_request == 1) {
+    g_ottsel_bg_village1_request = 2;  // once
+    u32 bg_fn = jak1::intern_from_c("bg")->value;
+    u32 vname = jak1::intern_from_c("village1").offset;
+    if (bg_fn) {
+      lg::info("OTTSEL BG: calling (bg 'village1) fn=0x{:x} sym=0x{:x}", bg_fn, vname);
+      u64 rv = call_goal(Ptr<Function>(bg_fn), vname, 0, 0, s7.offset, g_ee_main_mem);
+      lg::info("OTTSEL BG: (bg 'village1) returned 0x{:x}", rv);
+      // The genuine debug (bg ...) flow has (-> *level* play?) = #f, so the
+      // no-vis fallback in cam-update copies the bsp's all-visible-list into
+      // vis-bits each frame.  Our boot ran (play) first (play? = #t), which
+      // leaves vis-bits all-zero forever when no VIS file exists ("in
+      // between vis" branch).  Restore the bg-flow state: play? = #f.
+      // level-group ref-relative: play? at +36 (mem offset 40 minus basic 4).
+      u32 grp = jak1::intern_from_c("*level*")->value;
+      if (grp >= 0x080000 && grp < 0x08000000) {
+        *(u32*)(g_ee_main_mem + grp + 36) = s7.offset;
+        lg::info("OTTSEL BG: set (-> *level* play?) #f (group=0x{:x})", grp);
+      }
+      // With the camera inside village1's boxes, cam-update takes the
+      // self-vis branch (update-vis!), which can never succeed without VIS
+      // data (no VIS files in iso_data) and never falls back to the
+      // all-visible-list.  Use the engine's own artist debug toggle: with
+      // *artist-all-visible* = #t, cam-update unconditionally copies the
+      // bsp's all-visible-list into vis-bits each frame.
+      jak1::intern_from_c("*artist-all-visible*")->value = s7.offset + jak1_symbols::FIX_SYM_TRUE;
+      lg::info("OTTSEL BG: set *artist-all-visible* #t");
+      // BOT28: spawn the target at the continue point bg selected — the
+      // canonical debug flow is (bg 'village1) then (start 'play cp).
+      // Without a target the camera has no viewpoint and the frame is a
+      // (correctly rendered) near-empty void.  `start` also `stop`s the
+      // old target the title flow left suspended in target-continue.
+      u32 start_fn = jak1::intern_from_c("start")->value;
+      u32 gi2 = jak1::intern_from_c("*game-info*")->value;
+      if (start_fn && gi2 >= 0x80000 && gi2 < 0x8000000) {
+        u32 cp = *(u32*)(g_ee_main_mem + gi2 + 104);  // current-continue (ref+104)
+        u32 play_sym = jak1::intern_from_c("play").offset;
+        lg::info("OTTSEL BG: calling (start 'play cp) fn=0x{:x} cp=0x{:x}", start_fn, cp);
+        u64 tgt = call_goal(Ptr<Function>(start_fn), play_sym, cp, 0, s7.offset, g_ee_main_mem);
+        lg::info("OTTSEL BG: (start 'play) returned *target*=0x{:x}", tgt);
+      }
+    } else {
+      lg::warn("OTTSEL BG: bg symbol has no function value");
+    }
   }
 
   return 32;
diff --git a/game/sce/ottsel_platform_input.cpp b/game/sce/ottsel_platform_input.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9af579692ac06beef98240e5898f43bbae26383b
--- /dev/null
+++ b/game/sce/ottsel_platform_input.cpp
@@ -0,0 +1,138 @@
+#include "ottsel_platform_input.h"
+
+#include <algorithm>
+#include <array>
+#include <mutex>
+
+namespace ottsel::platform_input {
+namespace {
+constexpr int kPadCount = 4;
+
+struct InputState {
+  std::array<PadState, kPadCount> states;
+  std::array<u16, kPadCount> latched_buttons;
+  std::array<int, kPadCount> latched_reads;
+  std::mutex mutex;
+};
+
+// The GOAL thread can still be draining pad reads while the host UI is
+// tearing down. Keep the bridge state alive until process termination so an
+// exit-time destructor cannot invalidate the mutex under a live reader.
+InputState& input_state() {
+  static auto* state = new InputState();
+  return *state;
+}
+
+int pressure_index(Button button) {
+  switch (button) {
+    case DpadRight:
+      return 0;
+    case DpadLeft:
+      return 1;
+    case DpadUp:
+      return 2;
+    case DpadDown:
+      return 3;
+    case Triangle:
+      return 4;
+    case Circle:
+      return 5;
+    case Cross:
+      return 6;
+    case Square:
+      return 7;
+    case L1:
+      return 8;
+    case R1:
+      return 9;
+    case L2:
+      return 10;
+    case R2:
+      return 11;
+    default:
+      return -1;
+  }
+}
+
+bool valid_port(int port) {
+  return port >= 0 && port < kPadCount;
+}
+}  // namespace
+
+void set_pad_state(int port, const PadState& state) {
+  if (!valid_port(port)) {
+    return;
+  }
+  std::lock_guard lock(input_state().mutex);
+  input_state().states.at(port) = state;
+}
+
+PadState get_pad_state(int port) {
+  std::lock_guard lock(input_state().mutex);
+  if (!valid_port(port)) {
+    return PadState{};
+  }
+  auto result = input_state().states.at(port);
+  const auto latched = input_state().latched_buttons.at(port);
+  result.buttons |= latched;
+  for (int bit = 0; bit < 16; ++bit) {
+    const auto button = static_cast<Button>(1u << bit);
+    const int index = pressure_index(button);
+    if (index >= 0 && (latched & button)) {
+      result.pressure.at(index) = 255;
+    }
+  }
+  if (input_state().latched_reads.at(port) > 0 &&
+      --input_state().latched_reads.at(port) == 0) {
+    input_state().latched_buttons.at(port) = 0;
+  }
+  return result;
+}
+
+void latch_button(int port, Button button, int pad_reads) {
+  if (!valid_port(port) || !button || pad_reads <= 0) {
+    return;
+  }
+  std::lock_guard lock(input_state().mutex);
+  input_state().latched_buttons.at(port) |= button;
+  input_state().latched_reads.at(port) =
+      std::max(input_state().latched_reads.at(port), pad_reads);
+}
+
+void latch_native_button(int port, Button button) {
+  latch_button(port, button, kNativeDigitalLatchPadReads);
+}
+
+void clear_pad_state(int port) {
+  if (!valid_port(port)) {
+    return;
+  }
+  std::lock_guard lock(input_state().mutex);
+  input_state().states.at(port) = PadState{};
+  input_state().latched_buttons.at(port) = 0;
+  input_state().latched_reads.at(port) = 0;
+}
+
+void clear_all_pad_states() {
+  std::lock_guard lock(input_state().mutex);
+  input_state().states.fill(PadState{});
+  input_state().latched_buttons.fill(0);
+  input_state().latched_reads.fill(0);
+}
+
+void set_button(PadState* state, Button button, bool pressed) {
+  if (!state) {
+    return;
+  }
+  if (pressed) {
+    state->buttons |= button;
+  } else {
+    state->buttons &= ~button;
+  }
+  const int index = pressure_index(button);
+  if (index >= 0) {
+    state->pressure.at(index) = pressed ? 255 : 0;
+  }
+}
+
+}  // namespace ottsel::platform_input
diff --git a/game/sce/ottsel_platform_input.h b/game/sce/ottsel_platform_input.h
new file mode 100644
index 0000000000000000000000000000000000000000..943a984a7e0858766259a08ada7783cff1c834e2
--- /dev/null
+++ b/game/sce/ottsel_platform_input.h
@@ -0,0 +1,100 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+
+#include "common/common_types.h"
+
+// A platform-neutral snapshot of the DualShock 2 data consumed by scePadRead.
+// Desktop SDL input reaches the same wire format through PadData; mobile hosts
+// use this small bridge because they do not create the desktop Display object.
+namespace ottsel::platform_input {
+
+// Mobile UI events and the GOAL thread are not sampled in the same event
+// loop. Keep a short keyboard/mouse edge alive long enough for a title or
+// progress transition to observe it, while remaining bounded and neutralizing.
+constexpr int kNativeDigitalLatchPadReads = 30;
+
+enum Button : u16 {
+  Select = 1u << 0,
+  L3 = 1u << 1,
+  R3 = 1u << 2,
+  Start = 1u << 3,
+  DpadUp = 1u << 4,
+  DpadRight = 1u << 5,
+  DpadDown = 1u << 6,
+  DpadLeft = 1u << 7,
+  L2 = 1u << 8,
+  R2 = 1u << 9,
+  L1 = 1u << 10,
+  R1 = 1u << 11,
+  Triangle = 1u << 12,
+  Circle = 1u << 13,
+  Cross = 1u << 14,
+  Square = 1u << 15,
+};
+
+struct PadState {
+  u8 leftx = 127;
+  u8 lefty = 127;
+  u8 rightx = 127;
+  u8 righty = 127;
+  u16 buttons = 0;
+  std::array<u8, 12> pressure{};
+};
+
+// Mouse motion arrives on the SDL/UI thread while scePadRead samples on the
+// EE thread. Keep a camera impulse alive for the same bounded window used by
+// digital tap edges instead of dropping it at the end of one event-loop pass.
+struct MouseMotionLatch {
+  u8 rightx = 127;
+  u8 righty = 127;
+  int remaining_reads = 0;
+
+  void add(float xrel, float yrel, int pad_reads = 8) {
+    const int accumulated_x = static_cast<int>(rightx) - 127 + static_cast<int>(xrel * 8.f);
+    const int accumulated_y = static_cast<int>(righty) - 127 + static_cast<int>(yrel * 8.f);
+    rightx = static_cast<u8>(std::clamp(127 + accumulated_x, 0, 255));
+    righty = static_cast<u8>(std::clamp(127 + accumulated_y, 0, 255));
+    remaining_reads = std::max(remaining_reads, pad_reads);
+  }
+
+  void advance_event_loop() {
+    if (remaining_reads > 0 && --remaining_reads == 0) {
+      rightx = 127;
+      righty = 127;
+    }
+  }
+};
+
+// SDL instance IDs are the ownership key for the selected pad-0 controller.
+// Zero is the shell's no-owner sentinel and must never match an event.
+constexpr bool owns_gamepad_event(s32 selected_instance, s32 event_instance) {
+  return selected_instance != 0 && selected_instance == event_instance;
+}
+
+// SDL mirrors touch input through its mouse event stream. Mobile shells must
+// leave those synthesized events on the touch path; only a distinct mouse ID
+// should switch the UI to native keyboard/mouse mode.
+constexpr bool routes_to_native_mouse(u32 mouse_id, u32 touch_mouse_id) {
+  return mouse_id != touch_mouse_id;
+}
+
+// The UI thread may update a state while the GOAL thread samples it.  The
+// bridge snapshots it atomically at the API boundary; callers never retain a
+// mutable reference to the shared state.
+void set_pad_state(int port, const PadState& state);
+PadState get_pad_state(int port);
+// Keep a short digital edge alive across the asynchronous host/UI and EE
+// polling boundary. This is for event-driven keyboard taps; held input stays
+// in PadState and is unaffected.
+void latch_button(int port, Button button, int pad_reads);
+void latch_native_button(int port, Button button);
+void clear_pad_state(int port);
+void clear_all_pad_states();
+
+// Digital keyboard/gamepad/touch actions use full DualShock pressure for
+// pressure-aware GOAL paths, exactly as the desktop keyboard mapping does.
+void set_button(PadState* state, Button button, bool pressed);
+
+}  // namespace ottsel::platform_input
diff --git a/game/sce/ottsel_stream_clock.h b/game/sce/ottsel_stream_clock.h
new file mode 100644
index 0000000000000000000000000000000000000000..d1aee0f567f68a779f3650471cfbe24482d7c85e
--- /dev/null
+++ b/game/sce/ottsel_stream_clock.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <limits>
+
+#include "common/common_types.h"
+
+namespace ottsel::stream_clock {
+
+struct Snapshot {
+  u32 id = 0;
+  s32 position = -1;
+  bool playing = false;
+};
+
+class Clock {
+ public:
+  using TimePoint = std::chrono::steady_clock::time_point;
+
+  void play(u32 id, TimePoint now = std::chrono::steady_clock::now()) {
+    m_id = id;
+    m_started = now;
+    m_playing = true;
+  }
+
+  void stop() {
+    m_id = 0;
+    m_playing = false;
+  }
+
+  Snapshot snapshot(TimePoint now = std::chrono::steady_clock::now()) const {
+    if (!m_playing) {
+      return {};
+    }
+    const auto micros =
+        std::max<s64>(0, std::chrono::duration_cast<std::chrono::microseconds>(now - m_started).count());
+    const auto position = std::min<s64>((micros * 1024) / 1000000,
+                                        std::numeric_limits<s32>::max());
+    return {m_id, static_cast<s32>(position), true};
+  }
+
+ private:
+  u32 m_id = 0;
+  TimePoint m_started{};
+  bool m_playing = false;
+};
+
+}  // namespace ottsel::stream_clock
