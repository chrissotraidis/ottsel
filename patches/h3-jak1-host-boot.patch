+  } else {
+    gen->add_instr(IGen::pop_gpr64(*gen, get_no_color_reg(m_dst)), irec);
+  }
+}
+
+void IR_AsmLoadSp::do_codegen_arm64(emitter::ObjectGenerator* gen,
+                                    const AllocationResult& allocs,
+                                    emitter::IR_Record irec) {
+  // ARM64 thread-suspend: read the synthetic post-blr continuation from [sp]
+  // WITHOUT advancing sp.  The call shim pushed two slots (the incoming x30
+  // and the synthetic continuation); the suspend saves pc = the continuation
+  // and sp = the synthetic slot, so on resume the shim's post-blr pops BOTH
+  // slots (restoring the caller's x30 and sp).  An advancing pop here
+  // double-pops on resume: sp climbs +16 per dispatch, which is the observed
+  // camera stack climb into the debug-dead-pool region (S2.1 cont 18).
+  if (m_use_coloring) {
+    gen->add_instr(IGen::load_gpr64_sp(*gen, get_reg(m_dst, allocs, irec)), irec);
+  } else {
+    gen->add_instr(IGen::load_gpr64_sp(*gen, get_no_color_reg(m_dst)), irec);
+  }
 }
 
