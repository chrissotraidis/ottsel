-  ; restore arguments
-  ldp x1, x0, [sp], #16
-  ldp x3, x2, [sp], #16
-  ldp x5, x4, [sp], #16
-  ldp x7, x6, [sp], #16
+  ;; BOT24: discard the argument array WITHOUT restoring registers -- the C
+  ;; function's return value is in x0, and the old `ldp x0, x1, [sp], #16`
+  ;; clobbered it with saved arg 0.  GOAL received the first argument as the
+  ;; "return" (found via the text loader: `link` returned the load address
+  ;; instead of the linked object, so load-game-text-info reloaded
