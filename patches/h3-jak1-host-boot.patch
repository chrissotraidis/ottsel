+// EE 0x4f10904, caught under lldb).  Per-slot sealing removes the ordering
+// dependency: every stub's page is RX + icache-invalidated the moment it is
+// fully written, and re-opened RW only for the next write to that page.
+u32 g_ottsel_stub_last_off = 0;
