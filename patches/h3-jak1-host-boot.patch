+#include "goalc/emitter/Register.h"
+
+using namespace emitter;
+
+// Provided by asm_funcs_arm64.s (assembled into this binary).
+// Apple asm symbols already carry the leading underscore.
+extern "C" uint64_t _call_goal_asm_arm64(u64 a0, u64 a1, u64 a2, void* fptr, void* st_ptr,
+                                         void* offset) asm("_call_goal_asm_arm64");
+extern "C" uint64_t _call_goal_on_stack_asm_arm64(u64 rsp, u64 u0, u64 u1, void* fptr,
+                                                  void* st_ptr, void* offset) asm(
+    "_call_goal_on_stack_asm_arm64");
+
+static FunctionEnv* pick_user_function(FileEnv* fe) {
+  for (auto& f : fe->functions()) {
+    if (f->name().find("ottsel-h2") != std::string::npos) {
+      return f.get();
+    }
+  }
+  if (!fe->functions().empty()) {
+    return fe->functions().back().get();
+  }
+  return nullptr;
+}
+
+static void* make_rx(const std::vector<u8>& code) {
+  size_t page = 4096;
+  size_t alloc = (code.size() + page - 1) / page * page;
+  void* p = mmap(nullptr, alloc, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (p == MAP_FAILED) throw std::runtime_error("mmap failed");
+  std::memcpy(p, code.data(), code.size());
+  __builtin___clear_cache((char*)p, (char*)p + alloc);
+  if (mprotect(p, alloc, PROT_READ | PROT_EXEC) != 0) throw std::runtime_error("mprotect RX failed");
+  return p;
+}
+
+int main() {
+  lg::set_stdout_level(lg::level::warn);
+  lg::set_flush_level(lg::level::warn);
+  lg::initialize();
+
+  if (!file_util::setup_project_path(std::nullopt)) {
+    std::cerr << "setup_project_path failed\n";
+    return 2;
+  }
+
+  try {
+    Compiler compiler(GameVersion::Jak1, InstructionSet::ARM64);
+    RegisterInfo::set_active_instruction_set(InstructionSet::ARM64);
+
+    struct Case {
+      const char* name;
+      const char* src;
+      u64 in0, in1, in2;
+      u64 expected;
+    } cases[] = {
+        {"add", "(defun ottsel-h2-badd ((a int) (b int)) (+ a b))", 40, 2, 0, 42},
+        {"const", "(defun ottsel-h2-bconst () 123)", 0, 0, 0, 123},
+        {"branch", "(defun ottsel-h2-babs ((a int)) (if (< a 0) (- 0 a) a))", u64(s64(-7)), 0, 0, 7},
+    };
+
+    int pass = 0;
+    for (auto& cs : cases) {
+      std::cout << "[H2-bridge] " << cs.name << "\n";
+      auto obj = compiler.get_goos().reader.read_from_string(cs.src, true, cs.name);
+      auto* fe = compiler.compile_object_file(cs.name, obj, true);
+      compiler.color_only_for_proof(fe);
+      auto* fenv = pick_user_function(fe);
+      if (!fenv) {
+        std::cerr << "  no function env\n";
+        return 1;
+      }
+      auto* debug = &compiler.get_debugger().get_debug_info_for_object(fe->name());
+      debug->clear();
+      CodeGenerator gen(fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+      auto bytes = gen.emit_function_machine_code(fenv, 0);
+      void* code = make_rx(bytes);
+      std::cout << "  code_bytes=" << bytes.size() << " rx=" << code << "\n";
+
+      // st = symbol table pointer; our test functions only need st != 0.
+      // Pass a fake symbol-table address (some writable memory) and offset 0.
+      static u64 fake_symbol_table[64] = {0};
+      u64 got = _call_goal_asm_arm64(cs.in0, cs.in1, cs.in2, code, fake_symbol_table, 0);
+      std::cout << "  got=" << s64(got) << " expected=" << s64(cs.expected) << "\n";
+      if (got != cs.expected) {
+        std::cerr << "  MISMATCH\n";
+        return 1;
+      }
+      pass++;
+    }
+    std::cout << "[H2-bridge] PASS cases=" << pass << "\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << "fatal: " << e.what() << "\n";
+    return 1;
+  }
+}
diff --git a/tools/ottsel_h2/h2_noemit_runtime_proof.cpp b/tools/ottsel_h2/h2_noemit_runtime_proof.cpp
