+#if defined(OTTSEL_NO_EMIT) && defined(__aarch64__)
+/*!
+ * Ottsel H3 no-emit: C-export stubs must not live in the RW-only GOAL heap.
+ * We write them into a fixed executable stub arena inside the EE mapping and
+ * flip the used pages to RX before any GOAL code runs.  Two sub-arenas are
+ * used because stubs are created in two boot phases:
+ *   - phase A (pre-kernel-link): stubs created by InitHeapAndSymbol before the
+ *     kernel CGO is linked.  Flipped RX in jak1_finish (before the top-level
+ *     executes).
+ *   - phase B (post-kernel-link): stubs created by InitMachineScheme after the
+ *     kernel DGO load.  Flipped RX right before KernelCheckAndDispatch.
+ * Both are fixed EE offsets in the free gap between GLOBAL_HEAP_END
+ * (~0x3eb82e0) and DEBUG_HEAP_START (0x5000000); 16KB-page aligned.
+ */
+namespace {
+constexpr u32 OTTSEL_STUB_ARENA_A = 0x04F00000;
+constexpr u32 OTTSEL_STUB_ARENA_B = 0x04F10000;
+constexpr u32 OTTSEL_STUB_ARENA_SIZE = 0x10000;  // 64KB each
+constexpr u32 OTTSEL_STUB_SLOT = 0x48;           // type u32 + code (0x40)
+
+u32 g_ottsel_stub_next = 0;          // next free slot in the active arena
+bool g_ottsel_stub_use_b = false;    // true once phase A is flipped
+bool g_ottsel_stub_b_flipped = false;
+
+u32 ottsel_stub_arena_base() {
+  return g_ottsel_stub_use_b ? OTTSEL_STUB_ARENA_B : OTTSEL_STUB_ARENA_A;
+}
+
+void ottsel_stub_flip_pages_rx(u32 ee_base, u32 used) {
+  if (!used) {
+    return;
+  }
+  const uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);  // 16KB on Apple Silicon
+  uintptr_t lo = (uintptr_t)(::g_ee_main_mem + ee_base) & ~(page - 1);
+  uintptr_t hi = ((uintptr_t)(::g_ee_main_mem + ee_base + used) + page - 1) & ~(page - 1);
+  for (uintptr_t addr = lo; addr < hi; addr += page) {
+    if (mprotect((void*)addr, page, PROT_READ | PROT_EXEC) != 0) {
+      lg::debug("OTTSEL no-emit: stub page @ 0x{:x} RX flip skipped: {}", addr, strerror(errno));
+    }
+  }
+}
+}  // namespace
+
+u32 ottsel_stub_alloc(u32 size) {
+  u32 base = ottsel_stub_arena_base();
+  u32 off = base + g_ottsel_stub_next * OTTSEL_STUB_SLOT;
+  ASSERT_MSG(size <= OTTSEL_STUB_SLOT, "stub too large for arena slot");
+  ASSERT_MSG(off + size <= base + OTTSEL_STUB_ARENA_SIZE, "stub arena exhausted");
+  g_ottsel_stub_next++;
+  return off;
+}
+
+void ottsel_stub_flip_phase_a() {
+  if (g_ottsel_stub_use_b) {
+    return;  // already flipped
+  }
+  const u32 used = g_ottsel_stub_next * OTTSEL_STUB_SLOT;
+  ottsel_stub_flip_pages_rx(OTTSEL_STUB_ARENA_A, used);
+  lg::debug("OTTSEL no-emit: stub arena A flipped RX ({} bytes used)", used);
+  g_ottsel_stub_use_b = true;
+  g_ottsel_stub_next = 0;
+}
+
+void ottsel_stub_flip_phase_b() {
+  if (g_ottsel_stub_b_flipped) {
+    return;
+  }
+  const u32 used = g_ottsel_stub_next * OTTSEL_STUB_SLOT;
