+static void ottsel_exec_fault_healer(int sig, siginfo_t* info, void* ucontext_v) {
+  auto* uc = (ucontext_t*)ucontext_v;
+  uint64_t pc = (uint64_t)uc->uc_mcontext->__ss.__pc;
+  uint64_t addr = (uint64_t)info->si_addr;
+  uint64_t base = (uint64_t)g_ee_main_mem;
+  constexpr uint64_t kEeSize = 128ull * (1 << 20);
+  if (g_ee_main_mem && addr == pc && addr >= base && addr < base + kEeSize) {
+    uintptr_t page = addr & ~(s_ottsel_page_size - 1);
+    if (mprotect((void*)page, s_ottsel_page_size, PROT_READ | PROT_EXEC) == 0) {
+      sys_icache_invalidate((void*)page, s_ottsel_page_size);
+      g_ottsel_exec_heals.fetch_add(1, std::memory_order_relaxed);
+      return;  // retry the faulting instruction
+    }
+  }
+  // genuine fault: dump ground truth, restore the previous handler and re-raise
+  g_ottsel_crash_si_addr = addr;
+  ottsel_crash_dump(sig, uc);
+  sigaction(SIGBUS, &s_ottsel_old_bus, nullptr);
+  sigaction(SIGSEGV, &s_ottsel_old_segv, nullptr);
+  raise(sig);
+}
+
+static void ottsel_sigill_hook(int sig, siginfo_t* /*info*/, void* ucontext_v) {
+  // the healed bad call lands here: page flipped RX but the bytes are data.
+  ottsel_crash_dump(sig, (ucontext_t*)ucontext_v);
+  sigaction(SIGILL, &s_ottsel_old_ill, nullptr);
+  raise(sig);
+}
+
+void ottsel_install_exec_fault_healer() {
+  s_ottsel_page_size = (uintptr_t)sysconf(_SC_PAGESIZE);
+  struct sigaction sa;
+  memset(&sa, 0, sizeof(sa));
+  sa.sa_sigaction = ottsel_exec_fault_healer;
+  sa.sa_flags = SA_SIGINFO;
+  sigemptyset(&sa.sa_mask);
+  sigaction(SIGBUS, &sa, &s_ottsel_old_bus);
+  sigaction(SIGSEGV, &sa, &s_ottsel_old_segv);
+  struct sigaction sa_ill;
+  memset(&sa_ill, 0, sizeof(sa_ill));
+  sa_ill.sa_sigaction = ottsel_sigill_hook;
+  sa_ill.sa_flags = SA_SIGINFO;
+  sigemptyset(&sa_ill.sa_mask);
+  sigaction(SIGILL, &sa_ill, &s_ottsel_old_ill);
+  lg::info("OTTSEL no-emit: exec-fault healer installed (+SIGILL crash dump)");
+}
