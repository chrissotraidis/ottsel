@@ -47,114 +54,112 @@ _arg_call_arm64:
 _stack_call_arm64:
   stp	x29, x30, [sp, #-16]!
   mov	x29, sp
-  ldr x8, [sp], #16
+  ;; the caller stub pushed the C target at [sp]; after the stp it sits at [sp, #16]
+  ldr x8, [sp, #16]
 
