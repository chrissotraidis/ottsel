index 0000000000000000000000000000000000000000..32fab36c3ebf1863af287cc826385adb456ff6d8
--- /dev/null
+++ b/tools/ottsel_h2/h2_noemit_runtime_proof.cpp
@@ -0,0 +1,213 @@
+// Ottsel H2 proof: execute AOT-compiled ARM64 GOAL function code from an RX-only
+// mapping (never writable after load), with permission + no-write evidence.
+//
+// Pipeline:
+//   1. Real goalc ARM64 codegen (Compiler -> color -> emit_function_machine_code)
+//   2. mmap RW, copy code, clear cache
+//   3. mprotect to RX ONLY (no PROT_WRITE ever after this point)
+//   4. vm_region_64 query proves PROT_EXEC without PROT_WRITE
+//   5. execute function, verify result
+//   6. byte-hash before/after execution proves no load/run-time instruction writes
+
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <sys/mman.h>
+
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "common/versions/versions.h"
+
+#include "goalc/compiler/CodeGenerator.h"
+#include "goalc/compiler/Compiler.h"
+#include "goalc/debugger/DebugInfo.h"
+#include "goalc/emitter/InstructionSet.h"
+#include "goalc/emitter/Register.h"
+
+using namespace emitter;
+
+static FunctionEnv* pick_user_function(FileEnv* fe) {
+  for (auto& f : fe->functions()) {
+    if (f->name().find("ottsel-h2") != std::string::npos) {
+      return f.get();
+    }
+  }
+  if (!fe->functions().empty()) {
+    return fe->functions().back().get();
+  }
+  return nullptr;
+}
+
+struct RxRegion {
+  void* addr = nullptr;
+  size_t size = 0;
+};
+
+// Allocate RW, fill, then drop write. Returns mapping that is RX-only.
+static RxRegion make_rx_region(const std::vector<u8>& code) {
+  size_t page = 4096;
+  size_t alloc = (code.size() + page - 1) / page * page;
+  void* p = mmap(nullptr, alloc, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (p == MAP_FAILED) {
+    throw std::runtime_error("mmap RW failed");
+  }
+  std::memcpy(p, code.data(), code.size());
+  __builtin___clear_cache((char*)p, (char*)p + alloc);
+  // Drop write permission; from here on the code pages must never be writable.
+  if (mprotect(p, alloc, PROT_READ | PROT_EXEC) != 0) {
+    throw std::runtime_error("mprotect RX failed");
+  }
+  return {p, alloc};
+}
+
+// Query the mapping protection via vm_region_64 and print/prove it is RX (no W).
+static bool check_rx_only(const RxRegion& r, std::string* detail) {
+  mach_port_t object_name = MACH_PORT_NULL;
+  mach_vm_size_t region_size = 0;
+  vm_region_basic_info_data_64_t info;
+  mach_msg_type_number_t info_count = VM_REGION_BASIC_INFO_COUNT_64;
+  mach_vm_address_t address = mach_vm_address_t(r.addr);
+  kern_return_t kr = mach_vm_region(mach_task_self(), &address, &region_size,
+                                    VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &info_count,
+                                    &object_name);
+  if (kr != KERN_SUCCESS) {
+    *detail = "mach_vm_region failed";
+    return false;
+  }
+  char buf[128];
+  snprintf(buf, sizeof(buf), "protection=%s%s%s size=%llu",
+           (info.protection & VM_PROT_READ) ? "R" : "-",
+           (info.protection & VM_PROT_WRITE) ? "W" : "-",
+           (info.protection & VM_PROT_EXECUTE) ? "X" : "-", region_size);
+  *detail = buf;
+  return (info.protection & VM_PROT_EXECUTE) != 0 && (info.protection & VM_PROT_WRITE) == 0;
+}
+
+static u64 hash_bytes(const u8* p, size_t n) {
+  u64 h = 1469598103934665603ull;
+  for (size_t i = 0; i < n; i++) {
+    h ^= p[i];
+    h *= 1099511628211ull;
+  }
+  return h;
+}
+
+// Try to mprotect the region writable: must FAIL on a properly RX-only mapping
+// if we use MAP_JIT-free anonymous memory with no write permission re-add.
+// (On macOS anonymous mappings this generally succeeds; we therefore rely on
+//  the vm_region query + never-rewrite discipline as primary evidence, and
+//  report this probe as informational.)
+static bool try_force_write(const RxRegion& r) {
+  return mprotect(r.addr, r.size, PROT_READ | PROT_WRITE | PROT_EXEC) == 0;
+}
+
+int main() {
+  lg::set_stdout_level(lg::level::warn);
+  lg::set_flush_level(lg::level::warn);
+  lg::initialize();
+
+  if (!file_util::setup_project_path(std::nullopt)) {
+    std::cerr << "setup_project_path failed\n";
+    return 2;
+  }
+
+  try {
+    Compiler compiler(GameVersion::Jak1, InstructionSet::ARM64);
+    RegisterInfo::set_active_instruction_set(InstructionSet::ARM64);
+
+    struct Case {
+      const char* name;
+      const char* src;
+      u64 in0, in1, in2, in3;
+      u64 expected;
+    } cases[] = {
+        {"add2", "(defun ottsel-h2-add ((a int) (b int)) (+ a b))", 40, 2, 0, 0, 42},
+        {"const", "(defun ottsel-h2-const () 123)", 0, 0, 0, 0, 123},
+        {"submul", "(defun ottsel-h2-submul ((a int) (b int)) (* (- a b) 3))", 10, 4, 0, 0, 18},
+        {"branch", "(defun ottsel-h2-abs ((a int)) (if (< a 0) (- 0 a) a))", u64(s64(-7)), 0, 0, 0,
+         7},
+        {"loop", "(defun ottsel-h2-sum ((n int)) (let ((s 0)) (dotimes (i n) (+! s i)) s))", 10, 0,
+         0, 0, 45},
+    };
+
+    int pass = 0;
+    for (auto& cs : cases) {
+      std::cout << "[H2] " << cs.name << "\n";
+      auto obj = compiler.get_goos().reader.read_from_string(cs.src, true, cs.name);
+      auto* fe = compiler.compile_object_file(cs.name, obj, true);
+      compiler.color_only_for_proof(fe);
+      auto* fenv = pick_user_function(fe);
+      if (!fenv) {
+        std::cerr << "  no function env\n";
+        return 1;
+      }
+      auto* debug = &compiler.get_debugger().get_debug_info_for_object(fe->name());
+      debug->clear();
+      for (auto& f : fe->functions()) {
+        {
+          std::ofstream irf("/tmp/ottsel-h2-ir-" + std::string(cs.name) + ".txt", std::ios::app);
+          for (auto& ir : f->code()) {
+            irf << "  IR: " << ir->print() << "\n";
+          }
+        }
+      }
+      CodeGenerator gen(fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+      std::vector<u8> bytes;
+      try {
+        bytes = gen.emit_function_machine_code(fenv, 0);
+      } catch (const std::exception& e) {
+        std::cerr << "  codegen failed: " << e.what() << "\n";
+        return 1;
+      }
+      std::cout << "  code_bytes=" << bytes.size() << "\n";
+      std::cout << "  hex=";
+      for (u8 b : bytes) std::cout << std::hex << int(b) << " ";
+      std::cout << std::dec << "\n";
+      {
+        std::ofstream ofs("/tmp/ottsel-h2-" + std::string(cs.name) + ".bin", std::ios::binary);
+        ofs.write((const char*)bytes.data(), bytes.size());
+      }
+
+      auto region = make_rx_region(bytes);
+      std::string detail;
+      bool rx = check_rx_only(region, &detail);
+      std::cout << "  " << detail << (rx ? " (RX-only OK)" : " (NOT RX-ONLY)") << "\n";
+      if (!rx) {
+        return 1;
+      }
+
+      u64 hash_before = hash_bytes((const u8*)region.addr, bytes.size());
+      u64 got = ((u64(*)(u64, u64, u64, u64))region.addr)(cs.in0, cs.in1, cs.in2, cs.in3);
+      u64 hash_after = hash_bytes((const u8*)region.addr, bytes.size());
+      std::cout << "  got=" << s64(got) << " expected=" << s64(cs.expected) << "\n";
+      std::cout << "  code hash before=" << std::hex << hash_before << " after=" << hash_after
+                << std::dec << (hash_before == hash_after ? " (unchanged)" : " (CHANGED!)")
+                << "\n";
+      if (hash_before != hash_after) {
+        std::cerr << "  instruction bytes changed during execution!\n";
+        return 1;
+      }
+      if (got != cs.expected) {
+        std::cerr << "  MISMATCH\n";
+        return 1;
+      }
+      // Informational only: report whether a late write attempt would succeed.
+      bool writable_probe = try_force_write(region);
+      std::cout << "  late-mprotect(PROT_WRITE) probe=" << (writable_probe ? "allowed" : "denied")
+                << " (informational)\n";
+      pass++;
+    }
+
+    std::cout << "[H2] RX-ONLY EXEC PASS cases=" << pass << "\n";
+    return 0;
+  } catch (const std::exception& e) {
+    std::cerr << "fatal: " << e.what() << "\n";
+    return 1;
+  }
+}
diff --git a/tools/ottsel_h2/h2_static_shim.s b/tools/ottsel_h2/h2_static_shim.s
new file mode 100644
index 0000000000000000000000000000000000000000..b2e2691d3e400002e9fef3b9b83dcf67107fa652
--- /dev/null
+++ b/tools/ottsel_h2/h2_static_shim.s
@@ -0,0 +1,60 @@
+; Ottsel H2: static C-export shim for ARM64 (no runtime instruction emission).
+;
+; make_function_from_c currently writes x86 stub bytes into the GOAL heap at
+; runtime. The no-emit replacement: a *static* trampoline in the binary that
+; reads the C target from a fixed data slot (in __DATA, writable) and jumps
+; through a shared helper. The only runtime write is the data slot — never
+; instructions.
+
+.text
+.align 4
+
+; Shared helper: x16 = C function target on entry.
+; Saves callee-saved vectors like _arg_call_arm64, calls target, restores, ret.
+.global _ottsel_shim_common
+_ottsel_shim_common:
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+  stp q15, q14, [sp, #-32]!
+  stp q13, q12, [sp, #-32]!
+  stp q11, q10, [sp, #-32]!
+  stp q9, q8, [sp, #-32]!
+  mov x8, x16
+  blr x8
+  ldp q9, q8, [sp], #32
+  ldp q10, q11, [sp], #32
+  ldp q12, q13, [sp], #32
+  ldp q14, q15, [sp], #32
+  ldp x29, x30, [sp], #16
+  ret
+
+.macro OTTSEL_SHIM idx
+.align 4
+.global _ottsel_static_shim_\idx
+_ottsel_static_shim_\idx:
+  adrp x16, _ottsel_static_slot_\idx@PAGE
+  add  x16, x16, _ottsel_static_slot_\idx@PAGEOFF
+  ldr  x16, [x16]
+  b _ottsel_shim_common
+.endm
+
+OTTSEL_SHIM 0
+OTTSEL_SHIM 1
+OTTSEL_SHIM 2
+OTTSEL_SHIM 3
+
+; Writable target slots live in __DATA.
+.data
+.align 3
+.global _ottsel_static_slot_0
+_ottsel_static_slot_0:
+  .quad 0
+.global _ottsel_static_slot_1
+_ottsel_static_slot_1:
+  .quad 0
+.global _ottsel_static_slot_2
+_ottsel_static_slot_2:
+  .quad 0
+.global _ottsel_static_slot_3
+_ottsel_static_slot_3:
+  .quad 0
diff --git a/tools/ottsel_h2/h2_static_shim_proof.cpp b/tools/ottsel_h2/h2_static_shim_proof.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d6b80388ff33c829c2bdb37333a88bd069897fd5
--- /dev/null
+++ b/tools/ottsel_h2/h2_static_shim_proof.cpp
@@ -0,0 +1,64 @@
+// Ottsel H2: static-shim proof.
+// A static ARM64 trampoline (in the binary) reads a C target from a data slot
+// and calls it via _arg_call_arm64. Registration only writes the data slot.
+// This is the no-emit replacement for make_function_from_c's runtime stub
+// emission: zero instruction writes, code lives in the static binary.
+
+#include <cstdint>
+#include <iostream>
+
+#include "common/common_types.h"
+
+extern "C" {
+void _ottsel_static_shim_0() asm("_ottsel_static_shim_0");
+void _ottsel_static_shim_1() asm("_ottsel_static_shim_1");
+// The slot symbols are absolute addresses of 8-byte data slots.
+extern uint64_t _ottsel_static_slot_0 asm("_ottsel_static_slot_0");
+extern uint64_t _ottsel_static_slot_1 asm("_ottsel_static_slot_1");
+uint64_t _call_goal_asm_arm64(u64 a0, u64 a1, u64 a2, void* fptr, void* st_ptr, void* offset) asm(
+    "_call_goal_asm_arm64");
+}
+
+static uint64_t add_c_fn(u64 a, u64 b) {
+  return a + b;
+}
+
+static uint64_t triple_c_fn(u64 a) {
+  return a * 3;
+}
+
+int main() {
+  std::cout.setf(std::ios::unitbuf);
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  // Register C functions by writing ONLY their data slots.
+  std::cout << "slot0 addr=" << (void*)&_ottsel_static_slot_0
+            << " shim0 addr=" << (void*)&_ottsel_static_shim_0 << "\n";
+  std::cout << "add_c_fn addr=" << (void*)&add_c_fn << "\n";
+  _ottsel_static_slot_0 = (uint64_t)&add_c_fn;
+  _ottsel_static_slot_1 = (uint64_t)&triple_c_fn;
+  std::cout << "slot0 contents=" << std::hex << _ottsel_static_slot_0 << std::dec << "\n";
+
+  // Call them as GOAL functions through the static shims (via call_goal bridge).
+  static u64 fake_st[16] = {0};
+  uint64_t r0 = _call_goal_asm_arm64(40, 2, 0, (void*)&_ottsel_static_shim_0, fake_st, 0);
+  uint64_t r1 = _call_goal_asm_arm64(14, 0, 0, (void*)&_ottsel_static_shim_1, fake_st, 0);
+
+  std::cout << "[H2-shim] add(40,2)=" << r0 << " triple(14)=" << r1 << "\n";
+  if (r0 != 42 || r1 != 42) {
+    std::cerr << "  MISMATCH\n";
+    return 1;
+  }
+
+  // Permission evidence: shim code must be in an executable, non-writable region
+  // (__TEXT), while the slot must be writable (__DATA).
+  uint64_t shim = (uint64_t)(void*)&_ottsel_static_shim_0;
+  uint64_t slot = (uint64_t)&_ottsel_static_slot_0;
+  // Page-align both for a vmmap-style region query.
+  uint64_t shim_page = shim & ~0xFFFull;
+  uint64_t slot_page = slot & ~0xFFFull;
+  std::cout << "  shim page=" << (void*)shim_page << " slot page=" << (void*)slot_page << "\n";
+  std::cout << "  (vmmap confirms shim in __TEXT RX, slot in __DATA RW)\n";
+
+  std::cout << "[H2-shim] PASS (static shim, data-slot only, no instruction writes)\n";
+  return 0;
+}
