+    return false;
+  }
+  vag_probe_shared_sample = sample;
+  vag_probe_voice = std::make_shared<snd::Voice>(snd::Voice::AllocationType::Permanent);
+  vag_probe_voice->SetSample(sample->data());
+  vag_probe_voice->SetSampleLength(sample_words);
+  vag_probe_voice->SetPitch(0x1000);
