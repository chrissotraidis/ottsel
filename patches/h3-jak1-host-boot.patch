-  stp x5, x4, [sp, #-16]!
-  stp x3, x2, [sp, #-16]!
-  stp x1, x0, [sp, #-16]!
+  ; create stack array of arguments, in order: array[0..7] = x0..x7.
+  ; (STP stores the first listed register at [base] and the second at
+  ; [base+8], so pair them (even, odd) to keep the array order right.)
