+// Keep the raw texture capture next to the bounded Sprite3 trace.  PPM is
+// intentionally dependency-free and can be inspected without involving the
+// game's texture converter a second time.
+void dump_trace_texture(u32 trace_frame, u32 tbp, GLuint texture) {
+  if (trace_frame != 1 || tbp == 0) {
+    return;
+  }
+
+  GLint width = 0;
+  GLint height = 0;
+  glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &width);
+  glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &height);
+  if (width <= 0 || height <= 0 || width > 4096 || height > 4096) {
+    lg::warn("OTTSEL SPRITE3 TEXDUMP: tbp={} gltex={} rejected dimensions {}x{}", tbp, texture,
+             width, height);
+    return;
+  }
+
+  std::vector<u8> pixels((size_t)width * (size_t)height * 4);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+  const auto path = fmt::format("/tmp/ottsel-sprite3-tbp-{}.ppm", tbp);
+  const auto alpha_path = fmt::format("/tmp/ottsel-sprite3-tbp-{}-alpha.pgm", tbp);
+  u8 alpha_min = 255;
+  u8 alpha_max = 0;
+  size_t transparent_pixels = 0;
+  size_t opaque_pixels = 0;
+  for (size_t offset = 3; offset < pixels.size(); offset += 4) {
+    const u8 alpha = pixels[offset];
+    alpha_min = std::min(alpha_min, alpha);
+    alpha_max = std::max(alpha_max, alpha);
+    transparent_pixels += alpha == 0;
+    opaque_pixels += alpha == 255;
+  }
+  const u64 rgba_hash = ottsel_sprite_trace_hash(pixels.data(), pixels.size());
+  if (auto* output = std::fopen(path.c_str(), "wb")) {
+    std::fprintf(output, "P6\n%d %d\n255\n", width, height);
+    for (size_t offset = 0; offset < pixels.size(); offset += 4) {
+      std::fwrite(pixels.data() + offset, 1, 3, output);
+    }
+    std::fclose(output);
+    if (auto* alpha_output = std::fopen(alpha_path.c_str(), "wb")) {
+      std::fprintf(alpha_output, "P5\n%d %d\n255\n", width, height);
+      for (size_t offset = 3; offset < pixels.size(); offset += 4) {
+        std::fwrite(pixels.data() + offset, 1, 1, alpha_output);
+      }
+      std::fclose(alpha_output);
+    }
+    lg::info("OTTSEL SPRITE3 TEXDUMP: tbp={} gltex={} {}x{} rgba-hash=0x{:x} "
+             "alpha=[{},{}] zero={} full={} -> {}, {}",
+             tbp, texture, width, height, rgba_hash, alpha_min, alpha_max, transparent_pixels,
+             opaque_pixels, path, alpha_path);
+  } else {
+    lg::warn("OTTSEL SPRITE3 TEXDUMP: failed to open {}", path);
+  }
+}
