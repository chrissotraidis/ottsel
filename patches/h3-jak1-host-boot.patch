 void snd_StopSoundSystem() {
+  std::scoped_lock lock(player_lifecycle_mutex);
   if (player) {
     player.reset();
   }
+  audio_callback_logged = false;
+  audio_peak_log_count = 0;
+  audio_output_paused = false;
+}
+
+void snd_PumpAudioInit() {
+  std::scoped_lock lock(player_lifecycle_mutex);
+  if (!player) {
+    return;
+  }
+
+  player->InitOutput();
+  if (!audio_callback_logged && player->AudioCallbackFrames() > 0) {
+    audio_callback_logged = true;
+    lg::info("OTTSEL AUDIO: output callback observed after {} frames", player->AudioCallbackFrames());
+  }
+  const u32 peak_windows = player->AudioPeakWindowCount();
+  if (peak_windows != audio_peak_log_count &&
+      (peak_windows == 1 || peak_windows % 10 == 0)) {
+    audio_peak_log_count = peak_windows;
+    lg::info("OTTSEL AUDIO: mixed 48000 frames (window {}), pcm-peak={}", peak_windows,
+             player->AudioLastPeak());
+  }
+}
+
+void snd_PauseAudioOutput() {
+  std::scoped_lock lock(player_lifecycle_mutex);
+  if (player && !audio_output_paused) {
+    player->PauseOutput();
+    audio_output_paused = true;
+  }
+}
+
+void snd_ResumeAudioOutput() {
+  std::scoped_lock lock(player_lifecycle_mutex);
+  if (player && audio_output_paused) {
+    player->ResumeOutput();
+    audio_output_paused = false;
+  }
+}
+
+bool snd_StartVAGProbe(const u8* adpcm_data, u32 byte_length, u32 sample_rate) {
+  std::scoped_lock lock(player_lifecycle_mutex);
+  if (!player || !adpcm_data || byte_length < 16 || (byte_length & 1) != 0 || sample_rate == 0) {
+    return false;
+  }
+  vag_probe_sample.resize(byte_length / sizeof(u16));
+  memcpy(vag_probe_sample.data(), adpcm_data, byte_length);
+  // The diagnostic buffer is finite. Mark its final ADPCM block as a
+  // non-looping end block so Voice never walks beyond retained chunks.
+  if (vag_probe_sample.size() >= 8) {
+    vag_probe_sample[vag_probe_sample.size() - 8] |= 0x0100;
+  }
+  vag_probe_voice = std::make_shared<snd::Voice>(snd::Voice::AllocationType::Permanent);
+  vag_probe_voice->SetSample(vag_probe_sample.data());
+  vag_probe_voice->SetSampleLength((u32)vag_probe_sample.size());
+  vag_probe_voice->SetPitch(0x1000);
+  vag_probe_voice->SetAsdr1(0x000f);
+  vag_probe_voice->SetAsdr2(0x1fc0);
+  vag_probe_voice->SetVolume(0x3fff, 0x3fff);
+  vag_probe_voice->KeyOn();
+  player->SubmitVoice(vag_probe_voice);
+  lg::info("OTTSEL AUDIO: VAG diagnostic voice started bytes={} sample-rate={}", byte_length,
+           sample_rate);
+  return true;
+}
+
+bool snd_StartVAGProbeShared(const std::shared_ptr<std::vector<u16>>& sample,
