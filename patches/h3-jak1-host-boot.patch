+// return the canonical on-disk path (exact case) when a case-insensitive
+// match exists.
+static fs::path ottsel_resolve_data_file(const fs::path& root,
+                                         const fs::path& subdir,
+                                         const std::string& requested) {
+  fs::path dir = root / subdir;
+  fs::path direct = dir / requested;
+  if (fs::exists(direct)) {
+    return direct;
+  }
+  std::error_code ec;
+  for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+    std::string entry = it->path().filename().string();
