+void ObjectGenerator::patch_arm64_static_ref(int seg,
+                                             const InstructionRecord& instr,
+                                             int target_offset_in_seg) {
+  // Patch an ADR (static_addr) or ADRP+LDR-literal pc-relative field so the
+  // final image is self-contained (no runtime instruction writes).
+  // Layout: instruction's byte offset in segment and the target are both known.
+  auto& data = m_data_by_seg.at(seg);
+  const auto& function = m_function_data_by_seg.at(instr.seg).at(instr.func_id);
+  const auto& arm_inst = function.instructions.at(instr.instr_id);
+  int patch_location = function.instruction_to_byte_in_data.at(instr.instr_id) +
+                       arm_inst.offset_of_imm();
+  int source_pc = function.instruction_to_byte_in_data.at(instr.instr_id);
+  s64 delta = s64(target_offset_in_seg) - s64(source_pc);
+  ASSERT(patch_location >= 0 && patch_location + 4 <= int(data.size()));
+  u32 word = 0;
+  std::memcpy(&word, data.data() + patch_location, 4);
+  if ((word & 0x9F000000) == 0x10000000) {
+    // ADR: immlo = bits 30-29, immhi = bits 23-5, imm = sign-extended 21-bit byte offset
+    s64 imm = delta;
+    ASSERT(imm >= -(1 << 20) && imm < (1 << 20));
+    u32 immlo = (u32(imm) >> 2) & 0x3;
+    u32 immhi = (u32(imm) >> 4) & 0x7FFFF;
+    word = (word & 0x9F00001F) | (immlo << 29) | (immhi << 5);
+  } else if ((word & 0x9F000000) == 0x90000000) {
+    // ADRP: imm = page_delta (target_page - pc_page) in 4096 units.
+    // PC-relative delta computed from the instruction itself (word0).
+    // NOTE: the ADRP+ADD pair computes page(pc) + (page_delta << 12) + lo12,
+    // so page_delta must come from the page addresses and lo12 from the
+    // target's low 12 bits.  Using the raw byte distance for both is only
+    // correct when the ADRP is page-aligned; otherwise the result lands
+    // (pc & 0xFFF) bytes short of the target.  Segment bases are page-aligned
+    // in the final image, so segment-relative page arithmetic is equivalent.
+    int64_t page_delta = (target_offset_in_seg >> 12) - (source_pc >> 12);
+    ASSERT(page_delta >= -(1 << 20) && page_delta < (1 << 20));
+    uint32_t immlo = (uint32_t(page_delta) >> 0) & 0x3;
+    uint32_t immhi = (uint32_t(page_delta) >> 2) & 0x7FFFF;
+    word = (word & 0x9F00001F) | (immlo << 29) | (immhi << 5);
