+u32 ottsel_stub_alloc(u32 size) {
+  u32 base = ottsel_stub_arena_base();
+  u32 off = base + g_ottsel_stub_next * OTTSEL_STUB_SLOT;
+  ASSERT_MSG(size <= OTTSEL_STUB_SLOT, "stub too large for arena slot");
+  ASSERT_MSG(off + size <= base + OTTSEL_STUB_ARENA_SIZE, "stub arena exhausted");
+  g_ottsel_stub_next++;
+  g_ottsel_stub_last_off = off;
+  // Re-open the slot's page(s) for writing (they may already be sealed RX
+  // from a previous stub on the same page).
+  const uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);
+  uintptr_t lo = (uintptr_t)(::g_ee_main_mem + off) & ~(page - 1);
+  uintptr_t hi = ((uintptr_t)(::g_ee_main_mem + off + OTTSEL_STUB_SLOT) + page - 1) & ~(page - 1);
+  for (uintptr_t addr = lo; addr < hi; addr += page) {
+    mprotect((void*)addr, page, PROT_READ | PROT_WRITE);
+  }
+  return off;
+}
+
+void ottsel_stub_seal_last() {
+  const uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);
+  u32 off = g_ottsel_stub_last_off;
+  uintptr_t lo = (uintptr_t)(::g_ee_main_mem + off) & ~(page - 1);
+  uintptr_t hi = ((uintptr_t)(::g_ee_main_mem + off + OTTSEL_STUB_SLOT) + page - 1) & ~(page - 1);
+  for (uintptr_t addr = lo; addr < hi; addr += page) {
+    if (mprotect((void*)addr, page, PROT_READ | PROT_EXEC) != 0) {
+      lg::debug("OTTSEL no-emit: stub seal @ 0x{:x} failed: {}", addr, strerror(errno));
+    }
+  }
