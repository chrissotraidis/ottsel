+  //   xmmN -> vN
+  if (m_instr_set == emitter::InstructionSet::ARM64) {
+    auto find_arm = [&](const char* x86, int arm_reg) -> bool {
+      if (name == x86) {
+        return true;
+      }
+      return false;
+    };
+    // direct name -> ARM64 register id map for the kernel asm surface.
+    struct ArmName {
+      const char* name;
+      int reg;
+    };
+    static const ArmName arm_names[] = {
+        {"rax", emitter::X0},     {"rbx", emitter::X19},   {"rbp", emitter::X29},
+        {"rsp", emitter::SP},     {"rsi", emitter::X1},    {"rdi", emitter::X0},
+        {"rcx", emitter::X3},     {"rdx", emitter::X2},    {"r8", emitter::X4},
+        {"r9", emitter::X5},      {"r10", emitter::X23},   {"r11", emitter::X24},
+        {"r12", emitter::X25},    {"r13", emitter::X20},   {"r14", emitter::X21},
+        {"r15", emitter::X22},    {"xmm0", emitter::V0},   {"xmm1", emitter::V1},
+        {"xmm2", emitter::V2},    {"xmm3", emitter::V3},   {"xmm4", emitter::V4},
+        {"xmm5", emitter::V5},    {"xmm6", emitter::V6},   {"xmm7", emitter::V7},
+        {"xmm8", emitter::V8},    {"xmm9", emitter::V9},   {"xmm10", emitter::V10},
+        {"xmm11", emitter::V11},  {"xmm12", emitter::V12}, {"xmm13", emitter::V13},
+        {"xmm14", emitter::V14},  {"xmm15", emitter::V15},
+    };
+    for (auto& entry : arm_names) {
+      if (name == entry.name) {
+        return emitter::Register(entry.reg);
+      }
+    }
+    // allow direct ARM64 names too
+    for (int i = 0; i < 31; i++) {
+      std::string xn = fmt::format("x{}", i);
+      if (name == xn) {
+        return emitter::Register(i);
