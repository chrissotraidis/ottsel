diff --git a/test/test_sprite3_native.cpp b/test/test_sprite3_native.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3c01b8a3e6cf0d0748f2cd68fa38681cb264427a
--- /dev/null
+++ b/test/test_sprite3_native.cpp
@@ -0,0 +1,172 @@
+#include "common/dma/ottsel_sprite_math.h"
+#include "common/dma/ottsel_data_root.h"
+#include "common/dma/dma_chain_read.h"
+#include "common/dma/ottsel_sprite_phase.h"
+#include "common/dma/ottsel_dgo_alias.h"
+
+#include "gtest/gtest.h"
+
+namespace {
+
+u64 make_dma_tag(DmaTag::Kind kind, u32 addr, u16 qwc = 0) {
+  return (u64(addr & 0x7fffffff) << 32) | (u64(kind) << 28) | qwc;
+}
+
+template <size_t Size>
+void put_u64(std::array<u8, Size>& memory, u32 offset, u64 value) {
+  memcpy(memory.data() + offset, &value, sizeof(value));
+}
+
+}  // namespace
+
+TEST(Sprite3Native, Jak1BucketTableEntryReturnsToNextTableBoundary) {
+  std::array<u8, 0x800> memory{};
+  constexpr u32 table = 0x100;
+  constexpr u32 bucket66 = table + 66 * 16;
+  constexpr u32 bucket67 = table + 67 * 16;
+  constexpr u32 sprite_data = 0x400;
+
+  put_u64(memory, bucket66, make_dma_tag(DmaTag::Kind::NEXT, sprite_data));
+  put_u64(memory, sprite_data, make_dma_tag(DmaTag::Kind::NEXT, bucket67));
+
+  DmaFollower desktop_style(memory.data(), bucket66);
+  EXPECT_EQ(bucket66, desktop_style.current_tag_offset());
+  EXPECT_EQ(0u, desktop_style.read_and_advance().size_bytes);
+  EXPECT_EQ(sprite_data, desktop_style.current_tag_offset());
+  EXPECT_EQ(0u, desktop_style.read_and_advance().size_bytes);
+  EXPECT_EQ(bucket67, desktop_style.current_tag_offset());
+
+  DmaFollower mobile_data_style(memory.data(), sprite_data);
+  EXPECT_EQ(0u, mobile_data_style.read_and_advance().size_bytes);
+  EXPECT_EQ(bucket67, mobile_data_style.current_tag_offset());
+}
+
+TEST(Sprite3Native, ClassifiesJak1SpriteProgramOwnership) {
+  EXPECT_EQ(ottsel::Jak1SpritePhase::World2D, ottsel::classify_jak1_sprite_mscal(3));
+  EXPECT_EQ(ottsel::Jak1SpritePhase::Hud2D, ottsel::classify_jak1_sprite_mscal(109));
+  EXPECT_EQ(ottsel::Jak1SpritePhase::ThreeD, ottsel::classify_jak1_sprite_mscal(211));
+  EXPECT_EQ(ottsel::Jak1SpritePhase::Other, ottsel::classify_jak1_sprite_mscal(46));
+}
+
+TEST(Sprite3Native, RequiresCapturedJak1PostTransitionPhaseCoverage) {
+  EXPECT_FALSE(ottsel::has_jak1_post_transition_coverage(8, 0, 2));
+  EXPECT_TRUE(ottsel::has_jak1_post_transition_coverage(51, 3, 2));
+}
+
+TEST(Sprite3Native, RequiresOrderedJak1PostTransitionPhaseCoverage) {
+  const ottsel::Jak1SpritePhase mobile_phases[] = {
+      ottsel::Jak1SpritePhase::ThreeD,
+      ottsel::Jak1SpritePhase::ThreeD,
+      ottsel::Jak1SpritePhase::World2D,
+      ottsel::Jak1SpritePhase::World2D,
+  };
+  const u32 mobile_counts[] = {48, 16, 48, 48};
+  EXPECT_FALSE(ottsel::has_ordered_jak1_post_transition_coverage(
+      mobile_phases, mobile_counts, std::size(mobile_phases)));
+
+  const ottsel::Jak1SpritePhase desktop_phases[] = {
+      ottsel::Jak1SpritePhase::ThreeD,
+      ottsel::Jak1SpritePhase::ThreeD,
+      ottsel::Jak1SpritePhase::World2D,
+      ottsel::Jak1SpritePhase::World2D,
+      ottsel::Jak1SpritePhase::Hud2D,
+      ottsel::Jak1SpritePhase::Hud2D,
+      ottsel::Jak1SpritePhase::Hud2D,
+  };
+  const u32 desktop_counts[] = {48, 16, 48, 51, 48, 48, 48};
+  EXPECT_TRUE(ottsel::has_ordered_jak1_post_transition_coverage(
+      desktop_phases, desktop_counts, std::size(desktop_phases)));
+}
+
+TEST(Sprite3Native, MatchesBucket67WorldTupleFixture) {
+  EXPECT_TRUE(ottsel::matches_bucket67_world_fixture(ottsel::Jak1SpritePhase::World2D, 48,
+                                                     0x2c8d, 19, 5, 5));
+  EXPECT_FALSE(ottsel::matches_bucket67_world_fixture(ottsel::Jak1SpritePhase::Hud2D, 48,
+                                                      0x2c8d, 19, 5, 5));
+  EXPECT_FALSE(ottsel::matches_bucket67_world_fixture(ottsel::Jak1SpritePhase::World2D, 32,
+                                                      0x2c8d, 19, 5, 5));
+}
+
+TEST(Sprite3Native, RecognizesCapturedTccZeroColorOnlyAdGif) {
+  EXPECT_FALSE(ottsel::sprite3_uses_texture(0x0000000000000000ull));
+  EXPECT_TRUE(ottsel::sprite3_uses_texture(0x2005a0455530ac8dull));
+}
+
