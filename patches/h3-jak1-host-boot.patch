+  ;; Ottsel H3: the caller stub pushed the C target at [sp] before jumping here;
+  ;; after the stp above it sits at [sp, #16]. (Previously this read the saved
+  ;; x29 from [sp] and post-incremented, which called the wrong address.)
+  ldr x8, [sp, #16]
 
