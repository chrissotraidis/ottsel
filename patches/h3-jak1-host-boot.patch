+void ottsel_stub_flip_pages_rx(u32 ee_base, u32 used) {
+  if (!used) {
+    return;
+  }
+  const uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);  // 16KB on Apple Silicon
+  uintptr_t lo = (uintptr_t)(::g_ee_main_mem + ee_base) & ~(page - 1);
+  uintptr_t hi = ((uintptr_t)(::g_ee_main_mem + ee_base + used) + page - 1) & ~(page - 1);
