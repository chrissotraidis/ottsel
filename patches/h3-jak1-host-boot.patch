+  EXPECT_FALSE(shadow_vif_v4_32_payload_fits(4, 48));
+  EXPECT_FALSE(shadow_vif_v4_32_payload_fits(UINT32_MAX, 0));
+}
+
+TEST(ShadowRenderer, RejectsVertexWriteAtCapacityBoundary) {
