diff --git a/game/ottsel_cgolink_dump.cpp b/game/ottsel_cgolink_dump.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d54973dbffbd01f350aa7183fd19d90e9c477107
--- /dev/null
+++ b/game/ottsel_cgolink_dump.cpp
@@ -0,0 +1,279 @@
+// Ottsel S2.1 debug (TEMPORARY): host-side replica of the Simulator's
+// no-emit KERNEL.CGO + GAME.CGO link, then dump the linked code at fixed
+// EE offsets.  The Simulator fault trace (s21-cf-boot.log) shows:
+//   - call site 0x1c6014 calls the alloc_heap_object C-export stub
+//     0x4f00afc, and pp (x20) equals the stub's own address at stub entry
+//     (kmalloc: "!alloc mem ... #<process @ #x4f00afc>").
+//   - a blr x16 at run-function-in-process+0x1d8 (continuation 0x1f2850)
+//     faults with x16 = ee + 0x24783b (pp).
+// This tool links the same CGOs with the same runtime linker so we can
+// disassemble the actual code at those sites.
+//
+// Sequence mirrors src/shell/ios_boot.cpp's ottsel_ios_run_boot:
+//   mmap EE -> init globals -> InitHeapAndSymbol (kernel load skipped via
+//   MasterUseKernel=0) -> link KERNEL.CGO -> link GAME.CGO -> dump.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <vector>
+
+#include "common/common_types.h"
+#include "common/goal_constants.h"
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "game/kernel/common/kboot.h"
+#include "game/kernel/common/kdgo.h"
+#include "game/kernel/common/fileio.h"
+#include "game/kernel/common/klink.h"
+#include "game/kernel/common/klisten.h"
+#include "game/kernel/common/kmachine.h"
+#include "game/kernel/common/kmalloc.h"
+#include "game/kernel/common/kmemcard.h"
+#include "game/kernel/common/kprint.h"
+#include "game/kernel/common/kscheme.h"
+#include "game/kernel/common/memory_layout.h"
+#include "game/kernel/jak1/kboot.h"
+#include "game/kernel/jak1/kdgo.h"
+#include "game/kernel/jak1/klink.h"
+#include "game/kernel/jak1/kscheme.h"
+
+namespace {
+
+void link_cgo_from_disk(const char* cgo_path) {
+  FILE* fp = fopen(cgo_path, "rb");
+  if (!fp) {
+    lg::error("cannot open {}", cgo_path);
+    exit(2);
+  }
+  fseek(fp, 0, SEEK_END);
+  long fsize = ftell(fp);
+  fseek(fp, 0, SEEK_SET);
+  std::vector<u8> dgo((size_t)fsize);
+  if (fread(dgo.data(), 1, (size_t)fsize, fp) != (size_t)fsize) {
+    lg::error("short read of {}", cgo_path);
+    exit(2);
+  }
+  fclose(fp);
+
+  // Dump tool: larger stage than the Simulator's 512KB (a late GAME object
+  // exceeds 512KB); memory is not constrained here.
+  const u32 STAGE_SLOT = 8 * 1024 * 1024;
+  auto stage = kmalloc(kglobalheap, STAGE_SLOT, KMALLOC_TOP | KMALLOC_ALIGN_64,
+                       "ottsel-ios-dgo-stage");
+  if (!stage.offset) {
+    lg::error("kmalloc of the reusable DGO stage slot failed");
+    exit(2);
+  }
+
+  u32 count = *(u32*)dgo.data();
+  lg::info("{} has {} objects", cgo_path, count);
+  // Dump tool: link WITHOUT LINK_FLAG_EXECUTE so the per-object top-levels
+  // don't run (their trace shims need the 'ottsel-goal-call-trace' C export
+  // that only the iOS build registers).  Relocations still resolve.
+  u32 flags = LINK_FLAG_OUTPUT_LOAD | LINK_FLAG_PRINT_LOGIN;
+  u64 off = 64;
+  for (u32 i = 0; i < count; i++) {
+    u32 size = *(u32*)(dgo.data() + off);
+    const char* name = (const char*)(dgo.data() + off + 4);
+    u64 blob_off = off + 64;
+    u32 blob_size = (size + 15) & ~15u;
+    if (blob_size > STAGE_SLOT) {
+      lg::error("object blob larger than the reusable stage slot");
+      exit(2);
+    }
+    memcpy(stage.c(), dgo.data() + blob_off, size);
+    // Dump tool: link only (skip top-level execution).  The booted
+    // Simulator runs each top-level; the dump needs only the linked code +
+    // relocation patches, and skipping the GOAL top-levels avoids the
+    // symbol-table-base mismatch that crashes host-side top-level runs.
+    jak1::link_and_exec(stage, name, (int32_t)size, kglobalheap, flags, false);
+    off = blob_off + blob_size;
+  }
+  lg::info("{} linked ({} objects)", cgo_path, count);
+}
+
+void dump_region(u32 base, u32 len, const char* label) {
+  printf("===== %s @ 0x%08x (%u bytes) =====\n", label, base, len);
+  for (u32 i = 0; i < len; i += 4) {
+    u32 w = *(u32*)(g_ee_main_mem + base + i);
+    printf("0x%08x: 0x%08x\n", base + i, w);
+  }
+}
+
+// S2.2 (2026-08-15): resolve a Simulator code lr to the linked GOAL function
+// by scanning the FULL symbol table (the simulator's gated-handler scan was
+// limited to s7 +/- 0x4000 slots and may have missed the real caller).
+void resolve_sim_lr(u32 sim_lr) {
+  // The no-emit code region (0x3ebc000..0x4ee0000) links at the SAME base
+  // host-side as on the Simulator; the -0x40000 offset only applied to the
+  // earlier low-address (0x1fxxxx) kernel dumps.
+  const u32 host_lr = sim_lr;
+  const u32 code_lo = 0x3ebc000;
+  const u32 code_hi = 0x4ee0000;
+  u32 best = 0;
+  u32 best_slot = 0;
+  u32 next = 0xffffffff;
+  u32 next_slot = 0;
+  printf("===== resolve_sim_lr(0x%08x) host_lr=0x%08x =====\n", sim_lr, host_lr);
+  printf("SymbolTable2=0x%08x LastSymbol=0x%08x s7=0x%08x\n", SymbolTable2.offset,
+         LastSymbol.offset, s7.offset);
+  for (u32 slot = SymbolTable2.offset; slot < LastSymbol.offset; slot += 8) {
+    u32 v = *(u32*)(g_ee_main_mem + slot);
+    if (v >= code_lo && v < code_hi) {
+      if (v <= host_lr && v > best) {
+        best = v;
+        best_slot = slot;
+      }
+      if (v > host_lr && v < next) {
+        next = v;
+        next_slot = slot;
+      }
+    }
+  }
+  if (best_slot) {
+    auto bsym = Ptr<jak1::Symbol>(best_slot);
+    printf("caller: best=0x%08x slot=0x%08x name=\"%s\"\n", best, best_slot,
+           jak1::info(bsym)->str->data());
+  } else {
+    printf("caller: no symbol <= lr found\n");
+  }
+  if (next_slot) {
+    auto nsym = Ptr<jak1::Symbol>(next_slot);
+    printf("next fn: 0x%08x slot=0x%08x name=\"%s\" (caller body 0x%x..0x%x)\n", next, next_slot,
+           jak1::info(nsym)->str->data(), best, next);
+  }
+  dump_region(host_lr - 0x80, 0x120, "host code around lr");
+  // List every string-* symbol and its linked value, to show which kernel
+  // string primitives are null (unlinked) vs present.
+  printf("===== string-* symbol values =====\n");
+  for (u32 slot = SymbolTable2.offset; slot < LastSymbol.offset; slot += 8) {
+    u32 v = *(u32*)(g_ee_main_mem + slot);
+    auto inf = jak1::info(Ptr<jak1::Symbol>(slot));
+    if (!inf->hash) {
+      continue;  // open slot
+    }
+    if (!inf->str.offset || inf->str.offset >= 0x7ffffff) {
+      continue;  // garbage/empty name pointer
+    }
+    auto sym = Ptr<jak1::Symbol>(slot);
+    const char* nm = jak1::info(sym)->str->data();
+    if (nm && !strncmp(nm, "string-", 7)) {
+      printf("0x%08x val=0x%08x name=\"%s\"\n", slot, v, nm);
+    }
+  }
+}
+
+}  // namespace
+
+// The host runtime's mips2c_table.cpp now guards the jak1 table +
+// register_all_jak1 under OTTSEL_IOS, but kboot.o (OTTSEL_NO_EMIT + arm64)
+// still references it.  This tool only LINKS the CGOs (never executes game
+// code), so an empty registration is sufficient.
+namespace Mips2C {
+void register_all_jak1() {}
+}
+
+int main(int argc, char** argv) {
+  std::string iso_dir = "out/jak1/iso";
+  if (argc > 1) {
+    iso_dir = argv[1];
+  }
+
+  g_ee_main_mem = (u8*)mmap((void*)EE_MAIN_MEM_MAP, EE_MAIN_MEM_SIZE, PROT_READ | PROT_WRITE,
+                            MAP_ANONYMOUS | MAP_PRIVATE, 0, 0);
+  if (g_ee_main_mem == MAP_FAILED) {
+    lg::error("mmap of EE main memory failed");
+    return 2;
+  }
+  memset(g_ee_main_mem, 0, EE_MAIN_MEM_SIZE);
+  mprotect(g_ee_main_mem, EE_MAIN_MEM_LOW_PROTECT, PROT_NONE);
+
+  fileio_init_globals();
+  kmalloc_init_globals_common();
+  jak1::kboot_init_globals();
+  kdgo_init_globals();
+  jak1::kdgo_init_globals();
+  klink_init_globals();
+  jak1::kscheme_init_globals();
+  klisten_init_globals();
+  kmemcard_init_globals();
+
+  MasterDebug = 0;
+  MasterUseKernel = 0;  // skip the ISO kernel load inside InitHeapAndSymbol
+  // InitMachine normally does this before InitHeapAndSymbol; replicate it
+  // here (the global heap must exist before the symbol-table allocation).
+  u32 global_heap_size = GLOBAL_HEAP_END - HEAP_START;
+  lg::info("gkernel: global heap 0x{:08x} to 0x{:08x} (size {:.3f} MB)", HEAP_START,
+           GLOBAL_HEAP_END, (float)global_heap_size / (float)(1 << 20));
+  kinitheap(kglobalheap, Ptr<u8>(HEAP_START), global_heap_size);
+  kdebugheap.offset = 0;
+  if (jak1::InitHeapAndSymbol() < 0) {
+    lg::error("InitHeapAndSymbol failed");
+    return 2;
+  }
+
+  link_cgo_from_disk((iso_dir + "/KERNEL.CGO").c_str());
+  link_cgo_from_disk((iso_dir + "/GAME.CGO").c_str());
+
+  // S2.2 (2026-08-15): village-load null-call fault at sim lr=0x3eec878.
+  resolve_sim_lr(0x3eec878);
+  // Caller-chain candidates from the fault-time stack (the faulting
+  // enter-state was reached from this region).
+  resolve_sim_lr(0x3fdc214);
+  resolve_sim_lr(0x3ed1c74);
+  resolve_sim_lr(0x46106f0);
+  resolve_sim_lr(0x46135c0);
+
+  // Layout sanity: this host-side link places the KERNEL objects 0x40000
+  // lower than the Simulator boot (the iOS build consumes an extra
+  // symbol-table-sized allocation before the kernel link).  Dump the
+  // Simulator fault-chain addresses shifted by -0x40000 for kernel regions;
+  // the C-export stub arena (0x4f0000) is at fixed EE offsets.
+  dump_region(0x1f14c4 - 0x40000, 0x120, "throw-dispatch (sim 0x1f14c4)");
+  dump_region(0x1f11f4 - 0x40000, 0x2c4, "catch-frame-new (sim 0x1f11f4)");
+  dump_region(0x1f2674 - 0x40000, 0x600, "run-function-in-process (sim 0x1f2674)");
+  dump_region(0x1c5f00 - 0x40000, 0x200, "alloc_heap_object caller (sim 0x1c6014)");
+  dump_region(0x4f00ae0, 0x80, "alloc_heap_object stub region");
+  dump_region(0x1b5290, 0x30, "gkernel data slots (sim 0x1f5290)");
+  // Symbol entries referenced by run-function-in-process's call setup:
+  // slot@0x298 -> sym 0x152a04 (arg2), slot@0x29c -> sym 0x15922c (func).
+  dump_region(0x152a00, 0x30, "symbol @0x152a04");
+  dump_region(0x159220, 0x30, "symbol @0x15922c");
+  // catch-frame-new object fields: the call target = *(func + 0x10).
+  dump_region(0x1b11f0, 0x30, "catch-frame-new obj (sim 0x1f11f0)");
+  dump_region(0x1b1bf4, 0x180, "throw-dispatch NEW (sim 0x1f1bf4)");
+  dump_region(0x1b1bf4, 0x600, "throw-dispatch FULL (sim 0x1f1bf4, 0x600 bytes)");
+  dump_region(0x240a5e0, 0x160, "process trampoline (sim 0x244a5e0)");
+  dump_region(0x1b2df4, 0x340, "run-function-in-process current (sim 0x1f2df4)");
+  dump_region(0x1b2e00, 0x80, "rfn+0xc (sim 0x1f2e00)");
+  dump_region(0x1ad4c4, 0x180, "throw-dispatch NO-TRACE (sim 0x1e5e54)");
+  dump_region(0x1a6014, 0x180, "catch-frame-new NO-TRACE (sim 0x1e5b84?)");
+  // S2.1 dispatcher-loop fault: method dispatch on an object whose type tag
+  // is a game code address.  Sim addresses (host = sim - 0x40000):
+  //   faulting function 0x1e53e0 (host 0x1a53e0)
+  //   object 0x22f9f4     (host 0x1ef9f4)
+  //   "type" 0x2381704    (host 0x2341704)
+  dump_region(0x1a53e0, 0x280, "faulting dispatch fn (sim 0x1e53e0)");
+  dump_region(0x1ef9f0, 0x60, "object 0x22f9f4 (sim)");
+  dump_region(0x2341700, 0x60, "type 0x2381704 (sim)");
+  // Scan the linked EE image for the throw-dispatch entry pattern
+  // (mov x2,x0; add x16,x2,x22; ldur w0,[x16,#4]) and dump what we find.
+  {
+    const u32 pat[3] = {0xaa0003e2, 0x8b36e050, 0xb8404200};
+    for (u32 a = 0x100000; a < 0x400000; a += 4) {
+      u32 w0 = *(u32*)(g_ee_main_mem + a);
+      u32 w1 = *(u32*)(g_ee_main_mem + a + 4);
+      u32 w2 = *(u32*)(g_ee_main_mem + a + 8);
+      if (w0 == pat[0] && w1 == pat[1] && w2 == pat[2]) {
+        printf("===== throw-dispatch pattern found @ 0x%08x =====\n", a);
+        dump_region(a, 0x180, "throw-dispatch scan hit");
+        break;
+      }
+    }
+  }
+  return 0;
+}
