   ; means that the calculated effective address is written back to the base register. (pre-indexing)
@@ -32,7 +35,11 @@ _arg_call_arm64:
   ldp q12, q13, [sp], #32
   ldp q14, q15, [sp], #32
 
-  ldp	x29, x30, [sp], #16
+  ;; Ottsel H3: the caller stub pushed the C target at [sp] before jumping
+  ;; here.  It was read above at [sp, #16] but never popped, leaking 16 bytes
+  ;; of goal stack per GOAL->C call (the x86 trampoline pops it at entry).
+  ;; Pop both our saved frame and the stub's pushed target before returning.
+  ldp	x29, x30, [sp], #32
