+// Shared ARM64 no-emit mips2c handler (asm_funcs_arm64.s).
+void _mips2c_call_arm64() asm("_mips2c_call_arm64");
+
+void LinkedFunctionTable::reg(const std::string& name, u64 (*exec)(void*), u32 stack_size) {
+  const auto& it = m_executes.insert({name, {exec, Ptr<u8>()}});
+  if (!it.second) {
+    // Already registered (pre-registered before the arena RX flip; the
+    // game-link callbacks re-enter here).  Idempotent: keep the first stub.
+    return;
+  }
+#if defined(OTTSEL_NO_EMIT) && defined(__aarch64__)
+  // Ottsel S2.1 no-emit: write the stub into the executable stub arena (not
+  // the RW-only GOAL heap).  Layout mirrors make_function_from_c: type tag at
+  // the slot, code at slot+4 (returned as the function pointer).  The stub
+  // pushes [stack_size] then [exec] (16 bytes each) and jumps to the shared
+  // _mips2c_call_arm64 handler, which builds the ExecutionContext and calls
+  // exec(ctxt) -- the no-emit counterpart of the x86 runtime stub.
+  const u32 slot = ::jak1::ottsel_stub_alloc(0x48);
+  auto mem = Ptr<u8>(slot + 4);
+  *Ptr<u32>(slot).c() = *(s7 + jak1_symbols::FIX_SYM_FUNCTION_TYPE);
+  auto put32 = [&](u32 w) {
+    mem.c()[0] = w & 0xff;
+    mem.c()[1] = (w >> 8) & 0xff;
+    mem.c()[2] = (w >> 16) & 0xff;
+    mem.c()[3] = (w >> 24) & 0xff;
+    mem = mem + 4;
+  };
+  // +4:  ldr x16, [pc, #0x20]   ; exec literal at +36
+  // +8:  str x16, [sp, #-16]!
+  // +12: ldr x17, [pc, #0x20]   ; stack_size literal at +44
+  // +16: str x17, [sp, #-16]!
+  // +20: ldr x17, [pc, #0x20]   ; handler literal at +52
+  // +24: br x17
+  // +28..+35: nop padding
+  // +36: .quad exec
+  // +44: .quad stack_size
+  // +52: .quad _mips2c_call_arm64
+  put32(0x58000110);
+  put32(0xF81F0FF0);
+  put32(0x58000111);
+  put32(0xF81F0FF1);
+  put32(0x58000111);
+  put32(0xD61F0220);
+  for (int i = 0; i < 2; i++) {
+    put32(0xD503201F);  // nop
+  }
+  auto put64 = [&](u64 v) {
+    for (int i = 0; i < 8; i++) {
+      mem.c()[i] = (v >> (i * 8)) & 0xff;
+    }
+    mem = mem + 8;
+  };
+  put64((u64)exec);
+  put64((u64)stack_size);
+  put64((u64)(void*)_mips2c_call_arm64);
+  // BOT23: seal the slot (page RX + icache invalidate) before anything can
+  // jump into it — reg() runs during GAME linking, after the phase flips.
+  ::jak1::ottsel_stub_seal_last();
+  it.first->second.goal_trampoline = Ptr<u8>(slot + 4);
+#else
+  auto mem = Ptr<u8>(alloc_heap_object(s7.offset + jak1_symbols::FIX_SYM_GLOBAL_HEAP,
+                                       *(s7 + jak1_symbols::FIX_SYM_FUNCTION_TYPE), 0x40,
+                                       UNKNOWN_PP));
+  u8* ptr = mem.c();
+  {
+    u64 addr = (u64)exec;
+    *ptr = 0x48;
+    ptr++;
+    *ptr = 0xb8;
+    ptr++;
+    memcpy(ptr, &addr, 8);
+    ptr += 8;
+    *ptr = 0x50;
+    ptr++;
+    addr = stack_size;
+    *ptr = 0x48;
+    ptr++;
+    *ptr = 0xb8;
+    ptr++;
+    memcpy(ptr, &addr, 8);
+    ptr += 8;
+    *ptr = 0x50;
+    ptr++;
+#ifdef __linux__
+    addr = (u64)_mips2c_call_systemv;
+#elif defined __APPLE__ && defined __x86_64__
+    addr = (u64)_mips2c_call_systemv;
+#elif _WIN32
+    addr = (u64)_mips2c_call_windows;
+#endif
+    *ptr = 0x48;
+    ptr++;
+    *ptr = 0xb8;
+    ptr++;
+    memcpy(ptr, &addr, 8);
+    ptr += 8;
+    *ptr = 0xff;
+    ptr++;
+    *ptr = 0xe0;
+  }
+  it.first->second.goal_trampoline = mem;
+#endif
+}
