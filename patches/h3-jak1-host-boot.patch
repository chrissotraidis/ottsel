+std::vector<u8> ObjectGenerator::emit_function_code_only(const FunctionRecord& rec) {
+  auto& function = m_function_data_by_seg.at(rec.seg).at(rec.func_id);
+  // Build instruction offsets
+  function.instruction_to_byte_in_data.clear();
+  std::vector<u8> code;
+  code.reserve(function.instructions.size() * 4);
+  for (size_t i = 0; i < function.instructions.size(); i++) {
+    function.instruction_to_byte_in_data.push_back(int(code.size()));
+    u8 buf[256];
+    auto& inst = function.instructions[i];
+    u8 n = inst.emit(buf);
+    code.insert(code.end(), buf, buf + n);
+  }
+  // Patch jumps within this function using the same rules as handle_temp_jump_links
+  for (const auto& link : m_jump_temp_links_by_seg.at(rec.seg)) {
+    if (link.jump_instr.func_id != rec.func_id) {
+      continue;
+    }
+    const auto& jump_instr = function.instructions.at(link.jump_instr.instr_id);
+    ASSERT(jump_instr.get_imm_size() == 4);
+    int patch_location = function.instruction_to_byte_in_data.at(link.jump_instr.instr_id) +
+                         jump_instr.offset_of_imm();
+    int dest_rip =
+        function.instruction_to_byte_in_data.at(function.ir_to_instruction.at(link.dest.ir_id));
+    if (m_instruction_set == InstructionSet::ARM64) {
+      int source_pc = function.instruction_to_byte_in_data.at(link.jump_instr.instr_id);
+      s64 delta = s64(dest_rip) - s64(source_pc);
+      ASSERT((delta & 0x3) == 0);
+      u32 word = 0;
+      std::memcpy(&word, code.data() + patch_location, 4);
+      if ((word & 0xFC000000) == 0x14000000) {
+        s64 imm26 = delta >> 2;
+        ASSERT(imm26 >= -(1 << 25) && imm26 < (1 << 25));
+        word = (word & 0xFC000000) | (u32(imm26) & 0x03FFFFFF);
+      } else if ((word & 0xFF000010) == 0x54000000) {
+        s64 imm19 = delta >> 2;
+        ASSERT(imm19 >= -(1 << 18) && imm19 < (1 << 18));
+        word = (word & 0xFF00001F) | ((u32(imm19) & 0x7FFFF) << 5);
+      } else {
+        ASSERT_MSG(false, "ARM64 jump patch in emit_function_code_only failed");
+      }
+      std::memcpy(code.data() + patch_location, &word, 4);
+    } else {
+      int source_rip = function.instruction_to_byte_in_data.at(link.jump_instr.instr_id + 1);
+      s32 rel = s32(dest_rip - source_rip);
+      std::memcpy(code.data() + patch_location, &rel, 4);
+    }
+  }
+  if (function.debug) {
+    function.debug->length = int(code.size());
+    function.debug->offset_in_seg = 0;
+  }
+  return code;
+}
