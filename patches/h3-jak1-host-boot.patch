+  const char* srcs[] = {"goal_src/jak1/engine/math/vector-h.gc",
+                        "goal_src/jak1/engine/dma/dma-h.gc",
+                        "goal_src/jak1/engine/gfx/vu1-user-h.gc",
+                        "goal_src/jak1/engine/level/level-h.gc"};
+  for (auto p : srcs) {
+    try {
+      auto code = compiler.get_goos().reader.read_from_file({p});
+      auto* fe = compiler.compile_object_file("types", code, true);
+      compiler.color_only_for_proof(fe);
+    } catch (std::exception& e) {
+      std::cerr << "src " << p << " failed: " << e.what() << "\n";
+    }
+  }
+  Job jobs[] = {{"type", {"size", "flags", "field-info", "parent", "methods", "method-table", "name", nullptr}},
+                {"level", {"name", "load-name", "nickname", "index", "status", "other", "heap",
+                           "bsp", "art-group", "info", "vis-bits", "all-visible?", "linking",
+                           "code-memory-start", "texture-mask", nullptr}},
+                {"level-group",
+                 {"length", "log-in-level-bsp", "loading-level", "entity-link", "border?",
+                  "vis?", "want-level", "receiving-level", "load-commands", "play?", "_hack-pad",
+                  "level0", "level1", "level-default", "level", "data"}},
+                {"bsp-header",
+                 {"name", "info", "drawable-trees", "vis-info", "texture-page-count", "texture-ids",
+                  "actors", "adgifs", "bsp-array", "all-visible?", "level", "drawable-tree",
+                  "tree", "current-bsp-back-flags", nullptr}},
+                {"drawable-tree", {"bsphere", "drawable-tree", "drawables", "length", "top",
+                                   "vis-node-count", "vis-nodes", nullptr}},
+                {"drawable-inline-array-tfrag", {"data", "length", "pad", nullptr}},
+                {"tfragment", {"id", "color-index", "debug-data", "color-indices", "bsphere",
+                               "dma-chain", "dma-qwc", "shader", "num-shaders",
+                               "num-base-colors", "num-level0-colors", "num-level1-colors",
+                               "color-offset", "color-count", nullptr}}};
+  for (auto& j : jobs) {
+    auto* t = ts.lookup_type_no_throw(j.type);
+    if (!t) {
+      std::cout << j.type << ": <not found>\n";
+      continue;
+    }
+    auto* st = dynamic_cast<StructureType*>(t);
+    if (!st) {
+      std::cout << j.type << ": <not a structure>\n";
+      continue;
+    }
+    std::cout << j.type << ": size=0x" << std::hex << st->size() << std::dec << "\n";
+    for (int i = 0; j.fields[i]; i++) {
+      Field out;
+      if (st->lookup_field(j.fields[i], &out)) {
+        std::cout << "  " << j.fields[i] << " @ 0x" << std::hex << out.offset() << std::dec << "\n";
+      } else {
+        std::cout << "  " << j.fields[i] << " @ <missing>\n";
+      }
+    }
+  }
+  return 0;
+}
diff --git a/tools/ottsel_a1/semantic_regressions.cpp b/tools/ottsel_a1/semantic_regressions.cpp
