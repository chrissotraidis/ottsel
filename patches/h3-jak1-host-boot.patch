+/*!
+ * Ottsel H3 no-emit: C-export stubs must not live in the RW-only GOAL heap.
+ * We write them into a fixed executable stub arena inside the EE mapping and
+ * flip the used pages to RX before any GOAL code runs.  Two sub-arenas are
+ * used because stubs are created in two boot phases:
+ *   - phase A (pre-kernel-link): stubs created by InitHeapAndSymbol before the
+ *     kernel CGO is linked.  Flipped RX in jak1_finish (before the top-level
+ *     executes).
+ *   - phase B (post-kernel-link): stubs created by InitMachineScheme after the
+ *     kernel DGO load.  Flipped RX right before KernelCheckAndDispatch.
+ * Both are fixed EE offsets in the free gap between GLOBAL_HEAP_END
+ * (~0x3eb82e0) and DEBUG_HEAP_START (0x5000000); 16KB-page aligned.
+ */
+namespace {
+constexpr u32 OTTSEL_STUB_ARENA_A = 0x04F00000;
+constexpr u32 OTTSEL_STUB_ARENA_B = 0x04F10000;
+constexpr u32 OTTSEL_STUB_ARENA_SIZE = 0x10000;  // 64KB each
+constexpr u32 OTTSEL_STUB_SLOT = 0x48;           // type u32 + code (0x40)
+
