+u32 ottsel_stub_arena_base() {
+  return g_ottsel_stub_use_b ? OTTSEL_STUB_ARENA_B : OTTSEL_STUB_ARENA_A;
+}
+
+void ottsel_stub_flip_pages_rx(u32 ee_base, u32 used) {
+  if (!used) {
+    return;
+  }
+  const uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);  // 16KB on Apple Silicon
+  uintptr_t lo = (uintptr_t)(::g_ee_main_mem + ee_base) & ~(page - 1);
+  uintptr_t hi = ((uintptr_t)(::g_ee_main_mem + ee_base + used) + page - 1) & ~(page - 1);
+  for (uintptr_t addr = lo; addr < hi; addr += page) {
+    if (mprotect((void*)addr, page, PROT_READ | PROT_EXEC) != 0) {
+      lg::debug("OTTSEL no-emit: stub page @ 0x{:x} RX flip skipped: {}", addr, strerror(errno));
