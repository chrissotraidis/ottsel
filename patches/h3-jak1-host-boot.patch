diff --git a/common/dma/ottsel_dgo_alias.h b/common/dma/ottsel_dgo_alias.h
new file mode 100644
index 0000000000000000000000000000000000000000..87dcd126c77606f3239eb8c517ac39905a95f3fc
--- /dev/null
+++ b/common/dma/ottsel_dgo_alias.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <string_view>
+
+namespace ottsel {
+
+// Jak 1's GOAL level names are descriptive, while the extracted retail DGO
+// family uses the original short disc tokens. Keep this translation at the
+// data-loader seam instead of copying or renaming user-owned files.
+inline std::string_view jak1_dgo_retail_alias(std::string_view requested) {
+  if (requested == "village1.DGO") {
+    return "VI1.DGO";
+  }
+  if (requested == "village2.DGO") {
+    return "VI2.DGO";
+  }
+  if (requested == "village3.DGO") {
+    return "VI3.DGO";
+  }
+  if (requested == "beach.DGO") {
+    return "BEA.DGO";
+  }
+  return {};
+}
+
+}  // namespace ottsel
diff --git a/common/dma/ottsel_direct_ir.h b/common/dma/ottsel_direct_ir.h
new file mode 100644
index 0000000000000000000000000000000000000000..59aba5370bc23992b4e391e7f51285c535fa8009
--- /dev/null
+++ b/common/dma/ottsel_direct_ir.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ottsel {
+
+enum class DirectIrKind : uint8_t {
+  Prim,
+  Tex0,
+  St,
+  Rgbaq,
+  Vertex,
+  StateSnapshot,
+  BucketBegin,
+  BucketEnd,
+  Flush,
+  Error,
+  TransferEnd,
+};
+
+enum class DirectIrError : uint64_t {
+  OutOfBounds = 1,
+  UnsupportedRegister = 2,
+  MalformedTag = 3,
+};
+
+enum class DirectIrFlushReason : uint64_t {
+  TransferEnd = 1,
+  StateChange = 2,
+  BucketEnd = 3,
+};
+
+// Full GS/VIF state at an ordered IR boundary. Raw float bits are retained so
+// the snapshot is deterministic and can be compared without tolerance drift.
+struct DirectIrStateSnapshot {
+  uint64_t prim = 0;
+  uint64_t tex0 = 0;
+  uint64_t tex1 = 0;
+  uint64_t alpha = 0;
+  uint64_t zbuf = 0;
+  uint64_t test = 0;
+  uint64_t clamp = 0;
+  uint64_t frame = 0;
+  uint64_t xyoffset = 0;
+  uint64_t scissor = 0;
+  uint64_t texa = 0;
+  uint32_t st[3] = {};
+  uint32_t rgba[4] = {};
+  uint32_t uv_u = 0;
+  uint32_t uv_v = 0;
+  uint8_t flags = 0;
+
+  bool operator==(const DirectIrStateSnapshot&) const = default;
+};
+
+inline const char* direct_ir_kind_name(DirectIrKind kind) {
+  switch (kind) {
+    case DirectIrKind::Prim:
+      return "PRIM";
+    case DirectIrKind::Tex0:
+      return "TEX0";
+    case DirectIrKind::St:
+      return "ST";
+    case DirectIrKind::Rgbaq:
+      return "RGBAQ";
+    case DirectIrKind::Vertex:
+      return "XYZ";
+    case DirectIrKind::StateSnapshot:
+      return "STATE";
+    case DirectIrKind::BucketBegin:
+      return "BUCKET-BEGIN";
+    case DirectIrKind::BucketEnd:
+      return "BUCKET-END";
+    case DirectIrKind::Flush:
+      return "FLUSH";
+    case DirectIrKind::Error:
+      return "ERROR";
+    case DirectIrKind::TransferEnd:
+      return "TRANSFER-END";
+  }
+  return "UNKNOWN";
+}
+
+struct DirectIrEvent {
+  DirectIrKind kind;
+  uint64_t value;
+  DirectIrStateSnapshot state{};
+
+  bool operator==(const DirectIrEvent&) const = default;
+};
+
+}  // namespace ottsel
diff --git a/common/dma/ottsel_sprite_math.h b/common/dma/ottsel_sprite_math.h
new file mode 100644
index 0000000000000000000000000000000000000000..7f3094eb102121b8b646de12754a565c6de94c9f
--- /dev/null
+++ b/common/dma/ottsel_sprite_math.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <algorithm>
+
+namespace ottsel {
+
+// Jak 1 Sprite3's default DrawMode uses GEQUAL depth testing but leaves the
+// depth buffer unchanged while translucent sprites are drawn.
+constexpr bool sprite3_depth_write_enabled() {
+  return false;
+}
+
+// The maintained desktop Sprite3 first pass uses GEQUAL with the small
+// primary-pass threshold 0.016 (the double-draw pass owns the full AREF).
+constexpr unsigned int sprite3_alpha_test_enabled() {
+  return 1;
+}
+
+constexpr unsigned int sprite3_alpha_test_gequal() {
+  return 5;
+}
+
+constexpr unsigned int sprite3_primary_alpha_ref() {
+  return 2;  // 2 / 128 = 0.015625, the Metal state equivalent of 0.016.
+}
+
+inline bool sprite3_primary_alpha_pass(float alpha) {
+  return alpha >= static_cast<float>(sprite3_primary_alpha_ref()) / 128.f;
+}
+
+inline float sprite3_source_over_rgb(float source, float destination, float alpha) {
+  return source * alpha + destination * (1.f - alpha);
+}
+
+// Jak 1's Sprite3 shader fades a sprite by its projected area before the
+// final color multiplier. Keep this shared so native Metal and its fixture
+// regression use the same bounded arithmetic.
+inline float sprite3_faded_alpha(float alpha, float sx, float sy, float inv_area) {
+  const float area_fade = std::clamp(sx * sy * inv_area, 0.f, 1.f);
+  return std::clamp(alpha * area_fade, 0.f, 255.f);
+}
+
+// Sprite3's decoded vector color is already normalized when it crosses the
+// mobile VIF boundary, matching the desktop shader input. Keep this helper
+// separate from the byte-domain fixture helper above.
+inline float sprite3_faded_alpha_normalized(float alpha,
+                                            float sx,
+                                            float sy,
+                                            float inv_area) {
+  const float area_fade = std::clamp(sx * sy * inv_area, 0.f, 1.f);
+  return std::clamp(alpha * area_fade, 0.f, 1.f);
+}
+
+}  // namespace ottsel
diff --git a/common/dma/ottsel_sprite_phase.h b/common/dma/ottsel_sprite_phase.h
new file mode 100644
index 0000000000000000000000000000000000000000..61b3ff2dd78119e0cd0c0c3626034b0801dbb4c5
--- /dev/null
+++ b/common/dma/ottsel_sprite_phase.h
@@ -0,0 +1,122 @@
+#pragma once
+
+#include "common/common_types.h"
+#include "common/dma/gs.h"
+
+namespace ottsel {
+
+enum class Jak1SpritePhase : u8 {
+  World2D,
+  Hud2D,
+  ThreeD,
+  Other,
+};
+
+// The accepted macOS Village1 Sprite3 dispatch contains two 3D groups, 51
+// world blocks, and three HUD blocks. Keep this as a pure phase-coverage
+// discriminator so a mobile bucket can be compared before any renderer policy
+// or resource mapping is changed.
+inline bool has_jak1_post_transition_coverage(u32 world_groups,
+                                              u32 hud_groups,
+                                              u32 three_d_groups) {
+  return world_groups >= 51 && hud_groups >= 3 && three_d_groups >= 2;
+}
+
+// The phase aggregate is meaningful only when the captured producer records
+// retain the accepted dispatch order: 3D setup, then world, then HUD. Counts
+// are the captured block coverage represented by each record.
+inline bool has_ordered_jak1_post_transition_coverage(const Jak1SpritePhase* phases,
+                                                      const u32* counts,
+                                                      u32 record_count) {
+  if (!phases || !counts || record_count == 0) {
+    return false;
+  }
+
+  enum class PhaseOrder : u8 { ThreeD, World2D, Hud2D };
+  PhaseOrder order = PhaseOrder::ThreeD;
+  u32 three_d_records = 0;
+  u32 world_coverage = 0;
+  u32 hud_coverage = 0;
+  bool saw_world = false;
+  bool saw_hud = false;
+
+  for (u32 i = 0; i < record_count; ++i) {
+    switch (phases[i]) {
+      case Jak1SpritePhase::ThreeD:
+        if (saw_world || saw_hud || order != PhaseOrder::ThreeD) {
+          return false;
+        }
+        ++three_d_records;
+        break;
+      case Jak1SpritePhase::World2D:
+        if (saw_hud) {
+          return false;
+        }
+        saw_world = true;
+        order = PhaseOrder::World2D;
+        world_coverage += counts[i];
+        break;
+      case Jak1SpritePhase::Hud2D:
+        if (!saw_world) {
+          return false;
+        }
+        saw_hud = true;
+        order = PhaseOrder::Hud2D;
+        hud_coverage += counts[i];
+        break;
+      case Jak1SpritePhase::Other:
+        return false;
+    }
+  }
+
+  return three_d_records >= 2 && world_coverage >= 51 && hud_coverage >= 3;
+}
+
+// Jak 1 Sprite3 VU program entry points from SpriteProgMem. Keeping this
+// mapping explicit prevents the mobile parser from silently treating every
+// non-world MSCAL as an absent or malformed group.
+inline Jak1SpritePhase classify_jak1_sprite_mscal(u32 immediate) {
+  switch (immediate) {
+    case 3:
+      return Jak1SpritePhase::World2D;
+    case 109:
+      return Jak1SpritePhase::Hud2D;
+    case 211:
+      return Jak1SpritePhase::ThreeD;
+    default:
+      return Jak1SpritePhase::Other;
+  }
+}
+
+// GS TEX0.TCC=0 is a valid Sprite3 color-only state. The desktop renderer
+// keeps the register state and lets the shader use vertex color without a
+// texture sample; native Metal must make the same distinction explicitly.
+inline bool sprite3_uses_texture(u64 tex0_data) {
+  return GsTex0(tex0_data).tcc() != 0;
+}
+
+// Sprite3's reference shader multiplies xyz by homogeneous w and then the
+// GPU divides by that same w. The CPU composition path needs the post-divide
+// coordinate, so this helper is the contract tested by the native raster path.
+inline float sprite3_post_divide_component(float transformed_component,
+                                           float homogeneous_w,
+                                           float offset,
+                                           float scale) {
+  (void)homogeneous_w;
+  return (transformed_component - offset) / scale;
+}
+
+// Live R1 capture contract for the first bucket-67 world tuple. This is a
+// resource/phase discriminator only; it does not authorize rendering the
+// bucket or imply that protected texels belong in the repository.
+inline bool matches_bucket67_world_fixture(Jak1SpritePhase phase,
+                                           u32 sprite_count,
+                                           u32 tbp,
+                                           u32 psm,
+                                           u32 tw,
+                                           u32 th) {
+  return phase == Jak1SpritePhase::World2D && sprite_count == 48 && tbp == 0x2c8d &&
+         psm == 19 && tw == 5 && th == 5;
+}
+
+}  // namespace ottsel
