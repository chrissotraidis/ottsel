+                     "[slot]=0x{:x}",
+                     ffsym.offset, ffsym->value, slot, *(const u32*)(g_ee_main_mem + slot));
+          }
+          runf("sin", 0.0f, "T1");
+          runf("sin", 16384.0f, "T2");
+          runf("cos", 0.0f, "T3");
+          runf("cos", 16384.0f, "T4");
+          // BOT30 cycle 14: sin==0.0 exactly means its adrp+ldr static float
+          // constant (2pi/65536) loads as zero.  Dump sin's runtime code and
+          // resolve its first adrp+ldr-s target to see what's really there.
+          {
+            u32 sfn = jak1::intern_from_c("sin")->value;
+            if (sfn) {
+              const u32* code = (const u32*)(g_ee_main_mem + sfn);
+              for (int i = 0; i < 12; i += 4) {
+                lg::info("OTTSEL SINCODE +{:02x}: {:08x} {:08x} {:08x} {:08x}", i * 4, code[i],
+                         code[i + 1], code[i + 2], code[i + 3]);
+              }
+              // decode first adrp (imm) + following ldr-s imm12
+              for (int i = 0; i < 16; i++) {
+                u32 w = code[i];
+                if ((w & 0x9F000000) == 0x90000000) {  // ADRP
+                  u64 pc = (u64)(sfn + i * 4);
+                  u64 immhi = (w >> 5) & 0x7FFFF;
+                  u64 immlo = (w >> 29) & 3;
+                  s64 imm = (s64)((immhi << 2) | immlo);
+                  imm = (imm << 43) >> 43;  // sign extend 21 bits
+                  u64 page = (pc & ~0xFFFULL) + (imm << 12);
+                  u32 w2 = code[i + 1];
+                  u32 off = 0;
+                  if ((w2 & 0xFFC00000) == 0xBD400000) {  // LDR s, [x, #imm]
+                    off = ((w2 >> 10) & 0xFFF) << 2;
+                  } else if ((w2 & 0xFFC00000) == 0x3DC00000) {  // LDR q
+                    off = ((w2 >> 10) & 0xFFF) << 4;
+                  }
+                  u64 target = page + off;
+                  lg::info("OTTSEL SINADRP: pc=0x{:x} imm-pages={} page=0x{:x} next={:08x} "
+                           "off=0x{:x} target=0x{:x} [target]={:08x}",
+                           pc, imm, page, w2, off, target,
+                           target < (128ull << 20) ? *(const u32*)(g_ee_main_mem + target) : 0);
+                  break;
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+    // Watch collision/camera/input state only while tracing.  These were
+    // invaluable during the earlier ARM64 fault but should not perturb a soak.
+    if (ottsel_runtime_trace && (ottsel_pad_reads % 250) == 6 && g_ee_main_mem) {
+      u32 cl = jak1::intern_from_c("*collide-list*")->value;
+      auto w = [](u32 a) { return *(const u32*)(g_ee_main_mem + a); };
+      lg::info("OTTSEL TYPEWATCH: [0x153e2d4-4..]={:08x} {:08x} {:08x} slot12@+64={:08x} "
+               "[0x153db74+64]={:08x} collide-list=0x{:x} num-items={}",
+               w(0x153e2d0), w(0x153e2d4), w(0x153e2d8), w(0x153e2d4 + 64), w(0x153db74 + 64), cl,
+               cl ? (int)w(cl) : -1);
