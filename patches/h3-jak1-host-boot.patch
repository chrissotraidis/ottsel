diff --git a/tools/ottsel_a1/kernel_fn_dump.cpp b/tools/ottsel_a1/kernel_fn_dump.cpp
new file mode 100644
index 000000000..4ab428bfa
--- /dev/null
+++ b/tools/ottsel_a1/kernel_fn_dump.cpp
@@ -0,0 +1,210 @@
+// Ottsel S2.1 diagnostic: name the gkernel function that calls the pc-prof
+// C export (the pc=0 fault site).  Compiles the real kernel GOAL sources
+// through the ARM64 goalc and prints every function name + code size, then
+// flags the functions whose emitted code contains a pc-prof symbol call
+// (the IR_FunctionCall whose target symbol name is "pc-prof").
+
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "common/versions/versions.h"
+
+#include "goalc/compiler/CodeGenerator.h"
+#include "goalc/compiler/Compiler.h"
+#include "goalc/compiler/IR.h"
+#include "goalc/debugger/DebugInfo.h"
+#include "goalc/emitter/InstructionSet.h"
+#include "goalc/emitter/Register.h"
+
+using namespace emitter;
+
+int main(int argc, char** argv) {
+  lg::set_stdout_level(lg::level::warn);
+  lg::set_flush_level(lg::level::warn);
+  lg::initialize();
+
+  if (!file_util::setup_project_path(std::nullopt)) {
+    std::cerr << "setup_project_path failed\n";
+    return 2;
+  }
+
+  try {
+    Compiler compiler(GameVersion::Jak1, InstructionSet::ARM64);
+    RegisterInfo::set_active_instruction_set(InstructionSet::ARM64);
+
+    // Compile the kernel group in order (kernel.gd) so gcommon's globals exist
+    // before gkernel.gc is compiled; then dump the pc-prof callers.
+    std::vector<std::pair<const char*, const char*>> kernel_files = {
+        {"goal_src/jak1/kernel/gcommon.gc", "gcommon"},
+        {"goal_src/jak1/kernel/gstring-h.gc", "gstring-h"},
+        {"goal_src/jak1/kernel/gkernel-h.gc", "gkernel-h"},
+        {"goal_src/jak1/kernel/gkernel.gc", "gkernel"},
+        {"goal_src/jak1/kernel/pskernel.gc", "pskernel"},
+        {"goal_src/jak1/kernel/gstring.gc", "gstring"},
+        {"goal_src/jak1/kernel/dgo-h.gc", "dgo-h"},
+        {"goal_src/jak1/kernel/gstate.gc", "gstate"},
+    };
+    const char* target = argc > 1 ? argv[1] : "goal_src/jak1/kernel/gkernel.gc";
+    std::vector<FunctionEnv*> target_fns;
+    FileEnv* target_fe = nullptr;
+    for (auto& [file, obj_name] : kernel_files) {
+      auto obj = compiler.get_goos().reader.read_from_file({file});
+      auto* fe = compiler.compile_object_file(obj_name, obj, true);
+      compiler.color_only_for_proof(fe);
+      if (std::string(file) == "goal_src/jak1/kernel/gcommon.gc") {
+        u32 off = 0;
+        auto* gdbg = &compiler.get_debugger().get_debug_info_for_object("gcommon");
+        for (auto& f : fe->functions()) {
+          try {
+            gdbg->clear();
+            CodeGenerator gen_gc(fe, gdbg, GameVersion::Jak1,
+                                 InstructionSet::ARM64);
+            auto bytes_gc = gen_gc.emit_function_machine_code(f.get(), 0);
+            std::cout << "GCOMMON 0x" << std::hex << off << std::dec << "  " << f->name()
+                      << "  code=" << bytes_gc.size() << "\n";
+            off += (u32)bytes_gc.size();
+          } catch (const std::exception&) {
+            std::cout << "GCOMMON 0x" << std::hex << off << std::dec << "  " << f->name()
+                      << "  code=0\n";
+          }
+        }
+      }
+      if (std::string(file) == target) {
+        target_fe = fe;
+        for (auto& f : fe->functions()) {
+          target_fns.push_back(f.get());
+        }
+      }
+    }
+
+    auto* debug = &compiler.get_debugger().get_debug_info_for_object("gkernel");
+
+    u32 off = 0;
+    for (auto* f : target_fns) {
+      debug->clear();
+      bool calls_pc_prof = false;
+      for (auto& ir : f->code()) {
+        auto* call = dynamic_cast<IR_FunctionCall*>(ir.get());
+        if (call) {
+          if (call->print().find("pc-prof") != std::string::npos) {
+            calls_pc_prof = true;
+          }
+        }
+      }
+      size_t code_size = 0;
+      bool dispatch_pattern = false;
+      try {
+        CodeGenerator gen(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        auto bytes = gen.emit_function_machine_code(f, 0);
+        code_size = bytes.size();
+        // S2.1 dispatch-fault pattern: ldur w0,[x16,#-0x4]; add x16,x0,x22,sxtx;
+        // ldur w1,[x16,#0x40] (method dispatch on an object's type tag).
+        for (size_t i = 0; i + 12 <= bytes.size(); i += 4) {
+          u32 w0, w1, w2;
+          std::memcpy(&w0, bytes.data() + i, 4);
+          std::memcpy(&w1, bytes.data() + i + 4, 4);
+          std::memcpy(&w2, bytes.data() + i + 8, 4);
+          if (w0 == 0xb85fc200 && w1 == 0x8b36e010 && w2 == 0xb8440201) {
+            dispatch_pattern = true;
+          }
+        }
+      } catch (const std::exception&) {
+        code_size = 0;
+      }
+      std::cout << (calls_pc_prof ? "PC_PROF: " : dispatch_pattern ? "DISPATCH: " : "        ")
+                << f->name() << "  code=" << code_size << " bytes\n";
+      std::cout << "GK_OFF " << std::hex << off << std::dec << " " << f->name() << " size=" << code_size << "\n";
+      off += code_size;
+      if (f->name().find("anon-function-5") != std::string::npos) {
+        for (auto& ir : f->code()) {
+          auto* call = dynamic_cast<IR_FunctionCall*>(ir.get());
+          if (call) {
+            std::cout << "    call IR: " << call->print() << "\n";
+          }
+        }
+      }
+      if (f->name() == "execute-process-tree") {
+        debug->clear();
+        CodeGenerator gen2(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        auto bytes2 = gen2.emit_function_machine_code(f, 0);
+        std::cout << "execute-process-tree code:";
+        for (size_t i = 0; i < bytes2.size(); i += 4) {
+          u32 w;
+          std::memcpy(&w, bytes2.data() + i, 4);
+          std::cout << " " << std::hex << w << std::dec;
+        }
+        std::cout << "\n";
+      }
+      if (f->name().find("get-process dead-pool") != std::string::npos) {
+        debug->clear();
+        CodeGenerator gen2(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        auto bytes2 = gen2.emit_function_machine_code(f, 0);
+        std::cout << "get-process-dead-pool code:";
+        for (size_t i = 0; i < bytes2.size(); i += 4) {
+          u32 w;
+          std::memcpy(&w, bytes2.data() + i, 4);
+          std::cout << " " << std::hex << w << std::dec;
+        }
+        std::cout << "\n";
+        debug->clear();
+        CodeGenerator genx(target_fe, debug, GameVersion::Jak1, InstructionSet::X86);
+        auto bytesx = genx.emit_function_machine_code(f, 0);
+        std::cout << "get-process-dead-pool x86:";
+        for (size_t i = 0; i < bytesx.size(); i += 4) {
+          u32 w;
+          std::memcpy(&w, bytesx.data() + i, 4);
+          std::cout << " " << std::hex << w << std::dec;
+        }
+        std::cout << "\n";
+      }
+      if (f->name() == "(method new process-tree)" || f->name() == "(method new process)") {
+        debug->clear();
+        CodeGenerator gen2(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        auto bytes2 = gen2.emit_function_machine_code(f, 0);
+        std::cout << f->name() << " code:";
+        for (size_t i = 0; i < bytes2.size(); i += 4) {
+          u32 w;
+          std::memcpy(&w, bytes2.data() + i, 4);
+          std::cout << " " << std::hex << w << std::dec;
+        }
+        std::cout << "\n";
+      }
+      if (f->name().find("thread-suspend") != std::string::npos ||
+          f->name().find("thread-resume") != std::string::npos ||
+          f->name().find("run-now-in-process") != std::string::npos ||
+          f->name().find("activate") != std::string::npos) {
+        debug->clear();
+        CodeGenerator gen2(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        auto bytes2 = gen2.emit_function_machine_code(f, 0);
+        std::cout << f->name() << " code:";
+        for (size_t i = 0; i < bytes2.size(); i += 4) {
+          u32 w;
+          std::memcpy(&w, bytes2.data() + i, 4);
+          std::cout << " " << std::hex << w << std::dec;
+        }
+        std::cout << "\n";
+      }
+      if (f->name().find("anon-function-5") != std::string::npos) {
+        debug->clear();
+        CodeGenerator gen3(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        auto bytes3 = gen3.emit_function_machine_code(f, 0);
+        std::cout << "anon-function-5 code:";
+        for (size_t i = 0; i < bytes3.size(); i += 4) {
+          u32 w;
+          std::memcpy(&w, bytes3.data() + i, 4);
+          std::cout << " " << std::hex << w << std::dec;
+        }
+        std::cout << "\n";
+      }
+    }
+    std::cout << "total gkernel functions: " << target_fns.size() << "\n";
+  } catch (const std::exception& e) {
+    std::cerr << "fatal: " << e.what() << "\n";
+    return 1;
+  }
+  return 0;
+}
