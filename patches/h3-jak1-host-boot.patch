diff --git a/game/sce/sif_ee.cpp b/game/sce/sif_ee.cpp
index d40922a9a..bea67ab7d 100644
--- a/game/sce/sif_ee.cpp
+++ b/game/sce/sif_ee.cpp
@@ -80,24 +80,69 @@ s32 sceSifCallRpc(sceSifClientData* bd,
                   s32 rsize,
                   void* end_func,
                   void* end_para) {
+#ifdef OTTSEL_IOS
+  // Ottsel S2.1: no IOP thread on iOS; the OVERLORD/sound RPC protocol is
+  // inert (IOP_Kernel::sif_rpc is a no-op stub).  GOAL calls the sound
+  // loader with mode 0 (sync), so the upstream `mode == 1` assert cannot
+  // hold here.
+  // Emulate just enough of the OVERLORD sound loader for the boot path:
+  // respond to get-irx-version (sound-command 12, sent in the buffer header
+  // at +2) with version 2.0 so check-irx-version passes instead of crash!-ing.
+  if (send && ssize >= 12) {
+    u16 cmd = 0;
+   (void)bd;
+    (void)fno;
+    memcpy(&cmd, (const u8*)send + 2, 2);
+    if (cmd == 12) {
+      const u32 major = 2;
+      const u32 minor = 0;
+      memcpy((u8*)send + 4, &major, 4);
+      memcpy((u8*)send + 8, &minor, 4);
+    }
+  }
+  (void)bd;
+  (void)fno;
+  (void)mode;
+  (void)ssize;
+  (void)recv;
+  (void)rsize;
+  (void)end_func;
+  (void)end_para;
+  return 0;
+#else
   ASSERT(!end_func);
   ASSERT(!end_para);
   ASSERT(mode == 1);  // async
   iop->kernel.sif_rpc(bd->rpcd.id, fno, mode, send, ssize, recv, rsize);
   iop->signal_run_iop();
   return 0;
+#endif
 }
 
 s32 sceSifCheckStatRpc(sceSifRpcData* bd) {
+#ifdef OTTSEL_IOS
+  (void)bd;
+  return 0;
+#else
   iop->signal_run_iop();
   return iop->kernel.sif_busy(bd->id);
+#endif
 }
 
 s32 sceSifBindRpc(sceSifClientData* bd, u32 request, u32 mode) {
+#ifdef OTTSEL_IOS
+  // Ottsel S2.1: keep the RPC client object shape valid (bd->serve set) so
+  // the GOAL-side call method proceeds; no IOP work happens.
+  (void)mode;
+  bd->rpcd.id = request;
+  bd->serve = (sceSifServeData*)1;
+  return 0;
+#else
   ASSERT(mode == 1);  // async
   bd->rpcd.id = request;
   bd->serve = (sceSifServeData*)1;
   return 0;
+#endif
 }
 
