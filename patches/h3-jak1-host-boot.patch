+constexpr u32 OTTSEL_STUB_ARENA_A = 0x04F00000;
+constexpr u32 OTTSEL_STUB_ARENA_B = 0x04F10000;
+constexpr u32 OTTSEL_STUB_ARENA_SIZE = 0x10000;  // 64KB each
+constexpr u32 OTTSEL_STUB_SLOT = 0x48;           // type u32 + code (0x40)
+
+u32 g_ottsel_stub_next = 0;          // next free slot in the active arena
+bool g_ottsel_stub_use_b = false;    // true once phase A is flipped
+bool g_ottsel_stub_b_flipped = false;
