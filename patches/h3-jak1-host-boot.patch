+// Ottsel H2: prove the ARM64 C->GOAL bridge end-to-end.
+// Assembles the real game/kernel/asm_funcs_arm64.s and calls an AOT-compiled
+// GOAL function through _call_goal_asm_arm64 (same helper the wired call_goal uses).
+
+#include <mach/mach.h>
+#include <sys/mman.h>
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <string>
