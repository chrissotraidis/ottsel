+  EXPECT_FALSE(shadow_vu_address_is_valid(0xffff));
+  EXPECT_TRUE(shadow_vu_stream_fits(1000, 0, 24));
+  EXPECT_FALSE(shadow_vu_stream_fits(1000, 0, 25));
