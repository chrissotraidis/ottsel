+  EXPECT_EQ("VI1.DGO", ottsel::jak1_dgo_retail_alias("village1.DGO"));
+  EXPECT_EQ("BEA.DGO", ottsel::jak1_dgo_retail_alias("beach.DGO"));
+  EXPECT_EQ("", ottsel::jak1_dgo_retail_alias("COMMON.CGO"));
+}
+
+TEST(Sprite3Native, GfxSendChainReadsJak1BucketsRelativeToChainOffset) {
+  std::array<u8, 0x1000> memory{};
+  constexpr u32 chain_offset = 0x180;
+  constexpr u32 bucket66_data = 0x600;
+  constexpr u32 bucket67_data = 0x700;
+  constexpr u32 bucket68_data = 0x800;
+
+  put_u64(memory, chain_offset + 66 * 16,
+          make_dma_tag(DmaTag::Kind::NEXT, bucket66_data));
+  put_u64(memory, chain_offset + 67 * 16,
+          make_dma_tag(DmaTag::Kind::NEXT, bucket67_data));
+  put_u64(memory, chain_offset + 68 * 16,
+          make_dma_tag(DmaTag::Kind::NEXT, bucket68_data));
+
+  const DmaTag sprite_bucket(
+      *reinterpret_cast<const u64*>(memory.data() + chain_offset + 66 * 16));
+  const DmaTag debug_bucket(
+      *reinterpret_cast<const u64*>(memory.data() + chain_offset + 67 * 16));
+  const DmaTag next_bucket(
+      *reinterpret_cast<const u64*>(memory.data() + chain_offset + 68 * 16));
+
+  EXPECT_EQ(bucket66_data, sprite_bucket.addr);
+  EXPECT_EQ(bucket67_data, debug_bucket.addr);
+  EXPECT_EQ(bucket68_data, next_bucket.addr);
+  EXPECT_NE(sprite_bucket.addr, debug_bucket.addr);
+  EXPECT_NE(debug_bucket.addr, next_bucket.addr);
+}
+
+TEST(Sprite3Native, AppliesProjectedAreaFadeBeforeMetalUpload) {
+  EXPECT_FLOAT_EQ(64.f, ottsel::sprite3_faded_alpha(128.f, 0.5f, 0.5f, 2.f));
