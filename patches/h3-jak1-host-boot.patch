index 000000000..b66b0ac45
--- /dev/null
+++ b/tools/ottsel_a1/semantic_regressions.cpp
@@ -0,0 +1,952 @@
+// Ottsel A1.0 semantic ARM64 regression harness.
+//
+// The emission validator proves only that words decode as legal A64
+// instructions.  Recent defects emitted perfectly legal but WRONG
+// instructions (SP becoming xzr, loads emitted as stores, wrong load/store
+// widths, scaled vs unscaled offsets, swapped ABI argument pairs, and
+// LR/call/return corruption).  This harness compiles GOAL functions through
+// the real ARM64 goalc path (or constructs the emitter instructions
+// directly) and asserts what the emitted code DOES, not merely that it
+// decodes.
+//
+// Every emitter/ABI fix must have a case here that fails before the fix and
+// passes afterward.
+
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "common/versions/versions.h"
+
+#include "goalc/compiler/CodeGenerator.h"
+#include "goalc/compiler/Compiler.h"
+#include "goalc/debugger/DebugInfo.h"
+#include "goalc/emitter/IGen.h"
+#include "goalc/emitter/IGenARM64.h"
+#include "goalc/emitter/InstructionSet.h"
+#include "goalc/emitter/Register.h"
+
+using namespace emitter;
+
+// ---------------------------------------------------------------------------
+// Tiny semantic classifier for the emitted A64 words.
+// ---------------------------------------------------------------------------
+enum class A64Class {
+  OTHER,
+  ADD_IMM_SP,     // add xd, sp, #imm  (64-bit add-immediate, Rn = SP)
+  ORR_MOV_XZR,    // mov xd, xzr  (orr xd, xzr, xzr -> dest becomes 0, NOT sp)
+  LDR_F32,        // ldr s, [x, #imm]
+  STR_F32,        // str s, [x, #imm]
+  LDURH,          // ldurh w, [x, #imm9]  (unscaled 16-bit load)
+  LDRH,           // ldrh w, [x, #imm12]  (scaled 16-bit load, imm12 x2)
+  STR_X30_PRE,    // str x30, [sp, #-16]!
+  LDR_X30_POST,   // ldr x30, [sp], #16
+  STR_X17_PRE,    // str x17, [sp, #-16]!
+  LDR_X17_POST,   // ldr x17, [sp], #16
+  LDR_X30_SP,     // ldr x30, [sp]  (no post-index; asm-func .ret)
+  RET,
+};
+
+static A64Class classify(u32 w) {
+  // add xd, sp, #imm : 1001000100 imm12 Rn(31) Rd
+  if ((w & 0xFFC00000) == 0x91000000 && ((w >> 5) & 0x1F) == 31) {
+    return A64Class::ADD_IMM_SP;
+  }
+  // orr xd, xzr, xzr (mov xd, xzr): 0xAA1F0000 | (Rm<<16) | Rd with Rm=31,Rn=31
+  if ((w & 0x7FE0FC00) == 0xAA000000 && ((w >> 5) & 0x1F) == 31 && (w & 0xFC00) == 0) {
+    // Rm == 31 too for the pure xzr case; be strict about the exact bug:
+    if (((w >> 16) & 0x1F) == 31) {
+      return A64Class::ORR_MOV_XZR;
+    }
+  }
+  if ((w & 0xFFC00000) == 0xBD400000) return A64Class::LDR_F32;   // ldr s, [x,#imm]
+  if ((w & 0xFFC00000) == 0xBD000000) return A64Class::STR_F32;   // str s, [x,#imm]
+  if ((w & 0xFFC00000) == 0x78400000) return A64Class::LDURH;     // ldurh (unscaled)
+  if ((w & 0xFFC00000) == 0x79400000) return A64Class::LDRH;      // ldrh (scaled imm12)
+  if (w == 0xF81F0FFE) return A64Class::STR_X30_PRE;
+  if (w == 0xF84107FE) return A64Class::LDR_X30_POST;
+  if (w == 0xF81F0FF1) return A64Class::STR_X17_PRE;
+  if (w == 0xF84107F1) return A64Class::LDR_X17_POST;
+  if (w == 0xF94003FE) return A64Class::LDR_X30_SP;
+  if ((w & 0xFFFFFC1F) == 0xD65F0000) return A64Class::RET;
+  return A64Class::OTHER;
+}
+
+static bool contains(const std::vector<u8>& bytes, A64Class cls, u32* found_word = nullptr) {
+  for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+    u32 w;
+    std::memcpy(&w, bytes.data() + i, 4);
+    if (classify(w) == cls) {
+      if (found_word) {
+        *found_word = w;
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+static int g_fail = 0;
+
+static void check(bool ok, const char* what) {
+  if (!ok) {
+    std::cerr << "  FAIL: " << what << "\n";
+    g_fail++;
+  } else {
+    std::cout << "  ok: " << what << "\n";
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Section A: emitter-unit semantic tests (construct the instruction directly).
+// ---------------------------------------------------------------------------
+static void emitter_unit_tests() {
+  std::cout << "[A1.0 emitter-unit]\n";
+
+  // 1. static_load_f32 must be a LOAD (ldr s), never a STORE (str s).
+  //    Regression for the STR/Q clobber that zeroed symbol slots at 0x4040..0x404c.
+  {
+    auto ins = IGen::ARM64::static_load_f32(emitter::V0, 0);
+    // The sequence is (ADRP, LDR): check the final load word.
+    u32 w = ins.encodings[ins.count - 1];
+    check(classify(w) == A64Class::LDR_F32,
+          "static_load_f32 emits ldr s (was str q0 -> slot clobber)");
+    if (classify(w) != A64Class::LDR_F32) {
+      std::cout << "    word=0x" << std::hex << w << std::dec << "\n";
+    }
+  }
+
+  // 2. 16-bit static-field load must be the UNSCALED LDURH; the scaled LDRH
+  //    imm12 field is x2, so a raw offset of 8 became [base+16] (the
+  //    entity-perm-array size/heap-base reads).  Regression for load16u.
+  {
+    auto ins = IGen::ARM64::load16u_gpr64_gpr64_plus_gpr64_plus_s8(emitter::X0, emitter::X1,
+                                                                   emitter::X2, 8);
+    // The instruction is (ADD base+index, LDURH): check the final load word.
+    u32 w = ins.encodings[ins.count - 1];
+    check(classify(w) == A64Class::LDURH, "load16u +s8 emits unscaled ldurh (was scaled ldrh)");
+    if (classify(w) != A64Class::LDURH) {
+      std::cout << "    word=0x" << std::hex << w << std::dec << "\n";
+    }
+    // The second emitted word (the ADD base+index) must be present and sane.
+    check(ins.count >= 2, "load16u +s8 has the base+index add");
+  }
+
+  // 3. The 16-bit STORE keeps the unscaled STURH (guard against a future
+  //    symmetric regression).
+  {
+    auto ins = IGen::ARM64::store16_gpr64_gpr64_plus_gpr64_plus_s8(emitter::X0, emitter::X1,
+                                                                   emitter::X2, 12);
+    check(ins.count >= 2, "store16 +s8 has the base+index add");
+  }
+
+  // 7. _stack_call_arm64 must build the GOAL arg array in order
+  //    [x0..x7] (STP stores the first listed reg at [base]); the swapped
+  //    pairs made `(format 0 "..." ...)` pass dest=0 as the format string.
+  //    Source-level check of the runtime asm (the array order is static).
+  {
+    std::string path = file_util::get_file_path({"game/kernel/asm_funcs_arm64.s"});
+    std::ifstream f(path);
+    bool found = false, ok = true;
+    std::string line;
+    int first_pair = 0;
+    while (std::getline(f, line)) {
+      if (line.find("_stack_call_arm64:") != std::string::npos) {
+        found = true;
+        continue;
+      }
+      if (!found) {
+        continue;
+      }
+      if (line.find("_mips2c_call_arm64:") != std::string::npos) {
+        break;  // next function
+      }
+      if (line.find("stp x") != std::string::npos) {
+        // The arg-array pushes, in order from the highest address: the first
+        // pushed pair must be (x6, x7) and the last (x0, x1) so that
+        // array[0] = x0.
+        if (first_pair == 0) {
+          ok = ok && line.find("stp x6, x7") != std::string::npos;
+          first_pair = 1;
+        } else if (first_pair == 1 && line.find("stp x4, x5") != std::string::npos) {
+          first_pair = 2;
+        } else if (first_pair == 2 && line.find("stp x2, x3") != std::string::npos) {
+          first_pair = 3;
+        } else if (first_pair == 3 && line.find("stp x0, x1") != std::string::npos) {
+          first_pair = 4;
+        }
+      }
+    }
+    check(found && ok && first_pair == 4,
+          "_stack_call_arm64 pushes (x6,x7)(x4,x5)(x2,x3)(x0,x1) -> array [x0..x7]");
+  }
+
+  // 15. C -> GOAL stack switching is an AAPCS64 boundary. GOAL reserves
+  // x19-x28 for its own ABI, so the bridge must restore every one before
+  // returning to C. Regression for S2.1's post-time-of-day crash where
+  // link_control kept EnableMethodSet in x24 and dereferenced clobbered x24.
+  {
+    std::string path = file_util::get_file_path({"game/kernel/asm_funcs_arm64.s"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_bridge = false;
+    while (std::getline(f, line)) {
+      if (line.find("_call_goal_on_stack_asm_arm64:") != std::string::npos) in_bridge = true;
+      if (in_bridge) body += line + "\n";
+      if (in_bridge && line == "  ret") break;
+    }
+    const char* saves[] = {"stp x19, x20", "stp x21, x22", "stp x23, x24",
+                           "stp x25, x26", "stp x27, x28"};
+    const char* restores[] = {"ldp x27, x28", "ldp x25, x26", "ldp x23, x24",
+                              "ldp x21, x22", "ldp x19, x20"};
+    const char* vector_saves[] = {"stp q8, q9", "stp q10, q11", "stp q12, q13", "stp q14, q15"};
+    const char* vector_restores[] = {"ldp q14, q15", "ldp q12, q13", "ldp q10, q11", "ldp q8, q9"};
+    bool ok = in_bridge;
+    for (const auto* pair : saves) ok = ok && body.find(pair) != std::string::npos;
+    for (const auto* pair : restores) ok = ok && body.find(pair) != std::string::npos;
+    for (const auto* pair : vector_saves) ok = ok && body.find(pair) != std::string::npos;
+    for (const auto* pair : vector_restores) ok = ok && body.find(pair) != std::string::npos;
+    check(ok, "C-to-GOAL stack bridge preserves AAPCS64 x19-x28 and GOAL q8-q15 across execution");
+  }
+
+  // 16. A no-emit C-function stub that needs pp must put x20 into C x3
+  // before branching to _arg_call_arm64.  A reversed order left the MOV
+  // unreachable, so object-new on the process heap received the stale
+  // function-pointer value and returned #f.
+  {
+    std::string path = file_util::get_file_path({"game/kernel/jak1/kscheme.cpp"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_stub = false;
+    while (std::getline(f, line)) {
+      if (line.find("Ptr<Function> make_function_from_c_systemv") != std::string::npos) in_stub = true;
+      if (in_stub) body += line + "\n";
+      if (in_stub && line.find("#else") != std::string::npos) break;
+    }
+    const auto pp_move = body.find("put32(0xAA1403E3)");
+    const auto branch = body.find("put32(0xD61F0220)");
+    check(in_stub && pp_move != std::string::npos && branch != std::string::npos && pp_move < branch,
+          "pp-aware no-emit C stub moves x20 to x3 before branching to its trampoline");
+  }
+
+  // 18. The iOS CGO loader replaces the host's load_and_link_dgo_from_c
+  // path.  The host holds *enable-method-set* across the complete GAME.CGO
+  // link so a parent method defined after its child types propagates into
+  // those child vtables.  Without that scope art-group::login remains zero
+  // and its first virtual dispatch branches to EE base.
+  {
+    std::string path = file_util::get_file_path({"../../src/shell/ios_boot.cpp"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_loader = false;
+    while (std::getline(f, line)) {
+      if (line.find("void ottsel_ios_link_cgo_from_bundle") != std::string::npos) in_loader = true;
+      if (in_loader) body += line + "\n";
+      if (in_loader && line.find("extern \"C\" void ottsel_ios_load_kernel_from_bundle") != std::string::npos) break;
+    }
+    const auto enable = body.find("*EnableMethodSet += 1");
+    const auto disable = body.find("*EnableMethodSet -= 1");
+    const auto first_link = body.find("jak1::link_and_exec");
+    check(in_loader && enable != std::string::npos && disable != std::string::npos &&
+              enable < first_link && first_link < disable,
+          "iOS CGO loader holds enable-method-set across all object links for inherited methods");
+  }
+
+  // 19. Phase-B C-export stubs are created by InitMachine after the kernel
+  // link.  GAME.CGO top-levels can call them before the dispatcher starts,
+  // so the iOS boot path must flip that arena RX before linking GAME, not
+  // only at the later dispatch boundary.
+  {
+    std::string path = file_util::get_file_path({"../../src/shell/ios_boot.cpp"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_boot = false;
+    while (std::getline(f, line)) {
+      if (line.find("void ottsel_ios_run_boot()") != std::string::npos) in_boot = true;
+      if (in_boot) body += line + "\n";
+    }
+    const auto register_mips2c = body.find("Mips2C::register_all_jak1()");
+    const auto phase_b = body.find("jak1::ottsel_stub_flip_phase_b()");
+    const auto game = body.find("ottsel_ios_link_cgo_from_bundle(\"GAME.CGO\")");
+    check(in_boot && register_mips2c != std::string::npos && phase_b != std::string::npos &&
+              game != std::string::npos && register_mips2c < phase_b && phase_b < game,
+          "iOS boot pre-registers Mips2C then flips phase-B stubs RX before GAME top-levels execute");
+  }
+
+  // 20. The Mips2C bridge builds ExecutionContext at the current native SP.
+  // The requested fake MIPS stack belongs below that context; it must not be
+  // added to x0 before calling exec(ctxt).  Doing so with texture's 0x80-byte
+  // stack made C++ read t4 as a0 and fault at EE+0x701765c8.
+  {
+    std::string path = file_util::get_file_path({"game/kernel/asm_funcs_arm64.s"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_bridge = false;
+    while (std::getline(f, line)) {
+      if (line.find("_mips2c_call_arm64:") != std::string::npos) in_bridge = true;
+      if (in_bridge) body += line + "\n";
+      if (in_bridge && line == "  ret") break;
+    }
+    const auto ctxt = body.rfind("  mov x0, sp");
+    const auto allocate = body.find("  sub sp, sp,", ctxt);
+    const auto call = body.find("  blr x16", allocate);
+    check(in_bridge && ctxt != std::string::npos && allocate != std::string::npos &&
+              call != std::string::npos && ctxt < allocate && allocate < call,
+          "Mips2C exec receives the context base, not context plus fake-stack size");
+  }
+
+  // 21. A fault handler is a diagnostic boundary, not normal logging code.
+  // libc formatting can take locale locks and fault recursively while the
+  // process is already handling SIGSEGV, destroying the original record.
+  {
+    std::string path = file_util::get_file_path({"../../src/shell/ios_boot.cpp"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_handler = false;
+    while (std::getline(f, line)) {
+      if (line.find("void gated_signal_handler") != std::string::npos) in_handler = true;
+      if (in_handler) body += line + "\n";
+      if (in_handler && line.find("void install_gated_signal_handlers") != std::string::npos) break;
+    }
+    check(in_handler && body.find("vsnprintf") == std::string::npos &&
+              body.find("raw_write_hex") != std::string::npos,
+          "gated signal handler emits fault data without libc formatting");
+  }
+
+  // 22. x17 is caller-saved under AAPCS64.  The Mips2C bridge needs the
+  // fake-stack size both before and after exec(ctxt), so preserve it in x19
+  // before the C++ call; using clobbered x17 unaligned SP at the epilogue.
+  {
+    std::string path = file_util::get_file_path({"game/kernel/asm_funcs_arm64.s"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_bridge = false;
+    while (std::getline(f, line)) {
+      if (line.find("_mips2c_call_arm64:") != std::string::npos) in_bridge = true;
+      if (in_bridge) body += line + "\n";
+      if (in_bridge && line == "  ret") break;
+    }
+    const auto load_size = body.find("ldr x17, [sp, #96]");
+    const auto preserve = body.find("mov x19, x17");
+    const auto call = body.find("blr x16");
+    const auto result_base = body.find("add x16, x16, x19");
+    const auto unwind = body.find("add sp, sp, x19");
+    check(in_bridge && load_size != std::string::npos && preserve != std::string::npos &&
+              call != std::string::npos && result_base != std::string::npos &&
+              unwind != std::string::npos && load_size < preserve && preserve < call &&
+              call < result_base && result_base < unwind,
+          "Mips2C preserves fake-stack size across its C++ call");
+  }
+
+  // 23. A Mips2C trampoline pushes [stack_size, exec] in two 16-byte GOAL
+  // slots before branching to _mips2c_call_arm64.  The handler must consume
+  // exactly those 32 bytes after restoring its own frame, leaving the
+  // caller's IR_FunctionCall continuation/LR slots for the caller.  Without
+  // this unwind, fuel-cell's nested Mips2C call returned with SP -32 and its
+  // caller restored continuation addresses as x19/x23.
+  {
+    std::string path = file_util::get_file_path({"game/kernel/asm_funcs_arm64.s"});
+    std::ifstream f(path);
+    std::string body, line;
+    bool in_bridge = false;
+    while (std::getline(f, line)) {
+      if (line.find("_mips2c_call_arm64:") != std::string::npos) in_bridge = true;
+      if (in_bridge) body += line + "\n";
+      if (in_bridge && line == "  ret") break;
+    }
+    const auto restore_frame = body.find("ldp x29, x30, [sp], #16");
+    const auto unwind_stub = body.find("add sp, sp, #32");
+    const auto ret = body.rfind("  ret");
+    check(in_bridge && restore_frame != std::string::npos && unwind_stub != std::string::npos &&
+              ret != std::string::npos && restore_frame < unwind_stub && unwind_stub < ret,
+          "Mips2C bridge consumes its trampoline's 32-byte [stack_size, exec] frame");
+  }
+
+  // 24. ARM64 logical AND (merc-ctrl eye-check).  and_gpr64_gpr64 must emit
+  //     the AND shifted-register encoding (top-11 opcode 0x450), never the
+  //     ADD shifted-register encoding (0x458).  Live GAME.CGO showed
+  //     `add x0,x0,x1` for `(logand -65536 eye-ctrl)`: with eye-ctrl = 0 the
+  //     result was -65536 (nonzero), so logtest? was true, merc entered the
+  //     eye-shader loop, built raw x0 = 0x10 and faulted in the callee.
+  {
+    auto ins = IGen::ARM64::and_gpr64_gpr64(emitter::X0, emitter::X1);
+    u32 w = ins.encodings[ins.count - 1];
+    const u32 op = w >> 21;
+    check(op == 0x450, "and_gpr64_gpr64 emits AND shifted-register (0x450), not ADD (0x458)");
+    if (op != 0x450) {
+      std::cout << "    word=0x" << std::hex << w << std::dec << " op=0x" << std::hex << op
+                << std::dec << "\n";
+    }
+    // Zero-mask semantics of the merc-ctrl branch: only AND(-65536,0)=0
+    // selects the no-eye branch; ADD(-65536,0)=-65536 (nonzero) wrongly
+    // enters the eye path.
+    const int64_t and_result = int64_t(-65536) & int64_t(0);
+    const int64_t add_result = int64_t(-65536) + int64_t(0);
+    check(and_result == 0 && add_result != 0,
+          "AND(-65536,0)=0 selects the no-eye branch; ADD would enter the eye path");
+  }
+
+  // 23. mov_vf_vf is the ARM64 MOV idiom ORR Vd.16B, Vn.16B, Vn.16B.  The
+  // encoder set Rn but left Rm=0, emitting ORR Vd, Vn, V0 -- every 128-bit
+  // register copy OR-ed with the stale XMM return register V0.  In the S2.2
+  // village load, res-lump get-property-value's default (uint128 arg in V1)
+  // was OR-ed with V0 (a res-tag pointer), entity-nav-login passed that
+  // garbage length to engine-new, the allocation size became enormous,
+  // object-new returned 0, and engine-new faulted writing fields at EE+6.
+  {
+    auto ins = IGen::ARM64::mov_vf_vf(emitter::V8, emitter::V1);
+    u32 w = ins.encodings[ins.count - 1];
+    u32 rm = (w >> 16) & 0x1F;
+    u32 rn = (w >> 5) & 0x1F;
+    check((w & 0xFFE0FC00) == 0x4EA01C00 && rm == rn,
+          "mov_vf_vf emits ORR Vd,Vn,Vn (MOV idiom; Rm==Rn, was ORR with V0)");
+    if ((w & 0xFFE0FC00) != 0x4EA01C00 || rm != rn) {
+      std::cout << "    word=0x" << std::hex << w << std::dec << " rm=" << rm << " rn=" << rn
+                << "\n";
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Section B: GOAL-compile semantic tests (real GOAL -> emitted bytes -> scan).
+// ---------------------------------------------------------------------------
+static FunctionEnv* pick_named(FileEnv* fe, const char* needle) {
+  for (auto& f : fe->functions()) {
+    if (f->name().find(needle) != std::string::npos) {
+      return f.get();
+    }
+  }
+  return nullptr;
+}
+
+static std::vector<u8> emit_function(Compiler& compiler, const std::string& name,
+                                     const std::string& src, const char* needle) {
+  auto obj = compiler.get_goos().reader.read_from_string(src, true, name);
+  auto* fe = compiler.compile_object_file(name, obj, true);
+  compiler.color_only_for_proof(fe);
+  auto* fenv = pick_named(fe, needle);
+  if (!fenv) {
+    throw std::runtime_error("function not found: " + std::string(needle));
+  }
+  auto* debug = &compiler.get_debugger().get_debug_info_for_object(fe->name());
+  debug->clear();
+  CodeGenerator gen(fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+  return gen.emit_function_machine_code(fenv, 0);
+}
+
+static void goal_compile_tests() {
+  std::cout << "[A1.0 goal-compile]\n";
+  Compiler compiler(GameVersion::Jak1, InstructionSet::ARM64);
+  RegisterInfo::set_active_instruction_set(InstructionSet::ARM64);
+
+  // 4. Stack-variable addressing must use ADD with SP (the ORR path turns
+  //    register 31 into xzr, so `mov xd, sp` computed 0).  Regression for
+  //    IR_GetStackAddr.
+  try {
+    auto bytes = emit_function(compiler, "a1-sva",
+                               "(deftype ottsel-a1-struct (structure) ((x int))) "
+                               "(defun ottsel-a1-sva ((a int)) "
+                               "(let ((x (new 'stack-no-clear 'ottsel-a1-struct))) "
+                               "(set! (-> x x) a) (-> x x)))",
+                               "ottsel-a1-sva");
+    check(contains(bytes, A64Class::ADD_IMM_SP),
+          "stack-var address uses add xd, sp, #imm");
+    check(!contains(bytes, A64Class::ORR_MOV_XZR),
+          "no mov xd, xzr (was the SP->xzr bug)");
+  } catch (const std::exception& e) {
+    check(false, (std::string("stack-var compile: ") + e.what()).c_str());
+  }
+
+  // 5. A u16 field read must emit an UNSCALED 16-bit load; the scaled LDRH
+  //    with a raw offset double-counted.  Regression for load16u (type size /
+  //    heap-base reads at +8 / +12).
+  try {
+    auto bytes = emit_function(compiler, "a1-u16",
+                               "(defun ottsel-a1-u16 ((a type)) (-> a size))", "ottsel-a1-u16");
+    check(contains(bytes, A64Class::LDURH), "u16 field read emits unscaled ldurh");
+    check(!contains(bytes, A64Class::LDRH), "no scaled ldrh (was the x2-offset bug)");
+  } catch (const std::exception& e) {
+    check(false, (std::string("u16 compile: ") + e.what()).c_str());
+  }
+
+  // 6. A non-leaf GOAL function (one that makes a call) must save x30 in the
+  //    prologue and restore it before ret, so the epilogue returns to the
+  //    true caller.  Regression for LR/call/return corruption.
+  try {
+    auto bytes = emit_function(compiler, "a1-call",
+                               "(defun ottsel-a1-callee () 7) "
+                               "(defun ottsel-a1-caller ((a int)) (+ a (ottsel-a1-callee)))",
+                               "ottsel-a1-caller");
+    check(contains(bytes, A64Class::STR_X30_PRE), "non-leaf prologue saves x30");
+    check(contains(bytes, A64Class::LDR_X30_POST), "non-leaf epilogue restores x30");
+    check(contains(bytes, A64Class::RET), "function ends with ret");
+  } catch (const std::exception& e) {
+    check(false, (std::string("caller compile: ") + e.what()).c_str());
+  }
+
+  // 8. Two-level nesting: the outer caller must save x30 around the call to
+  //    the middle function, and the middle function around its call to the
+  //    leaf -- so a return from the leaf lands back in the middle, then the
+  //    outer.  Regression for LR corruption in deeper call chains.
+  try {
+    auto bytes = emit_function(compiler, "a1-nest",
+                               "(defun ottsel-a1-leaf () 7) "
+                               "(defun ottsel-a1-mid ((a int)) (+ a (ottsel-a1-leaf))) "
+                               "(defun ottsel-a1-outer ((a int)) "
+                               "(+ (ottsel-a1-mid a) (ottsel-a1-mid a)))",
+                               "ottsel-a1-outer");
+    check(contains(bytes, A64Class::STR_X30_PRE), "2-level caller saves x30 (prologue)");
+    check(contains(bytes, A64Class::LDR_X30_POST), "2-level caller restores x30 (epilogue)");
+    check(contains(bytes, A64Class::RET), "2-level caller ends with ret");
+  } catch (const std::exception& e) {
+    check(false, (std::string("nested compile: ") + e.what()).c_str());
+  }
+
+  // 9. Consecutive float field stores must not double-apply the field
+  //    offset.  The +s8/+s32 float store emitters put a stray imm12=1 into
+  //    the final STR (`str s0, [x16, #0x4]`) AFTER the offset had already
+  //    been added to x16, so every float after the first in a group landed
+  //    +4 bytes too far.  In the matrix light-kit builder the last element
+  //    (offset 0x3c) landed at 0x40 -- exactly the caller's saved-x30 slot,
+  //    so the callee's epilogue `ret` jumped to EE base (0x7000000000).
+  //    Regression for store32_xmm32_gpr64_*_plus_s8/s32.
+  try {
+    auto bytes = emit_function(compiler, "a1-fstr",
+                               "(deftype ottsel-a1-vec (structure) "
+                               "  ((x float) (y float) (z float) (w float))) "
+                               "(defun ottsel-a1-fstr ((v ottsel-a1-vec)) "
+                               "  (set! (-> v x) 1.0) (set! (-> v y) 2.0) "
+                               "  (set! (-> v z) 3.0) (set! (-> v w) 4.0) v)",
+                               "ottsel-a1-fstr");
+    bool any_bad = false;
+    u32 first_bad = 0;
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      if (classify(w) == A64Class::STR_F32) {
+        // imm12 is scaled by 4 for a 32-bit SIMD store; a nonzero value here
+        // means the offset was applied twice (the ADD already has it).
+        if (((w >> 10) & 0xFFF) != 0) {
+          any_bad = true;
+          first_bad = w;
+        }
+      }
+    }
+    check(!any_bad, "float field stores keep the offset in the ADD (no spurious str immediate)");
+    if (any_bad) {
+      std::cout << "    bad word=0x" << std::hex << first_bad << std::dec << "\n";
+    }
+  } catch (const std::exception& e) {
+    check(false, (std::string("fstr compile: ") + e.what()).c_str());
+  }
+
+  // 10. GOAL asm functions that manipulate `sp` (rsp) must NOT encode the
+  //     destination as xzr.  Register 31 in ORR/ADD-shifted/SUB-shifted
+  //     decodes as XZR (write discarded), so `(set! sp ...)` / `(.add sp off)`
+  //     / `(.sub sp off)` emitted `mov xzr,xN` / `add xzr,xzr,xN` and the
+  //     stack-pointer switch never happened (throw-dispatch fault: the callee
+  //     clobbered caller-saved x24 and `ret` returned into `throw`'s
+  //     continuation).  The SP forms must use ADD-immediate (mov sp,xN) or the
+  //     extended-register form (add/sub sp,sp,xN).
+  try {
+    auto bytes = emit_function(compiler, "a1-spops",
+                               "(deftype ottsel-a1-spframe (basic)"
+                               "  ((sp pointer) (ra pointer))"
+                               "  :size-assert #xc :method-count-assert 9)"
+                               "(define-extern *kernel-sp* pointer)"
+                               "(defun ottsel-a1-spops ((this ottsel-a1-spframe) value)"
+                               "  (declare (asm-func none))"
+                               "  (rlet ((sp :reg rsp :type uint)"
+                               "         (off :reg r15 :type uint)"
+                               "         (temp :reg rax :type uint))"
+                               "    (.load-sym :sext #f sp *kernel-sp*)"
+                               "    (set! sp (the uint (-> this sp)))"
+                               "    (.add sp off)"
+                               "    (.sub sp off)"
+                               "    (.mov temp value)"
+                               "    (.ret))"
+                               "  (none))",
+                               "ottsel-a1-spops");
+    // Field decode helpers (top-11 opcode + register fields):
+    //   ORR shifted = 0x550, ADD shifted = 0x458, SUB shifted = 0x658
+    //   ADD extended = 0x459, SUB extended = 0x659
+    auto xzr_dest = [](u32 w) {
+      u32 op = w >> 21;
+      u32 rd = w & 0x1F;
+      u32 rn = (w >> 5) & 0x1F;
+      // register 31 in the shifted-register forms is XZR, never SP: a write to
+      // it is silently discarded.
+      return (op == 0x550 || op == 0x458 || op == 0x658) && rd == 31 && rn == 31;
+    };
+    auto ext_sp = [](u32 w) {
+      u32 op = w >> 21;
+      u32 rd = w & 0x1F;
+      u32 rn = (w >> 5) & 0x1F;
+      // extended-register add/sub with Rn=Rd=SP and option=SXTX(3), imm3=0
+      return (op == 0x459 || op == 0x659) && rd == 31 && rn == 31 &&
+             ((w >> 10) & 0x7) == 0 && ((w >> 13) & 0x7) == 3;
+    };
+    auto mov_sp = [](u32 w) {
+      // mov sp, xN == add sp, xN, #0 (ADD immediate, Rd=31, imm12=0)
+      return (w & 0xFFC00000) == 0x91000000 && (w & 0x1F) == 31 && ((w >> 10) & 0xFFF) == 0;
+    };
+    bool any_xzr_dest = false;
+    u32 first_xzr = 0;
+    bool saw_add_sp = false;
+    bool saw_sub_sp = false;
+    bool saw_mov_sp = false;
+    bool saw_adrp_sp = false;   // ADRP with Rd=31 (XZR) would silently drop the address
+    bool saw_ld_sp = false;     // LDRSW/LDR into Rt=31 (XZR) would silently drop the value
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      if (xzr_dest(w)) {
+        any_xzr_dest = true;
+        if (!first_xzr) first_xzr = w;
+      }
+      if (ext_sp(w) && ((w >> 16) & 0x1F) == 22 && (w >> 21) == 0x459) saw_add_sp = true;
+      if (ext_sp(w) && ((w >> 16) & 0x1F) == 22 && (w >> 21) == 0x659) saw_sub_sp = true;
+      if (mov_sp(w)) saw_mov_sp = true;
+      // ADRP <Xd>, ... : opcode 0x90000000, Rd field
+      if ((w & 0x9F000000) == 0x90000000 && (w & 0x1F) == 31) saw_adrp_sp = true;
+      // LDRSW/LDR (unsigned imm) with Rt=31 : opcodes 0xB9800000 / 0xF9400000
+      if (((w & 0xFFC00000) == 0xB9800000 || (w & 0xFFC00000) == 0xF9400000) &&
+          (w & 0x1F) == 31)
+        saw_ld_sp = true;
+    }
+    check(!saw_adrp_sp, "load-sym into sp never emits ADRP with Rd=31 (xzr)");
+    check(!saw_ld_sp, "load-sym into sp never emits a load with Rt=31 (xzr)");
+    // A correct `.load-sym sp` chain has exactly one `mov sp, xN` at the end
+    // (the routed temp -> sp), plus the add/sub SP forms above.
+    check(!any_xzr_dest, "asm sp ops never encode register 31 as xzr (was SP->xzr)");
+    check(saw_mov_sp, "set! sp emits add sp, xN, #0 (mov sp, xN)");
+    check(saw_add_sp, "add sp off emits extended-register add sp, sp, x22");
+    check(saw_sub_sp, "sub sp off emits extended-register sub sp, sp, x22");
+    if (any_xzr_dest) {
+      std::cout << "    bad word=0x" << std::hex << first_xzr << std::dec << "\n";
+    }
+  } catch (const std::exception& e) {
+    check(false, (std::string("spops compile: ") + e.what()).c_str());
+  }
+
+  // 11. GOAL asm-func `.ret` follows the x86 convention: the return address
+  //     sits ON the GOAL stack (return-from-thread / abandon-thread /
+  //     throw-dispatch / catch-frame-new all push it there before returning).
+  //     A bare ARM64 `ret` jumps to x30 -- the current function's own return
+  //     address -- so throw-dispatch "returned" into `throw`'s continuation
+  //     with the catch-frame's ra pushed but unused, and the next (-> cur type)
+  //     read SIGSEGV'd at 4GB into the EE mapping.  `.ret` must pop the
+  //     return address into x30 and THEN ret.
+  try {
+    auto bytes = emit_function(compiler, "a1-asmret",
+                               "(defun ottsel-a1-asmret ()"
+                               "  (declare (asm-func none))"
+                               "  (rlet ((temp :reg rax :type uint))"
+                               "    (.mov temp 5)"
+                               "    (.ret)))",
+                               "ottsel-a1-asmret");
+    bool has_pop = false;
+    bool has_pop_nopost = false;
+    bool has_ret = false;
+    bool pop_before_ret = false;
+    int pop_off = -1;
+    int ret_off = -1;
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      if (classify(w) == A64Class::LDR_X30_POST) {
+        has_pop = true;
+        if (pop_off < 0) pop_off = int(i);
+      }
+      if (classify(w) == A64Class::LDR_X30_SP) {
+        has_pop_nopost = true;
+        if (pop_off < 0) pop_off = int(i);
+      }
+      if (classify(w) == A64Class::RET) {
+        has_ret = true;
+        if (ret_off < 0) ret_off = int(i);
+      }
+    }
+    pop_before_ret = (has_pop_nopost || has_pop) && has_ret && pop_off >= 0 && ret_off >= 0 &&
+                     pop_off < ret_off;
+    // S2.1: `.ret` loads the return address WITHOUT advancing sp (the call-site
+    // shim's post-index pop consumes the same slot and restores the caller's
+    // sp).  Advancing here double-pops and shifts the caller's epilogue by 16
+    // bytes -> ret-to-pp in the throw-dispatch return path.
+    check(has_pop_nopost && !has_pop,
+          "asm .ret loads x30 from [sp] WITHOUT post-index (was ldr x30,[sp],#16)");
+    check(has_ret, "asm .ret still ends with ret");
+    check(pop_before_ret, "asm .ret pops BEFORE the ret (was bare ret to x30)");
+    if (!has_pop_nopost || has_pop || !pop_before_ret) {
+      std::cout << "    pop_off=" << pop_off << " ret_off=" << ret_off << "\n";
+      std::cout << "    asmret bytes (" << bytes.size() << "):";
+      for (size_t i = 0; i < bytes.size(); i += 4) {
+        u32 w;
+        std::memcpy(&w, bytes.data() + i, 4);
+        std::cout << " " << std::hex << w << std::dec;
+      }
+      std::cout << "\n";
+    }
+  } catch (const std::exception& e) {
+    check(false, (std::string("asmret compile: ") + e.what()).c_str());
+  }
+
+  // 12. A GOAL call must load the function pointer into a NON-argument
+  //     register (the reserved X16 temp) so it cannot clobber the GOAL args
+  //     (x0-x7).  Regression for the freg/arg collision: the allocator put
+  //     the fn in x2/x3, so the object-new call passed the fn as `pp`
+  //     (kmalloc failed with pp = the alloc_heap_object stub) and the
+  //     run-function-in-process chain corrupted the func argument.
+  try {
+    auto bytes = emit_function(compiler, "a1-fnreg",
+                               "(define-extern ottsel-a1-fnreg-leaf "
+                               "  (function int int int int)) "
+                               "(defun ottsel-a1-fnreg ((a int) (b int) (c int)) "
+                               "  (ottsel-a1-fnreg-leaf a b c))",
+                               "ottsel-a1-fnreg");
+    bool blr_arg = false;
+    int blr_rn = -1;
+    int blr_count = 0;
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      // blr xN : 0xD63F0000 | (N << 5)
+      if ((w & 0xFFFFFC1F) == 0xD63F0000) {
+        int rn = (w >> 5) & 0x1F;
+        blr_count++;
+        blr_rn = rn;
+        if (rn <= 7) blr_arg = true;
+      }
+    }
+    check(!blr_arg, "call blr target is not an argument register (was freg in x2/x3)");
+    check(!blr_arg && blr_rn >= 0,
+          "call blr target is a non-argument register (chosen by the allocator)");
+    if (blr_count) {
+      std::cout << "    blr count = " << blr_count << ", last target register = x" << blr_rn
+                << "\n";
+    } else {
+      std::cout << "    no blr found in emitted bytes (" << bytes.size() << " bytes)\n";
+    }
+  } catch (const std::exception& e) {
+    check(false, (std::string("fnreg compile: ") + e.what()).c_str());
+  }
+
+  // 13. The ARM64 C-export stub for arg3_is_pp functions must move pp (x20)
+  //     into x3 (the C function's 4th argument) before calling it, matching
+  //     the x86 stub's `mov rcx, r13`.  Without it, alloc_from_heap read
+  //     garbage pp and every process allocation failed
+  //     ("!alloc mem in heap for #<process @ #x4f00afc>").
+  {
+    std::string path = file_util::get_file_path({"game/kernel/jak1/kscheme.cpp"});
+    std::ifstream f(path);
+    bool found = false, ok = false;
+    std::string line;
+    while (std::getline(f, line)) {
+      if (line.find("arg3_is_pp") != std::string::npos &&
+          line.find("AA1403E3") != std::string::npos) {
+        found = true;
+      }
+      if (line.find("AA1403E3") != std::string::npos) {
+        ok = true;  // mov x3, x20 emitted by the arg3_is_pp stub
+      }
+    }
+    check(ok, "C-export stub moves pp (x20) into x3 for arg3_is_pp (was ignored)");
+  }
+
+  // 14. A GOAL->GOAL call must put its POST-BLR continuation on the GOAL
+  //     stack, matching x86 `call`.  An asm-func such as catch-frame-new
+  //     stores that value in its catch frame; throw-dispatch later returns to
+  //     it.  The incoming x30 belongs below that value and is restored only
+  //     after the synthetic call-return slot is discarded.  Regression for
+  //     trace4's rfn -> trampoline -> ret-to-raw-rfn path.
+  try {
+    auto bytes = emit_function(compiler, "a1-callpush",
+                               "(deftype ottsel-a1-asmret-frame (basic)"
+                               "  ((sp pointer) (ra pointer))"
+                               "  :size-assert #xc :method-count-assert 9)"
+                               "(defun ottsel-a1-callpush-callee ((this ottsel-a1-asmret-frame)"
+                               "                                   value)"
+                               "  (declare (asm-func none))"
+                               "  (rlet ((temp :reg rax :type uint))"
+                               "    (.mov temp value)"
+                               "    (.ret))"
+                               "  (none))"
+                               "(defun ottsel-a1-callpush-caller ((this ottsel-a1-asmret-frame)"
+                               "                                      value)"
+                               "  (+ (the int (ottsel-a1-callpush-callee this value)) 1))",
+                               "ottsel-a1-callpush-caller");
+    bool continuation_slot = false;
+    bool restoration_pair = false;
+    for (size_t i = 0; i + 24 <= bytes.size(); i += 4) {
+      u32 adr, push, blr, pop_cont, pop_lr;
+      std::memcpy(&adr, bytes.data() + i, 4);
+      std::memcpy(&push, bytes.data() + i + 4, 4);
+      std::memcpy(&blr, bytes.data() + i + 12, 4);
+      std::memcpy(&pop_cont, bytes.data() + i + 16, 4);
+      std::memcpy(&pop_lr, bytes.data() + i + 20, 4);
+      // ADR <Xd>, label: signed imm21 = immhi:immlo.  The x17 value must
+      // name the instruction immediately after this BLR, not the caller LR.
+      // ADR x17, PC+16 encodes to 0x10000091: opcode ADR, Rd=x17,
+      // immhi=4/immlo=0.  PC+16 is precisely the instruction after the
+      // following `blr`, so a catch-frame cannot mistakenly retain the
+      // incoming x30 instead.
+      const bool adr_x17_post_blr = adr == 0x10000091;
+      if (adr_x17_post_blr && classify(push) == A64Class::STR_X17_PRE &&
+          (blr & 0xFFFFFC1F) == 0xD63F0000) {
+        continuation_slot = true;
+        restoration_pair = classify(pop_cont) == A64Class::LDR_X17_POST &&
+                           classify(pop_lr) == A64Class::LDR_X30_POST;
+      }
+    }
+    check(continuation_slot, "call stack slot is ADR x17 of the post-blr continuation");
+    check(restoration_pair, "post-call path discards continuation then restores incoming x30");
+    std::cout << "    callpush bytes (" << bytes.size() << "):";
+    for (size_t i = 0; i < bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      std::cout << " " << std::hex << w << std::dec;
+    }
+    std::cout << "\n";
+  } catch (const std::exception& e) {
+    check(false, (std::string("callpush compile: ") + e.what()).c_str());
+  }
+
+  // 17. A fixed (method-of-type T method) call must read T's method table,
+  // not inspect the returned structure object's word at -4. Structures are
+  // untagged allocations, so that accidental virtual dispatch becomes a call
+  // through ee+0. Regression for joint's new-cspace path.
+  try {
+    auto bytes = emit_function(
+        compiler, "a1-structure-method",
+        "(deftype ottsel-a1-struct-method (structure) ((value int)) "
+        "  (:methods (new (symbol type) _type_) (reset! (_type_) _type_))) "
+        "(defmethod reset! ((this ottsel-a1-struct-method)) this) "
+        "(defun ottsel-a1-structure-method ((allocation symbol) (type-to-make type)) "
+        "  (let ((make-structure (method-of-type structure new))) "
+        "    ((method-of-type ottsel-a1-struct-method reset!) "
+        "      (the-as ottsel-a1-struct-method (make-structure allocation type-to-make)))))",
+        "ottsel-a1-structure-method");
+    bool runtime_tag_load = false;
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      // LDUR Wt,[Xn,#-4]: unscaled 32-bit load with imm9=-4; ignore Rt/Rn.
+      if ((w & 0xFFE00C00) == 0xB8400000 && (w & 0x001FF000) == 0x001FC000) {
+        runtime_tag_load = true;
+      }
+    }
+    check(!runtime_tag_load,
+          "fixed method-of-type after structure new does not load an untagged object type at -4");
+  } catch (const std::exception& e) {
+    check(false, (std::string("structure-method compile: ") + e.what()).c_str());
+  }
+
+  // 25. Real GOAL `logand` through the ARM64 codegen must emit the AND
+  //     instruction, not ADD.  Same defect class as the merc-ctrl eye-check:
+  //     the compiler selects AND_64 correctly; only the emitter is wrong.
+  try {
+    auto bytes = emit_function(compiler, "a1-logand",
+                               "(defun ottsel-a1-logand ((v int)) (logand -65536 v))",
+                               "ottsel-a1-logand");
+    bool has_and = false;
+    bool has_add = false;
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      const u32 op = w >> 21;
+      if (op == 0x450) has_and = true;  // AND shifted-register (64-bit)
+      if (op == 0x458) has_add = true;  // ADD shifted-register (64-bit)
+    }
+    check(has_and, "logand emits AND shifted-register (was ADD)");
+    check(!has_add, "logand emits no ADD shifted-register word");
+    if (!has_and || has_add) {
+      std::cout << "    logand bytes (" << bytes.size() << "):";
+      for (size_t i = 0; i < bytes.size(); i += 4) {
+        u32 w;
+        std::memcpy(&w, bytes.data() + i, 4);
+        std::cout << " " << std::hex << w << std::dec;
+      }
+      std::cout << "\n";
+    }
+  } catch (const std::exception& e) {
+    check(false, (std::string("logand compile: ") + e.what()).c_str());
+  }
+
+  // 26. GOAL asm-func `.load <reg>` (thread-suspend's continuation read)
+  //     must emit the NON-advancing `ldr reg, [sp]` on ARM64.  The call shim
+  //     pushed TWO 16-byte slots (incoming x30 + synthetic post-blr
+  //     continuation); thread-suspend saves sp pointing at the synthetic
+  //     slot so the resume's post-blr pops BOTH slots (restoring the
+  //     caller's x30 and sp).  An advancing pop (`ldr reg, [sp], #16`)
+  //     double-pops on resume: sp climbs +16 per dispatch, the observed
+  //     camera stack climb into the debug-dead-pool region (S2.1 cont 18).
+  try {
+    auto bytes = emit_function(compiler, "a1-loadsp",
+                               "(define-extern *kernel-sp* pointer)"
+                               "(defun ottsel-a1-loadsp ()"
+                               "  (declare (asm-func none))"
+                               "  (rlet ((temp :reg rax :type uint)"
+                               "         (sp :reg rsp :type uint)"
+                               "         (off :reg r15 :type uint))"
+                               "    (.load temp)"
+                               "    (.sub temp off)"
+                               "    (.sub sp off)"
+                               "    (.load-sym :sext #f sp *kernel-sp*)"
+                               "    (.add sp off)"
+                               "    (.ret))"
+                               "  (none))",
+                               "ottsel-a1-loadsp");
+    bool has_nonadv = false;  // ldr x0, [sp]          = 0xf94003e0
+    bool has_adv = false;     // ldr x0, [sp], #16     = 0xf84107e0
+    for (size_t i = 0; i + 4 <= bytes.size(); i += 4) {
+      u32 w;
+      std::memcpy(&w, bytes.data() + i, 4);
+      if (w == 0xf94003e0) has_nonadv = true;
+      if (w == 0xf84107e0) has_adv = true;
+    }
+    check(has_nonadv, ".load emits non-advancing ldr x0, [sp] (0xf94003e0)");
+    check(!has_adv, ".load never emits advancing ldr x0, [sp], #16 (0xf84107e0)");
+    if (!has_nonadv || has_adv) {
+      std::cout << "    loadsp bytes (" << bytes.size() << "):";
+      for (size_t i = 0; i < bytes.size(); i += 4) {
+        u32 w;
+        std::memcpy(&w, bytes.data() + i, 4);
+        std::cout << " " << std::hex << w << std::dec;
+      }
+      std::cout << "\n";
+    }
+  } catch (const std::exception& e) {
+    check(false, (std::string("loadsp compile: ") + e.what()).c_str());
+  }
+}
+
+int main() {
+  lg::set_stdout_level(lg::level::warn);
+  lg::set_flush_level(lg::level::warn);
+  lg::initialize();
+
+  if (!file_util::setup_project_path(std::nullopt)) {
+    std::cerr << "setup_project_path failed\n";
+    return 2;
+  }
+
+  try {
+    emitter_unit_tests();
+    goal_compile_tests();
+  } catch (const std::exception& e) {
+    std::cerr << "fatal: " << e.what() << "\n";
+    return 1;
+  }
+
+  if (g_fail) {
+    std::cerr << "[A1.0] FAIL: " << g_fail << " semantic assertion(s)\n";
+    return 1;
+  }
+  std::cout << "[A1.0] PASS all semantic regressions\n";
+  return 0;
+}
diff --git a/tools/ottsel_a1/subtitle_fn_dump.cpp b/tools/ottsel_a1/subtitle_fn_dump.cpp
new file mode 100644
index 000000000..0459eb2d6
--- /dev/null
+++ b/tools/ottsel_a1/subtitle_fn_dump.cpp
@@ -0,0 +1,108 @@
+// Ottsel S2.1 diagnostic: compile the subtitle/text GOAL sources through the
+// ARM64 goalc and print function name + code size + first words, so a live pc
+// can be mapped to a source function.
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "common/versions/versions.h"
+
+#include "goalc/compiler/CodeGenerator.h"
+#include "goalc/compiler/Compiler.h"
+#include "goalc/compiler/IR.h"
+#include "goalc/debugger/DebugInfo.h"
+#include "goalc/emitter/InstructionSet.h"
+#include "goalc/emitter/Register.h"
+
+using namespace emitter;
+
+int main(int argc, char** argv) {
+  lg::set_stdout_level(lg::level::warn);
+  lg::set_flush_level(lg::level::warn);
+  lg::initialize();
+
+  if (!file_util::setup_project_path(std::nullopt)) {
+    std::cerr << "setup_project_path failed\n";
+    return 2;
+  }
+
+  try {
+    Compiler compiler(GameVersion::Jak1, InstructionSet::ARM64);
+    RegisterInfo::set_active_instruction_set(InstructionSet::ARM64);
+
+    // Order matters: rpc-h defines rpc-buffer-pair before load-dgo uses it,
+    // and the kernel headers must come first (the game project compiles the
+    // kernel group before the engine).  Mirror game.gp's ordering for the
+    // subtitle dependency chain only.
+    std::vector<std::pair<const char*, const char*>> files = {
+        {"goal_src/jak1/kernel/gcommon.gc", "gcommon"},
+        {"goal_src/jak1/kernel/gstring-h.gc", "gstring-h"},
+        {"goal_src/jak1/kernel/gkernel-h.gc", "gkernel-h"},
+        {"goal_src/jak1/kernel/gkernel.gc", "gkernel"},
+        {"goal_src/jak1/kernel/pskernel.gc", "pskernel"},
+        {"goal_src/jak1/kernel/gstring.gc", "gstring"},
+        {"goal_src/jak1/kernel/dgo-h.gc", "dgo-h"},
+        {"goal_src/jak1/kernel/gstate.gc", "gstate"},
+        {"goal_src/jak1/engine/math/vector-h.gc", "vector-h"},
+        {"goal_src/jak1/engine/util/types-h.gc", "types-h"},
+        {"goal_src/jak1/engine/ps2/rpc-h.gc", "rpc-h"},
+        {"goal_src/jak1/engine/gfx/hw/display-h.gc", "display-h"},
+        {"goal_src/jak1/engine/load/decomp-h.gc", "decomp-h"},
+        {"goal_src/jak1/pc/pckernel-h.gc", "pckernel-h"},
+        {"goal_src/jak1/engine/sound/gsound-h.gc", "gsound-h"},
+        {"goal_src/jak1/engine/load/load-dgo.gc", "load-dgo"},
+        {"goal_src/jak1/engine/load/loader-h.gc", "loader-h"},
+        {"goal_src/jak1/engine/sound/gsound.gc", "gsound"},
+        {"goal_src/jak1/engine/ui/text.gc", "text"},
+        {"goal_src/jak1/pc/pckernel.gc", "pckernel"},
+        {"goal_src/jak1/pc/subtitle.gc", "subtitle"},
+    };
+    const char* target = argc > 1 ? argv[1] : "goal_src/jak1/pc/subtitle.gc";
+    std::vector<FunctionEnv*> target_fns;
+    FileEnv* target_fe = nullptr;
+    std::string target_obj = "subtitle";
+    for (auto& [file, obj_name] : files) {
+      auto obj = compiler.get_goos().reader.read_from_file({file});
+      auto* fe = compiler.compile_object_file(obj_name, obj, true);
+      compiler.color_only_for_proof(fe);
+      if (std::string(file) == target) {
+        target_fe = fe;
+        target_obj = obj_name;
+        for (auto& f : fe->functions()) {
+          target_fns.push_back(f.get());
+        }
+      }
+    }
+
+    auto* debug = &compiler.get_debugger().get_debug_info_for_object(target_obj);
+
+    u32 off = 0;
+    for (auto* f : target_fns) {
+      debug->clear();
+      size_t code_size = 0;
+      std::vector<u8> bytes;
+      try {
+        CodeGenerator gen(target_fe, debug, GameVersion::Jak1, InstructionSet::ARM64);
+        bytes = gen.emit_function_machine_code(f, 0);
+        code_size = bytes.size();
+      } catch (const std::exception&) {
+        code_size = 0;
+      }
+      std::cout << "OFF " << std::hex << off << std::dec << " " << f->name() << " size=" << code_size;
+      if (bytes.size() >= 4) {
+        u32 w0;
+        std::memcpy(&w0, bytes.data(), 4);
+        std::cout << " w0=0x" << std::hex << w0 << std::dec;
+      }
+      std::cout << "\n";
+      off += (u32)code_size;
+    }
+  } catch (const std::exception& e) {
+    std::cerr << "exception: " << e.what() << "\n";
+    return 3;
+  }
+  return 0;
+}
diff --git a/tools/ottsel_a1/thread_off_test.cpp b/tools/ottsel_a1/thread_off_test.cpp
