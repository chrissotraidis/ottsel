+  // from a previous stub on the same page).
+  const uintptr_t page = (uintptr_t)sysconf(_SC_PAGESIZE);
+  uintptr_t lo = (uintptr_t)(::g_ee_main_mem + off) & ~(page - 1);
+  uintptr_t hi = ((uintptr_t)(::g_ee_main_mem + off + OTTSEL_STUB_SLOT) + page - 1) & ~(page - 1);
