diff --git a/test/test_macos_audio_policy.cpp b/test/test_macos_audio_policy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b9f8ce6cf3406948701a83f2a14dde40bb1edd23
--- /dev/null
+++ b/test/test_macos_audio_policy.cpp
@@ -0,0 +1,43 @@
+#include <fstream>
+#include <string>
+
+#include "common/util/FileUtil.h"
+#include "gtest/gtest.h"
+
+TEST(MacHostAudioPolicy, UsesOutputOnlySDLPlayback) {
+  const auto path = file_util::get_file_path({"game/sound/989snd/player.cpp"});
+  std::ifstream stream(path);
+  ASSERT_TRUE(stream) << path;
+
+  const std::string source((std::istreambuf_iterator<char>(stream)), {});
+  EXPECT_NE(source.find("SDL_HINT_AUDIO_CATEGORY, \"playback\""), std::string::npos);
+  EXPECT_NE(source.find("SDL_AUDIO_COREAUDIO_PLAYBACK_ONLY"), std::string::npos);
+  EXPECT_NE(source.find("SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK"), std::string::npos);
+  EXPECT_NE(source.find("OTTSEL_AUDIO_OUTPUT_DEVICE"), std::string::npos);
+  EXPECT_NE(source.find("SDL_OpenAudioDeviceStream"), std::string::npos);
+  EXPECT_EQ(source.find("SDL_AUDIO_DEVICE_DEFAULT_RECORDING"), std::string::npos);
+
+  const auto coreaudio_path = file_util::get_file_path({"third-party/SDL/src/audio/coreaudio/SDL_coreaudio.m"});
+  std::ifstream coreaudio_stream(coreaudio_path);
+  ASSERT_TRUE(coreaudio_stream) << coreaudio_path;
+  const std::string coreaudio_source((std::istreambuf_iterator<char>(coreaudio_stream)), {});
+  EXPECT_NE(coreaudio_source.find("SDL_AUDIO_COREAUDIO_PLAYBACK_ONLY"), std::string::npos);
+  EXPECT_NE(coreaudio_source.find("COREAUDIO_PlaybackOnly() ? 1 : 2"), std::string::npos);
+  EXPECT_NE(coreaudio_source.find("if (!COREAUDIO_PlaybackOnly())"), std::string::npos);
+
+  const auto main_path = file_util::get_file_path({"game/main.cpp"});
+  std::ifstream main_stream(main_path);
+  ASSERT_TRUE(main_stream) << main_path;
+  const std::string main_source((std::istreambuf_iterator<char>(main_stream)), {});
+  EXPECT_EQ(main_source.find("OTTSEL_ENABLE_HOST_AUDIO"), std::string::npos);
+}
+
+TEST(MacHostAudioPolicy, VAGDiagnosticVoiceUsesBoundedVolumeAndEndGuard) {
+  const auto path = file_util::get_file_path({"game/sound/sndshim.cpp"});
+  std::ifstream stream(path);
+  ASSERT_TRUE(stream) << path;
+  const std::string source((std::istreambuf_iterator<char>(stream)), {});
+  EXPECT_NE(source.find("vag_probe_voice->SetVolume(0x3fff, 0x3fff)"), std::string::npos);
+  EXPECT_NE(source.find("SetSampleLength((u32)vag_probe_sample.size())"), std::string::npos);
+  EXPECT_NE(source.find("vag_probe_sample.size() - 8"), std::string::npos);
+}
diff --git a/test/test_platform_input.cpp b/test/test_platform_input.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8cb5b8f34fae749f19e2b2d9a244cdbc4963e9bd
--- /dev/null
+++ b/test/test_platform_input.cpp
@@ -0,0 +1,184 @@
+#include "game/sce/ottsel_platform_input.h"
+#include "game/sce/ottsel_stream_clock.h"
+#include "../../../src/shell/mobile_generic_policy.h"
+#include "../../../src/shell/mobile_scene_policy.h"
+#include "../../../src/shell/mobile_snapshot_store.h"
+
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+#include "gtest/gtest.h"
+
+TEST(PlatformInput, CarriesCanonicalButtonsPressureAndNeutralState) {
+  using namespace ottsel::platform_input;
+  clear_all_pad_states();
+
+  PadState state;
+  state.leftx = 0;
+  state.righty = 255;
+  set_button(&state, Cross, true);
+  set_button(&state, Start, true);
+  set_pad_state(0, state);
+
+  const auto sampled = get_pad_state(0);
+  EXPECT_EQ(sampled.leftx, 0);
+  EXPECT_EQ(sampled.lefty, 127);
+  EXPECT_EQ(sampled.righty, 255);
+  EXPECT_EQ(sampled.buttons, Cross | Start);
+  EXPECT_EQ(sampled.pressure.at(6), 255);
+
+  clear_pad_state(0);
+  const auto neutral = get_pad_state(0);
+  EXPECT_EQ(neutral.leftx, 127);
+  EXPECT_EQ(neutral.lefty, 127);
+  EXPECT_EQ(neutral.rightx, 127);
+  EXPECT_EQ(neutral.righty, 127);
+  EXPECT_EQ(neutral.buttons, 0);
+  EXPECT_EQ(neutral.pressure.at(6), 0);
+}
+
+TEST(PlatformInput, LatchesBriefDigitalPressAcrossPadReads) {
+  using namespace ottsel::platform_input;
+  clear_all_pad_states();
+
+  latch_button(0, Start, 2);
+  const auto first = get_pad_state(0);
+  const auto second = get_pad_state(0);
+  const auto released = get_pad_state(0);
+
+  EXPECT_EQ(first.buttons, Start);
+  EXPECT_EQ(second.buttons, Start);
+  EXPECT_EQ(released.buttons, 0);
+}
+
+TEST(PlatformInput, NativeTapLatchSurvivesSlowGoalPoll) {
+  using namespace ottsel::platform_input;
+  clear_all_pad_states();
+
+  latch_native_button(0, Start);
+  for (int i = 0; i < kNativeDigitalLatchPadReads - 1; ++i) {
+    EXPECT_EQ(get_pad_state(0).buttons, Start);
+  }
+  EXPECT_EQ(get_pad_state(0).buttons, Start);
+  EXPECT_EQ(get_pad_state(0).buttons, 0);
+}
+
+TEST(PlatformInput, StreamClockAdvancesCutsceneTimelineWithoutAnIop) {
+  using namespace std::chrono_literals;
+  ottsel::stream_clock::Clock clock;
+  const auto start = ottsel::stream_clock::Clock::TimePoint{};
+
+  EXPECT_FALSE(clock.snapshot(start).playing);
+  clock.play(0x10001, start);
+  EXPECT_EQ(clock.snapshot(start + 500ms).position, 512);
+  EXPECT_EQ(clock.snapshot(start + 2s).position, 2048);
+  EXPECT_EQ(clock.snapshot(start + 2s).id, 0x10001);
+  clock.stop();
+  EXPECT_EQ(clock.snapshot(start + 3s).position, -1);
+}
+
+TEST(PlatformInput, RemapOwnershipRejectsSentinelAndStaleInstances) {
+  using namespace ottsel::platform_input;
+  EXPECT_FALSE(owns_gamepad_event(0, 0));
+  EXPECT_FALSE(owns_gamepad_event(0, 7));
+  EXPECT_FALSE(owns_gamepad_event(3, 7));
+  EXPECT_TRUE(owns_gamepad_event(3, 3));
+}
+
+TEST(PlatformInput, SynthesizedTouchMouseStaysOnTouchPath) {
+  using namespace ottsel::platform_input;
+  constexpr u32 touch_mouse_id = 0xffffffffu;
+  EXPECT_FALSE(routes_to_native_mouse(touch_mouse_id, touch_mouse_id));
+  EXPECT_TRUE(routes_to_native_mouse(0, touch_mouse_id));
+  EXPECT_TRUE(routes_to_native_mouse(7, touch_mouse_id));
+}
+
+TEST(PlatformInput, MobileSceneSnapshotStaysStableAcrossCameraMotion) {
+  EXPECT_FALSE(ottsel_mobile_scene_snapshot_needs_rebuild(true, false, true));
+  EXPECT_TRUE(ottsel_mobile_scene_snapshot_needs_rebuild(false, false, false));
+  EXPECT_TRUE(ottsel_mobile_scene_snapshot_needs_rebuild(true, true, false));
+}
+
+TEST(PlatformInput, MobileSceneTexturesKeepLevelLocalIdsDisjoint) {
+  EXPECT_EQ(ottsel_mobile_scene_texture_slot(0, 7), 7);
+  EXPECT_EQ(ottsel_mobile_scene_texture_slot(128, 7), 135);
+  EXPECT_EQ(ottsel_mobile_scene_texture_slot(128, -1), -1);
+}
+
+TEST(PlatformInput, MobileProductionTelemetryStopsAtItsBudget) {
+  EXPECT_TRUE(ottsel_mobile_log_within_budget(0, 8));
+  EXPECT_TRUE(ottsel_mobile_log_within_budget(7, 8));
+  EXPECT_FALSE(ottsel_mobile_log_within_budget(8, 8));
+  EXPECT_FALSE(ottsel_mobile_log_within_budget(1000, 8));
+}
+
+TEST(PlatformInput, MobileDmaTailScansGameplayPacketsWithoutExtendingFullDecode) {
+  EXPECT_TRUE(ottsel_mobile_dma_decode_can_continue(false, 511));
+  EXPECT_FALSE(ottsel_mobile_dma_decode_can_continue(false, 512));
+  EXPECT_TRUE(ottsel_mobile_pc_port_scan_can_continue(false, 512));
+  EXPECT_TRUE(ottsel_mobile_pc_port_scan_can_continue(false, 4095));
+  EXPECT_FALSE(ottsel_mobile_pc_port_scan_can_continue(false, 4096));
+  EXPECT_FALSE(ottsel_mobile_pc_port_scan_can_continue(true, 0));
+}
+
+TEST(PlatformInput, MobileGenericDecoderOwnsOnlyJak1GenericBuckets) {
+  EXPECT_TRUE(ottsel_mobile_is_jak1_generic_bucket(11));
+  EXPECT_TRUE(ottsel_mobile_is_jak1_generic_bucket(46));
+  EXPECT_TRUE(ottsel_mobile_is_jak1_generic_bucket(62));
+  EXPECT_FALSE(ottsel_mobile_is_jak1_generic_bucket(10));
+  EXPECT_FALSE(ottsel_mobile_is_jak1_generic_bucket(45));
+  EXPECT_FALSE(ottsel_mobile_is_jak1_generic_bucket(66));
+
+  EXPECT_EQ(ottsel_mobile_jak1_bucket_boundary(0x1000, 0), 0x1010u);
+  EXPECT_EQ(ottsel_mobile_jak1_bucket_boundary(0x1000, 11), 0x10c0u);
+}
+
+TEST(PlatformInput, MobileMetalUploadsUseStableResourceSnapshots) {
+  struct Batch {
+    int id;
+    bool persistent;
+  };
+  OttselMobileSnapshotStore<Batch> store;
+  store.append({1, false});
+  store.append({2, true});
+
+  const auto encoding_snapshot = store.snapshot();
+  store.erase_if([](const Batch& batch) { return !batch.persistent; });
+  store.mutate_last([](Batch& batch) { batch.id = 3; });
+
+  ASSERT_EQ(encoding_snapshot.size(), 2u);
+  EXPECT_EQ(encoding_snapshot[0].id, 1);
+  EXPECT_EQ(encoding_snapshot[1].id, 2);
+  const auto next_frame = store.snapshot();
+  ASSERT_EQ(next_frame.size(), 1u);
+  EXPECT_EQ(next_frame[0].id, 3);
+}
+
+TEST(PlatformInput, ConcurrentHostAndGoalSnapshotsRemainValid) {
+  using namespace ottsel::platform_input;
+  clear_all_pad_states();
+
+  std::atomic<bool> start{false};
+  std::thread host([&] {
+    while (!start.load(std::memory_order_acquire)) {
+    }
+    for (int i = 0; i < 10000; ++i) {
+      PadState state;
+      state.leftx = static_cast<u8>(i & 255);
+      set_pad_state(0, state);
+    }
+  });
+  std::thread goal([&] {
+    while (!start.load(std::memory_order_acquire)) {
+    }
+    for (int i = 0; i < 10000; ++i) {
+      const auto state = get_pad_state(0);
+      EXPECT_GE(state.leftx, 0);
+      EXPECT_LE(state.leftx, 255);
+    }
+  });
+  start.store(true, std::memory_order_release);
+  host.join();
+  goal.join();
+}
