@@ -0,0 +1,44 @@
+#include <array>
+
+#include "game/graphics/opengl_renderer/SkyBlendCPU.h"
+#include "gtest/gtest.h"
+
+TEST(SkyBlendCPU, ScaledCopyAndSaturatingAccumulate) {
+  const std::array<u8, 8> input = {0, 1, 2, 127, 128, 200, 254, 255};
+  std::array<u8, input.size()> output = {};
+
+  blend_sky_initial_fast(64, output.data(), input.data(), input.size());
+  EXPECT_EQ(output, (std::array<u8, input.size()>{0, 0, 1, 63, 64, 100, 127, 127}));
+
+  blend_sky_fast(128, output.data(), input.data(), input.size());
+  EXPECT_EQ(output, (std::array<u8, input.size()>{0, 1, 3, 190, 192, 255, 255, 255}));
+}
+
+TEST(SkyBlendCPU, RejectsMissingOrPlaceholderSourceBytes) {
+  GpuTexture missing;
+  missing.w = 32;
+  missing.h = 32;
+  std::vector<u8> output = {1, 2, 3};
+  EXPECT_FALSE(copy_gpu_texture_data(missing, output));
+  EXPECT_TRUE(output.empty());
+
+  GpuTexture placeholder;
+  placeholder.w = 32;
+  placeholder.h = 32;
+  placeholder.is_placeholder = true;
+  output = {4, 5, 6};
+  EXPECT_FALSE(copy_gpu_texture_data(placeholder, output));
+  EXPECT_TRUE(output.empty());
+}
+
+TEST(SkyBlendCPU, CopiesOwnedSourceBytesExactly) {
+  const std::array<u8, 4> source = {9, 8, 7, 6};
+  GpuTexture texture;
+  texture.w = 1;
+  texture.h = 1;
+  texture.gpu_textures.push_back({0, source.data()});
+
+  std::vector<u8> output;
+  ASSERT_TRUE(copy_gpu_texture_data(texture, output));
+  EXPECT_EQ(output, std::vector<u8>(source.begin(), source.end()));
+}
