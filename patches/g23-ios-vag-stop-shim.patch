+void snd_StopVAGProbeShared() {
+  std::scoped_lock lock(player_lifecycle_mutex);
+  if (vag_probe_voice) {
+    // Hard stop: a stopped stream must not keep playing over what comes next (a skipped cutscene).  The
+    // sample buffer is not freed here - the caller owns it and keeps it alive for the voice.
+    vag_probe_voice->Stop();
+    vag_probe_voice.reset();
+  }
+  vag_probe_shared_sample.reset();
+}
