--- a/goal_src/jak1/engine/load/loader.gc
+++ b/goal_src/jak1/engine/load/loader.gc
@@ -715,6 +715,21 @@
                               (-> arg0 name) spool-part (-> b other index))
                       (set-pending-file (-> b other) (the-as string #f) -1 (the-as handle #f) SPOOL_PRIORITY_LOWEST)
                       (update (-> b other)))
+                    ;; Ottsel G2.3 (2026-09-23): the other stuck shape.  A buffer whose art has loaded sits
+                    ;; at 'locked until external-art-control::update promotes it to 'active, and that promotion
+                    ;; needs a *live* owner process.  When the owner dies while the buffer still holds a part
+                    ;; that another stream is waiting for, nothing ever releases it: measured at the intro
+                    ;; cutscene, where b1 held sage-intro-sequence-a/0 as 'locked with locked? #f and owner
+                    ;; sequenceA-village1 while ja-play-spooled-anim waited, so the sequence aborted and the
+                    ;; camera never took over.  Drop the file so the buffer can go 'inactive and the partner
+                    ;; can take our part.
+                    (when (and (= (-> b status) 'locked)
+                               (not (-> b locked?))
+                               (not (handle->process (-> b load-file-owner))))
+                      (format 0 "OTTSEL SPOOL RECOVER: name=~A part=~D evict-dead-owner-buf=~D~%"
+                              (-> arg0 name) spool-part (-> b index))
+                      (set-pending-file b (the-as string #f) -1 (the-as handle #f) SPOOL_PRIORITY_LOWEST)
+                      (update b)))))
               (format #t "STALL-ART ~S ~D fs=~A,~A" (-> arg0 name) spool-part
                       (file-status (-> *art-control* buffer 0) (-> arg0 name) spool-part)
                       (file-status (-> *art-control* buffer 1) (-> arg0 name) spool-part))
@@ -735,6 +750,7 @@
                 (str-play-async (-> arg0 name) spool-sound)
                 (set! (-> *art-control* active-stream) (-> arg0 name))
                 (format 0 "OTTSEL SPOOL: start name=~A sound-enabled=~A stream-id=~D initial-pos=~D~%"
