+  if (pressure_index != PadData::PressureIndex::INVALID_PRESSURE) {
+    data->pressure_data.at(pressure_index) = 255;
+  }
+  m_active_actions.push_back(
+      {sdl_mouse_button,
+       bind,
+       false,
+       [](std::shared_ptr<PadData> active_data, InputBinding active_bind) {
+         active_data->button_data.at(active_bind.pad_data_index) = false;
+         const auto active_pressure = active_data->button_index_to_pressure_index(
+             static_cast<PadData::ButtonIndex>(active_bind.pad_data_index));
+         if (active_pressure != PadData::PressureIndex::INVALID_PRESSURE) {
+           active_data->pressure_data.at(active_pressure) = 0;
+         }
+       },
+       event_latched ? 8 : 0});
+}
