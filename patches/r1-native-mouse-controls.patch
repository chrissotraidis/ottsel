diff --git a/test/test_keyboard_event_edge.cpp b/test/test_keyboard_event_edge.cpp
new file mode 100644
--- /dev/null
+++ b/test/test_keyboard_event_edge.cpp
@@ -0,0 +1,133 @@
+#include <memory>
+
+#include "game/settings/settings.h"
+#include "game/sce/ottsel_platform_input.h"
+#include "game/system/hid/devices/keyboard.h"
+#include "gtest/gtest.h"
+
+TEST(KeyboardEventEdge, DeliversBriefCrossPressToPadState) {
+  auto settings = std::make_shared<game_settings::InputSettings>();
+  settings->keyboard_binds = DEFAULT_KEYBOARD_BINDS;
+  KeyboardDevice keyboard(settings);
+  auto data = std::make_shared<PadData>();
+  CommandBindingGroups commands;
+  std::optional<InputBindAssignmentMeta> bind_assignment;
+
+  SDL_Event event{};
+  event.type = SDL_EVENT_KEY_DOWN;
+  event.key.type = SDL_EVENT_KEY_DOWN;
+  event.key.key = SDLK_SPACE;
+  event.key.mod = 0;
+  keyboard.process_event(event, commands, data, bind_assignment);
+
+  EXPECT_TRUE(data->cross().first);
+  EXPECT_EQ(data->cross().second, 255);
+
+  keyboard.clear_actions(data);
+  EXPECT_FALSE(data->cross().first);
+  EXPECT_EQ(data->cross().second, 0);
+}
+
+TEST(KeyboardEventEdge, WASDUsesOpposingAnalogDirections) {
+  auto settings = std::make_shared<game_settings::InputSettings>();
+  settings->keyboard_binds = DEFAULT_KEYBOARD_BINDS;
+  KeyboardDevice keyboard(settings);
+  auto data = std::make_shared<PadData>();
+  CommandBindingGroups commands;
+  std::optional<InputBindAssignmentMeta> bind_assignment;
+
+  SDL_Event event{};
+  event.type = SDL_EVENT_KEY_DOWN;
+  event.key.type = SDL_EVENT_KEY_DOWN;
+  event.key.key = SDLK_W;
+  keyboard.process_event(event, commands, data, bind_assignment);
+  event.key.key = SDLK_A;
+  keyboard.process_event(event, commands, data, bind_assignment);
+
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_X), 0);
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_Y), 0);
+
+  keyboard.clear_actions(data);
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_X), 127);
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_Y), 127);
+}
+
+TEST(KeyboardEventEdge, DefaultDesktopLayoutSupportsMovementActionAndPause) {
+  const auto& binds = DEFAULT_KEYBOARD_BINDS;
+  ASSERT_EQ(binds.buttons.at(SDLK_SPACE).front().pad_data_index,
+            PadData::ButtonIndex::CROSS);
+  ASSERT_EQ(binds.buttons.at(SDLK_E).front().pad_data_index,
+            PadData::ButtonIndex::CIRCLE);
+  ASSERT_EQ(binds.buttons.at(SDLK_F).front().pad_data_index,
+            PadData::ButtonIndex::SQUARE);
+  ASSERT_EQ(binds.buttons.at(SDLK_R).front().pad_data_index,
+            PadData::ButtonIndex::TRIANGLE);
+  ASSERT_EQ(binds.buttons.at(SDLK_RETURN).front().pad_data_index,
+            PadData::ButtonIndex::START);
+  EXPECT_EQ(binds.buttons.at(SDLK_ESCAPE).front().pad_data_index,
+            PadData::ButtonIndex::START);
+  EXPECT_EQ(binds.buttons.at(SDLK_TAB).front().pad_data_index,
+            PadData::ButtonIndex::SELECT);
+}
+
+TEST(KeyboardEventEdge, SimultaneousMovementAndActionReturnsToNeutral) {
+  auto settings = std::make_shared<game_settings::InputSettings>();
+  settings->keyboard_binds = DEFAULT_KEYBOARD_BINDS;
+  KeyboardDevice keyboard(settings);
+  auto data = std::make_shared<PadData>();
+  CommandBindingGroups commands;
+  std::optional<InputBindAssignmentMeta> bind_assignment;
+
+  SDL_Event event{};
+  event.type = SDL_EVENT_KEY_DOWN;
+  event.key.type = SDL_EVENT_KEY_DOWN;
+  event.key.mod = 0;
+  event.key.key = SDLK_W;
+  keyboard.process_event(event, commands, data, bind_assignment);
+  event.key.key = SDLK_SPACE;
+  keyboard.process_event(event, commands, data, bind_assignment);
+
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_Y), 0);
+  EXPECT_TRUE(data->cross().first);
+  EXPECT_EQ(data->cross().second, 255);
+
+  keyboard.clear_actions(data);
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_X), 127);
+  EXPECT_EQ(data->analog_data.at(PadData::AnalogIndex::LEFT_Y), 127);
+  EXPECT_FALSE(data->cross().first);
+  EXPECT_EQ(data->cross().second, 0);
+}
+
+TEST(KeyboardEventEdge, DefaultMouseButtonsMapToFaceActions) {
+  const auto left = DEFAULT_MOUSE_BINDS.buttons.at(SDL_BUTTON_LEFT);
+  const auto right = DEFAULT_MOUSE_BINDS.buttons.at(SDL_BUTTON_RIGHT);
+  ASSERT_EQ(left.size(), 1);
+  ASSERT_EQ(right.size(), 1);
+  EXPECT_EQ(left.front().pad_data_index, PadData::ButtonIndex::CROSS);
+  EXPECT_EQ(right.front().pad_data_index, PadData::ButtonIndex::CIRCLE);
+}
+
+TEST(KeyboardEventEdge, MouseMotionSurvivesEventLoopUntilPadRead) {
+  ottsel::platform_input::MouseMotionLatch motion;
+  motion.add(4.f, -2.f);
+  EXPECT_EQ(motion.rightx, 159);
+  EXPECT_EQ(motion.righty, 111);
+  EXPECT_EQ(motion.remaining_reads, 8);
+
+  for (int i = 0; i < 7; ++i) {
+    motion.advance_event_loop();
+    EXPECT_NE(motion.rightx, 127);
+  }
+  motion.advance_event_loop();
+  EXPECT_EQ(motion.rightx, 127);
+  EXPECT_EQ(motion.righty, 127);
+}
+
+TEST(KeyboardEventEdge, AccumulatesMouseMotionBeforePadRead) {
+  ottsel::platform_input::MouseMotionLatch motion;
+  motion.add(2.f, -1.f);
+  motion.add(3.f, -2.f);
+
+  EXPECT_EQ(motion.rightx, 167);
+  EXPECT_EQ(motion.righty, 103);
+  EXPECT_EQ(motion.remaining_reads, 8);
+}
diff --git a/game/sce/ottsel_platform_input.h b/game/sce/ottsel_platform_input.h
new file mode 100644
index 000000000..969886f99
--- /dev/null
+++ b/game/sce/ottsel_platform_input.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+
+#include "common/common_types.h"
+
+// A platform-neutral snapshot of the DualShock 2 data consumed by scePadRead.
+// Desktop SDL input reaches the same wire format through PadData; mobile hosts
+// use this small bridge because they do not create the desktop Display object.
+namespace ottsel::platform_input {
+
+enum Button : u16 {
+  Select = 1u << 0,
+  L3 = 1u << 1,
+  R3 = 1u << 2,
+  Start = 1u << 3,
+  DpadUp = 1u << 4,
+  DpadRight = 1u << 5,
+  DpadDown = 1u << 6,
+  DpadLeft = 1u << 7,
+  L2 = 1u << 8,
+  R2 = 1u << 9,
+  L1 = 1u << 10,
+  R1 = 1u << 11,
+  Triangle = 1u << 12,
+  Circle = 1u << 13,
+  Cross = 1u << 14,
+  Square = 1u << 15,
+};
+
+struct PadState {
+  u8 leftx = 127;
+  u8 lefty = 127;
+  u8 rightx = 127;
+  u8 righty = 127;
+  u16 buttons = 0;
+  std::array<u8, 12> pressure{};
+};
+
+// Mouse motion arrives on the SDL/UI thread while scePadRead samples on the
+// EE thread. Keep a camera impulse alive for the same bounded window used by
+// digital tap edges instead of dropping it at the end of one event-loop pass.
+struct MouseMotionLatch {
+  u8 rightx = 127;
+  u8 righty = 127;
+  int remaining_reads = 0;
+
+  void add(float xrel, float yrel, int pad_reads = 8) {
+    const int accumulated_x = static_cast<int>(rightx) - 127 + static_cast<int>(xrel * 8.f);
+    const int accumulated_y = static_cast<int>(righty) - 127 + static_cast<int>(yrel * 8.f);
+    rightx = static_cast<u8>(std::clamp(127 + accumulated_x, 0, 255));
+    righty = static_cast<u8>(std::clamp(127 + accumulated_y, 0, 255));
+    remaining_reads = std::max(remaining_reads, pad_reads);
+  }
+
+  void advance_event_loop() {
+    if (remaining_reads > 0 && --remaining_reads == 0) {
+      rightx = 127;
+      righty = 127;
+    }
+  }
+};
+
+// SDL instance IDs are the ownership key for the selected pad-0 controller.
+// Zero is the shell's no-owner sentinel and must never match an event.
+constexpr bool owns_gamepad_event(s32 selected_instance, s32 event_instance) {
+  return selected_instance != 0 && selected_instance == event_instance;
+}
+
+// The UI thread may update a state while the GOAL thread samples it.  The
+// bridge snapshots it atomically at the API boundary; callers never retain a
+// mutable reference to the shared state.
+void set_pad_state(int port, const PadState& state);
+PadState get_pad_state(int port);
+// Keep a short digital edge alive across the asynchronous host/UI and EE
+// polling boundary. This is for event-driven keyboard taps; held input stays
+// in PadState and is unaffected.
+void latch_button(int port, Button button, int pad_reads);
+void clear_pad_state(int port);
+void clear_all_pad_states();
+
+// Digital keyboard/gamepad/touch actions use full DualShock pressure for
+// pressure-aware GOAL paths, exactly as the desktop keyboard mapping does.
+void set_button(PadState* state, Button button, bool pressed);
+
+}  // namespace ottsel::platform_input
