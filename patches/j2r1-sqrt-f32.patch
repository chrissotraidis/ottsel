new file mode 100644
index 00000000..4a3e79c
--- /dev/null
+++ b/test/test_arm64_sqrt.cpp
@@ -0,0 +1,20 @@
+#include "emitter_util.h"
+
+#include "goalc/emitter/CodeTester.h"
+#include "goalc/emitter/IGen.h"
+#include "gtest/gtest.h"
+
+using namespace emitter;
+
+TEST(ARM64EmitterFloatMath, sqrt_f32UsesDistinctDestinationRegister) {
+  CodeTester tester(InstructionSet::ARM64);
+  tester.init_code_buffer(256);
+
+  const auto gen = tester.generator();
+  tester.emit(IGen::mov_gpr64_u64(gen, X0, 0x40800000ull));
+  tester.emit(IGen::movd_f32_gpr32(gen, V3, X0));
+  tester.emit(IGen::sqrt_f32(gen, V7, V3));
+  tester.emit(IGen::movd_gpr32_f32(gen, X0, V7));
+  tester.emit_return();
+
+  execute_ret_tester(tester, 0, 0, 0, 0, 2.0f);
+}
