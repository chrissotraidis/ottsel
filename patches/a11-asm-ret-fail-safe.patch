+/*!
+ * ARM64 in-place 16-bit word permutation of one half of a vector register
+ * (VPSHUFLW/VPSHUFHW): word (base + i) of `reg` becomes word
+ * (base + ((imm >> (2*i)) & 3)) of the original value, for i in 0..3.
+ * Uses the reserved X16/X17 scratch GPRs.  A cycle rotation is sufficient
+ * only for a bijection; VPSHUFLW/HW also allow duplicated selectors.
+ */
+void rotate_vf_words_arm64(emitter::ObjectGenerator* gen,
+                           emitter::IR_Record irec,
+                           emitter::Register reg,
+                           u8 imm,
+                           int base) {
+  u8 sel[4];
+  for (int i = 0; i < 4; i++) {
+    sel[i] = (imm >> (2 * i)) & 3;
+  }
+
+  // `.ppach` lowers through the duplicate selector mask 0x88: [0, 2, 0, 2].
+  // Preserve its two source lanes before modifying either destination.  The
+  // former cycle implementation treated this as a permutation and produced
+  // [w0, w2, w1, w3], which zeroed the red/green time-of-day weights.
+  if (imm == 0x88) {
+    gen->add_instr(IGen::ARM64::umov_gpr32_vf_h_element(emitter::X16, reg, base), irec);
+    gen->add_instr(IGen::ARM64::umov_gpr32_vf_h_element(emitter::X17, reg, base + 2), irec);
+    gen->add_instr(IGen::ARM64::ins_vf_h_element_gpr32(reg, base, emitter::X16), irec);
+    gen->add_instr(IGen::ARM64::ins_vf_h_element_gpr32(reg, base + 1, emitter::X17), irec);
+    gen->add_instr(IGen::ARM64::ins_vf_h_element_gpr32(reg, base + 2, emitter::X16), irec);
+    gen->add_instr(IGen::ARM64::ins_vf_h_element_gpr32(reg, base + 3, emitter::X17), irec);
+    return;
+  }
+
+  // Remaining callers use permutations, for which an in-place cycle is safe.
+  bool seen_source[4] = {};
+  for (const auto source : sel) {
+    ASSERT_MSG(!seen_source[source], "non-bijective ARM64 VPSHUF mask needs an explicit lowering");
+    seen_source[source] = true;
+  }
+  bool visited[4] = {};
+  for (int i = 0; i < 4; i++) {
+    if (visited[i] || sel[i] == i) {
+      visited[i] = true;
+      continue;
+    }
+    std::vector<int> cycle;
+    int cur = i;
+    while (!visited[cur]) {
+      visited[cur] = true;
+      cycle.push_back(cur);
+      cur = sel[cur];
+    }
+    gen->add_instr(IGen::ARM64::umov_gpr32_vf_h_element(emitter::X16, reg, base + cycle[0]), irec);
+    for (size_t j = 1; j < cycle.size(); j++) {
+      gen->add_instr(IGen::ARM64::umov_gpr32_vf_h_element(emitter::X17, reg, base + cycle[j]),
+                     irec);
+      gen->add_instr(IGen::ARM64::ins_vf_h_element_gpr32(reg, base + cycle[j], emitter::X16), irec);
+      gen->add_instr(IGen::mov_gpr64_gpr64(*gen, emitter::X16, emitter::X17), irec);
+    }
+    gen->add_instr(IGen::ARM64::ins_vf_h_element_gpr32(reg, base + cycle[0], emitter::X16), irec);
+  }
+}
