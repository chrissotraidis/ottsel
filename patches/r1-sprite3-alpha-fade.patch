diff --git a/common/dma/ottsel_sprite_math.h b/common/dma/ottsel_sprite_math.h
new file mode 100644
index 00000000..a6d4d5b
--- /dev/null
+++ b/common/dma/ottsel_sprite_math.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <algorithm>
+
+namespace ottsel {
+
+// Jak 1's Sprite3 shader fades a sprite by its projected area before the
+// final color multiplier. Keep this shared so native Metal and its fixture
+// regression use the same bounded arithmetic.
+inline float sprite3_faded_alpha(float alpha, float sx, float sy, float inv_area) {
+  const float area_fade = std::clamp(sx * sy * inv_area, 0.f, 1.f);
+  return std::clamp(alpha * area_fade, 0.f, 255.f);
+}
+
+}  // namespace ottsel
