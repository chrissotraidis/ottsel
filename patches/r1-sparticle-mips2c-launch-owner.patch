diff --git a/game/mips2c/jak1_functions/sparticle_launcher.cpp b/game/mips2c/jak1_functions/sparticle_launcher.cpp
--- a/game/mips2c/jak1_functions/sparticle_launcher.cpp
+++ b/game/mips2c/jak1_functions/sparticle_launcher.cpp
@@ -162,8 +207,17 @@ struct Cache {
   void* sp_rotate_system; // sp-rotate-system
 } cache;
 
+static u32 ottsel_sp_launch_3d_trace_count = 0;
+static bool ottsel_sp_launch_3d_trace_active = false;
+
 u64 execute(void* ctxt) {
   auto* c = (ExecutionContext*)ctxt;
+  if (!ottsel_sp_launch_3d_trace_active && access("/tmp/ottsel-trace-mips2c-3d", F_OK) == 0) {
+    unlink("/tmp/ottsel-trace-mips2c-3d");
+    ottsel_sp_launch_3d_trace_count = 0;
+    ottsel_sp_launch_3d_trace_active = true;
+    lg::info("OTTSEL SPARTICLE LAUNCH MIPS2C: 3d trace armed");
+  }
   bool bc = false;
   u32 call_addr = 0;
   c->mov64(v1, a0);                                 // or v1, a0, r0
@@ -552,6 +606,17 @@ u64 execute(void* ctxt) {
   c->lw(a0, 4, s2);                                 // lw a0, 4(s2)
   c->lw(a1, 96, sp);                                // lw a1, 96(sp)
   // nop                                            // sll r0, r0, 0
+  if (ottsel_sp_launch_3d_trace_active && c->gprs[s6].du64[0] != 0 &&
+      ottsel_sp_launch_3d_trace_count < 32) {
+    const u32 raw_texture_id = c->gprs[a1].du32[0];
+    lg::info("OTTSEL SPARTICLE LAUNCH MIPS2C: is3d=yes raw=0x{:08x} page=0x{:x} index=0x{:x}",
+             raw_texture_id, (raw_texture_id >> 20) & 0xfff, (raw_texture_id >> 8) & 0xfff);
+    ++ottsel_sp_launch_3d_trace_count;
+    if (ottsel_sp_launch_3d_trace_count >= 32) {
+      ottsel_sp_launch_3d_trace_active = false;
+      lg::info("OTTSEL SPARTICLE LAUNCH MIPS2C: 3d trace complete");
+    }
+  }
   c->load_symbol(t9, cache.particle_adgif);         // lw t9, particle-adgif(s7)
   // nop                                            // sll r0, r0, 0
   c->sqc2(vf4, 128, sp);                            // sqc2 vf4, 128(sp)
