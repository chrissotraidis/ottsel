+// iOS has no IOP thread. Keep the Jak 1 RPC entry point, but execute PLAY
+// commands through the existing native sound shim and fake-ISO bank loader.
+// Sound IDs retain the shared engine Sound registry; bank/stream loading is separate.
+void* RPC_Player(unsigned int /*fno*/, void* data, int size) {
+  static bool initialized = false;
+  static SoundBank bank{};
+  static SoundBank level_bank{};
+  if (!initialized) {
+    initialized = true;
+    InitSoundFalloff();
+    InitSoundPan();
+    const char* data_dir = ee::ottsel_iso_data_dir();
+    if (data_dir && *data_dir) {
+      fake_iso_set_root((fs::path(data_dir) / "SBK").string());
+      fake_iso_init_globals();
+      jak1::fake_iso_init_globals();
+      if (fake_iso_FS_Init() >= 0) {
+        char bank_name[] = "COMMON";
+        if (FS_LoadSoundBank(bank_name, &bank) == 0 && bank.bank_handle) {
+          lg::info("OTTSEL AUDIO: PLAYER RPC loaded COMMON bank handle={} sounds={}",
+                   static_cast<void*>(bank.bank_handle), bank.sound_count);
+        }
+        char level_bank_name[] = "VILLAGE1";
+        if (FS_LoadSoundBank(level_bank_name, &level_bank) == 0 && level_bank.bank_handle) {
+          lg::info("OTTSEL AUDIO: PLAYER RPC loaded VILLAGE1 bank handle={} sounds={}",
+                   static_cast<void*>(level_bank.bank_handle), level_bank.sound_count);
+        }
+      }
+    }
+  }
+  if (!data || size < (int)sizeof(SoundRpcCommand)) {
+    return nullptr;
+  }
+  const int count = size / (int)sizeof(SoundRpcCommand);
+  const auto* commands = reinterpret_cast<const SoundRpcCommand*>(data);
+  for (int i = 0; i < count; ++i) {
+    const auto& command = commands[i];
+    // Reuse engine sound ownership; never interpret every PLAY update as a
+    // request for a new native voice. Streamed-dialog commands remain separate.
+    if (command.j1command != Jak1SoundCommand::PLAY) {
+      Sound* sound = nullptr;
+      switch (command.j1command) {
+        case Jak1SoundCommand::SET_EAR_TRANS: {
+          auto ear = command.ear_trans.ear_trans;
+          auto camera = command.ear_trans.cam_trans;
+          SetEarTrans(&ear, &ear, &camera, command.ear_trans.cam_angle);
+          break;
+        }
+        case Jak1SoundCommand::SET_FALLOFF_CURVE:
+          SetCurve(command.fallof_curve.curve, command.fallof_curve.falloff,
+                   command.fallof_curve.ease);
+          break;
+        case Jak1SoundCommand::PAUSE_SOUND:
+          if ((sound = LookupSound(command.sound_id.sound_id)))
+            snd_PauseSound(sound->sound_handle);
+          break;
+        case Jak1SoundCommand::STOP_SOUND:
+          if ((sound = LookupSound(command.sound_id.sound_id)))
+            snd_StopSound(sound->sound_handle);
+          break;
+        case Jak1SoundCommand::CONTINUE_SOUND:
+          if ((sound = LookupSound(command.sound_id.sound_id)))
+            snd_ContinueSound(sound->sound_handle);
+          break;
+        case Jak1SoundCommand::SET_PARAM: {
+          sound = LookupSound(command.sound_id.sound_id);
+          if (!sound) break;
+          const u32 mask = command.param.parms.mask;
+          if (mask & 1) {
+            if (mask & 0x10) {
+              sound->auto_time = command.param.auto_time;
+              sound->new_volume = command.param.parms.volume;
+            } else {
+              sound->params.volume = command.param.parms.volume;
+            }
+          }
+          if (mask & 0x20) sound->params.trans = command.param.parms.trans;
+          if (mask & 0x21) UpdateVolume(sound);
+          if (mask & 2) {
+            sound->params.pitch_mod = command.param.parms.pitch_mod;
+            if (mask & 0x10) {
+              // Keep independent volume/position mask handling above. The
+              // existing native automated-pitch shim reports its limitation.
+              snd_AutoPitch(sound->sound_handle, sound->params.pitch_mod,
+                            command.param.auto_time, command.param.auto_from);
+            } else {
+              snd_SetSoundPitchModifier(sound->sound_handle, command.param.parms.pitch_mod);
+            }
+          }
+          if (mask & 4) {
+            sound->params.bend = command.param.parms.bend;
+            if (mask & 0x10) {
+              snd_AutoPitchBend(sound->sound_handle, sound->params.bend,
+                                command.param.auto_time, command.param.auto_from);
+            } else {
+              snd_SetSoundPitchBend(sound->sound_handle, command.param.parms.bend);
+            }
+          }
+          break;
+        }
+        default: break;
+      }
+      continue;
+    }
+    if (command.play.name[0] == 0 || command.play.sound_id == 0) continue;
+    char sound_name[17] = {};
+    memcpy(sound_name, command.play.name, sizeof(command.play.name));
+    SoundBank* owner = nullptr;
+    s32 index = -1;
+    for (auto* candidate : {&bank, &level_bank}) {
+      if (candidate->bank_handle) {
+        for (s32 j = 0; j < (s32)candidate->sound.size(); ++j) {
+          if (memcmp(candidate->sound[j].name.data(), command.play.name,
+                     sizeof(command.play.name)) == 0) {
+            owner = candidate;
+            index = j;
+            break;
+          }
+        }
+      }
+      if (owner) {
+        break;
+      }
+    }
+    if (!owner) {
+      lg::warn("OTTSEL AUDIO: PLAYER RPC sound missing name={} id={}", sound_name,
+               command.play.sound_id);
+      continue;
+    }
+    Sound* sound = LookupSound(command.play.sound_id);
+    const bool updating = sound != nullptr;
+    if (!sound) sound = AllocateSound(false);
+    if (!sound) continue;  // Same bounded 64-sound registry as the engine.
+    memcpy(&sound->params, &command.play.parms, sizeof(sound->params));
+    sound->bank_entry = &owner->sound[index];
+    sound->is_music = 0;
+    if ((sound->params.mask & 0x40) == 0)
+      sound->params.fo_min = sound->bank_entry->fallof_params & 0x3fff;
+    if ((sound->params.mask & 0x80) == 0)
+      sound->params.fo_max = (sound->bank_entry->fallof_params >> 14) & 0x3fff;
+    if ((sound->params.mask & 0x100) == 0)
+      sound->params.fo_curve = sound->bank_entry->fallof_params >> 28;
+    if (updating) {
+      UpdateVolume(sound);
+      snd_SetSoundPitchModifier(sound->sound_handle, command.play.parms.pitch_mod);
+      snd_SetSoundPitchBend(sound->sound_handle, command.play.parms.bend);
+      continue;
+    }
+    sound->auto_time = 0;
+    sound->sound_handle = snd_PlaySoundVolPanPMPB(
+        owner->bank_handle, index, GetVolume(sound), GetPan(sound),
+        command.play.parms.pitch_mod, command.play.parms.bend);
+    if (sound->sound_handle) sound->id = command.play.sound_id;
+    lg::info("OTTSEL AUDIO: PLAYER RPC play id={} index={} name={} handle={}",
+             command.play.sound_id, index, sound_name, sound->sound_handle);
+
+  }
+  return nullptr;
+}
