diff --git a/common/dma/ottsel_data_root.h b/common/dma/ottsel_data_root.h
new file mode 100644
--- /dev/null
+++ b/common/dma/ottsel_data_root.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <string>
+
+namespace ottsel {
+
+// A validated user pack is authoritative; the bundle is only the clean-install
+// fallback when no user root has been selected.
+inline std::string select_user_data_root(const std::string& selected,
+                                         const std::string& bundle_fallback) {
+  return selected.empty() ? bundle_fallback : selected;
+}
+
+}  // namespace ottsel
