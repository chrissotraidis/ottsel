 (defun reset-and-call ((this thread) (func function))
   "Make the given thread the top thread, reset the stack, and call the function.
-  Sets up a return trampoline so when the function returns it will return to the
-  kernel context. Will NOT deactivate on return, so this is intended for temporary threads.
-  NOTE: this should only be done from the kernel, running on the
-  kernel's stack."
+   Sets up a return trampoline so when the function returns it will return to the
+   kernel context. Will NOT deactivate on return, so this is intended for temporary threads.
+   NOTE: this should only be done from the kernel, running on the
+   kernel's stack."
   (declare (asm-func object))
   (rlet ((pp :reg r13 :type process)
          (sp :reg rsp :type uint)
+         ;; Ottsel A1.10: return-from-thread/thread-suspend get back to the kernel by
+         ;; reading [*kernel-sp* + 0x50] - exactly where their five .pop s4..s0 end
+         ;; (A1.13: they then pop this stash too, so sp returns to this resume point).
+         ;; That slot used to hold whatever the kernel stack had above the five saved
+         ;; registers.  When the kernel tail-calls the resume hook there is no GOAL
+         ;; synthetic slot there at all and the strict signed-GAME lane measured
+         ;; 0x00000050ffffffff (a GOAL frame local): the guarded .ret rejected it and
+         ;; fell back to its own entry x30, returning into GOAL code with the kernel
+         ;; register file.  x30 at entry IS the kernel continuation (blr sets it), so
+         ;; stash it as the sixth slot and the .ret always finds a real address.
+         (lr :reg x30 :type uint)
          (off :reg r15 :type uint)
          (s0 :reg rbx :type uint)
          (s1 :reg rbp :type uint)
          (s2 :reg r10 :type uint)
          (s3 :reg r11 :type uint)
          (s4 :reg r12 :type uint)
-         (temp :reg rax :type uint))
+         (temp :reg rax :type uint)
+         )
     ;; set up the process pointer
     (set! pp (-> this process))
     ;; mark the process as running and set its top thread
     (set! (-> pp status) 'running)
     (set! (-> pp top-thread) this)
     ;; save the current kernel regs
+    (.push :color #f lr) ;; A1.10: the kernel continuation the .ret must land on
     (.push :color #f s0)
     (.push :color #f s1)
