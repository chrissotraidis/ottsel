diff --git a/goal_src/jak1/engine/gfx/shadow/shadow.gc b/goal_src/jak1/engine/gfx/shadow/shadow.gc
index 06b173a02..57c12ec2a 100644
--- a/goal_src/jak1/engine/gfx/shadow/shadow.gc
+++ b/goal_src/jak1/engine/gfx/shadow/shadow.gc
@@ -106,6 +106,39 @@
                                  0.0
                                  81920.0))
   0
+  ;; BOT62: bounded world-position trace for the controllability gate.
+  ;; Every target post behavior calls this exactly once per frame, after
+  ;; collision has finalized (-> self control trans), so it also covers the
+  ;; swim/no-stick states that target-post alone would miss.
+  (when (< 0 *ottsel-target-trace-left*)
+    (+! *ottsel-target-trace-left* -1)
+    (when (zero? (logand *ottsel-target-trace-left* 15))
+      (format 0 "OTTSEL TARGET POS: t=(~f,~f,~f) pad=~f~%"
+              (-> self control trans x)
+              (-> self control trans y)
+              (-> self control trans z)
+              (-> self control pad-magnitude)))
+    ;; Ottsel I1 (2026-09-22): the trace above showed a frozen vertical axis, so the same bounded window
+    ;; now also reports the control's own velocity, its gravity (the jump impulse is
+    ;; sqrt(2 * gravity-length * height) along gravity-normal, so a zero gravity-length makes every jump a
+    ;; no-op) and the position.  A vertical impulse shorter than the one-in-sixteen cadence would still be
+    ;; caught, because any |transv.y| above 1000 prints immediately.
+    (when (or (zero? (logand *ottsel-target-trace-left* 15))
+              (< 1000.0 (fabs (-> self control transv y))))
+      ;; GOAL's format takes at most eight arguments, so the velocity/position and the gravity fields are
+      ;; two calls inside one bounded window.
+      (format 0 "OTTSEL TARGET VEL: v=(~f,~f,~f) t=(~f,~f,~f)~%"
+              (-> self control transv x)
+              (-> self control transv y)
+              (-> self control transv z)
+              (-> self control trans x)
+              (-> self control trans y)
+              (-> self control trans z))
+      (format 0 "OTTSEL TARGET GRAV: g-len=~f g-n=(~f,~f,~f)~%"
+              (-> self control dynam gravity-length)
+              (-> self control dynam gravity-normal x)
+              (-> self control dynam gravity-normal y)
+              (-> self control dynam gravity-normal z))))
   (none))
 
