   if (bank->sound_count == 101) {
     offset = 1 * 2048;
   }
@@ -260,6 +263,14 @@
   auto data = file_util::read_binary_file(fs::path(get_file_path(file)));
   parseSoundBank(BinaryReader(data), *bank);
 
