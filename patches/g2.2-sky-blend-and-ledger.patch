+        const GsTex0 t(tex0);
+        const bool in_registry =
+            g_direct_relocated_textures.count(direct_texture_cache_key(t.tbp0(), (u32)t.psm())) != 0;
+        const auto meta = g_direct_texture_metadata.find(t.tbp0());
