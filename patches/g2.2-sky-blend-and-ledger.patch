+    const std::string eye_dump_trigger = ottsel_ios_writable_dir() + "ottsel-trace-eye-dump";
+    if (access(eye_dump_trigger.c_str(), F_OK) == 0) {
+      unlink(eye_dump_trigger.c_str());
